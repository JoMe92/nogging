{
  "//": [
    "Example permissions template for interactive Claude Code Orchestration Agent sessions.",
    "Copy or merge the permissions block into your user settings file (~/.claude/settings.json).",
    "Replace HOME and <repo> with your system's paths (e.g. /home/alice and myrepo).",
    "This template is never applied automatically by nogg init or nogg update."
  ],
  "permissions": {
    "allow": [
      "Read(//HOME/src/<repo>-spec-*/**)",
      "Edit(//HOME/src/<repo>-spec-*/**)",
      "Read(//HOME/src/<repo>-plan-*/**)",
      "Edit(//HOME/src/<repo>-plan-*/**)",
      "Bash(./scripts/nogg session launch:*)",
      "Bash(./scripts/nogg session send:*)",
      "Bash(./scripts/nogg session kickoff:*)",
      "Bash(./scripts/nogg session stop:*)",
      "Bash(./scripts/nogg session list:*)",
      "Bash(./scripts/nogg session log:*)",
      "Bash(./scripts/nogg session watch:*)",
      "Bash(./scripts/nogg worktree list:*)",
      "Bash(./scripts/nogg worktree plan:*)",
      "Bash(./scripts/nogg worktree implement:*)",
      "Bash(./scripts/nogg sync:*)",
      "Bash(./scripts/nogg recover:*)",
      "Bash(./scripts/nogg discoveries:*)",
      "Bash(./scripts/nogg doctor:*)",
      "Bash(bd ready:*)",
      "Bash(bd show:*)",
      "Bash(bd list:*)",
      "Bash(bd blocked:*)",
      "Bash(bd update:*)",
      "Bash(bd create:*)",
      "Bash(bd close:*)",
      "Bash(bd remember:*)",
      "Bash(bd dep list:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(mkfs.*:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fx:*)",
      "Bash(git clean --force:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete --force:*)",
      "Bash(git filter-branch:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git restore .:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)"
    ]
  }
}
