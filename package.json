{
  "name": "nogg",
  "version": "1.6.0",
  "private": true,
  "description": "Nogging — the structural layer for agentic software development",
  "main": "bin/cli.js",
  "bin": {
    "nogg": "bin/cli.js"
  },
  "files": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "bin",
    "templates",
    "scripts",
    "!scripts/__pycache__",
    "!scripts/**/*.pyc",
    ".agents",
    ".claude/agents",
    ".claude/commands",
    ".specforge/launch-profiles",
    ".specforge/launch-prompts",
    ".codex/rules",
    ".codex/prompts",
    ".pi/prompts",
    ".pi/extensions",
    "docs",
    "!docs/source",
    "!docs/acceptance",
    "openspec/config.yaml",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "scripts/test",
    "prepublishOnly": "node -e \"console.error('Nogging is distributed from tagged GitHub releases, not the npm registry.'); process.exit(1)\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoMe92/nogging.git"
  },
  "homepage": "https://github.com/JoMe92/nogging#readme",
  "bugs": {
    "url": "https://github.com/JoMe92/nogging/issues"
  },
  "keywords": [
    "agentic-development",
    "beads",
    "codex",
    "openspec",
    "software-delivery"
  ],
  "author": "Jonas Meier",
  "license": "ISC",
  "devDependencies": {
    "@fission-ai/openspec": "^1.11.0"
  }
}
