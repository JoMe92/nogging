{
  "name": "Nogging",
  "sync_interval_seconds": 30,
  "beads_command": "bd",
  "planning_lock_ttl_seconds": 7200,
  "sync_lock_ttl_seconds": 120,
  "sync_max_attempts": 5,
  "sync_retry_base_seconds": 30,
  "sync_retry_cap_seconds": 1800,
  "sync_protected_branches": ["main", "develop"],
  "claim_stale_seconds": 14400,
  "change_states": ["open", "done", "archived"],
  "session_tmux_command": "tmux",
  "session_tmux_socket": "nogging",
  "session_state_dir": ".nogging/state/sessions",
  "session_log_max_bytes": 1048576,
  "session_log_rotation_depth": 3,
  "session_stop_grace_seconds": 10,
  "session_agent": "claude",
  "personas": {
    "planner": {"name": "Nogging Planner", "email": "planner@nogging.bot"},
    "lead": {"name": "Nogging Lead", "email": "lead@nogging.bot"},
    "orchestrator": {"name": "Nogging Orchestrator", "email": "orchestrator@nogging.bot"},
    "sync": {"name": "Nogging Sync", "email": "sync@nogging.bot"},
    "architect": {"name": "Nogging Architect", "email": "architect@nogging.bot"},
    "ux-reviewer": {"name": "Nogging UX Reviewer", "email": "ux-reviewer@nogging.bot"},
    "backend-engineer": {"name": "Nogging Backend Engineer", "email": "backend-engineer@nogging.bot"},
    "frontend-engineer": {"name": "Nogging Frontend Engineer", "email": "frontend-engineer@nogging.bot"},
    "code-reviewer": {"name": "Nogging Code Reviewer", "email": "code-reviewer@nogging.bot"},
    "test-runner": {"name": "Nogging Test Runner", "email": "test-runner@nogging.bot"}
  },
  "multi_machine": false
}
