#!/usr/bin/env bash
# Repository test runner: executes every scripts/**/*.test.sh.
#
# Language-neutral and offline by design. These checks must run with nothing
# more than bash and coreutils: no Node, no network, and no running Beads/Dolt
# server. Tests that need `bd` stub it (see scripts/nogg.test.sh).
set -euo pipefail

# Tests construct their own repositories and supervised-session fixtures.
# Keep the delivery session's identity, root and task-tick broker out of
# those subprocesses; each fixture explicitly supplies the context it needs.
source "$(dirname "${BASH_SOURCE[0]}")/lib/test-env.sh"
# The launch usage gate must not read the operator's live quota: every fixture
# sees no usage source (unknown, warn) unless it supplies its own.
usage_home=$(mktemp -d)
trap 'rm -rf "$usage_home"' EXIT
mkdir -p "$usage_home/codex" "$usage_home/cache"
export CODEX_HOME="$usage_home/codex" XDG_CACHE_HOME="$usage_home/cache"
# Antigravity quota comes from a runtime `/usage` probe; tests must never run the
# developer's real agy. Fixtures that exercise the probe stub `agy` and opt in.
export AGY_NOGG_USAGE_PROBE=0
# Stub-backed launch fixtures need not wait out the full 2 s launch settle
# window per launch; the override can only shorten it (see settle_launch).
export NOGG_LAUNCH_SETTLE_SECONDS=0.25

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

tests=()
while IFS= read -r t; do
  tests+=("$t")
done < <(find "$root/scripts" -name '*.test.sh' -type f | sort)

if [[ ${#tests[@]} -eq 0 ]]; then
  echo "Nogging: no *.test.sh found under scripts/" >&2
  exit 1
fi

fail=0
for t in "${tests[@]}"; do
  echo "=== ${t#"$root"/}"
  if bash "$t"; then
    echo "PASS - ${t#"$root"/}"
  else
    echo "FAIL - ${t#"$root"/}"
    fail=1
  fi
  echo
done

if [[ $fail -ne 0 ]]; then
  echo "Nogging: script tests failed" >&2
  exit 1
fi
echo "Nogging: all script tests passed"
