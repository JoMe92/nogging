#!/usr/bin/env bash
# Repository test runner: executes every scripts/**/*.test.sh.
#
# Language-neutral and offline by design. These checks must run with nothing
# more than bash and coreutils: no Node, no network, and no running Beads/Dolt
# server. Tests that need `bd` stub it (see scripts/nogg.test.sh).
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

tests=()
while IFS= read -r t; do
  tests+=("$t")
done < <(find "$root/scripts" -name '*.test.sh' -type f | sort)

if [[ ${#tests[@]} -eq 0 ]]; then
  echo "SpecForge: no *.test.sh found under scripts/" >&2
  exit 1
fi

fail=0
for t in "${tests[@]}"; do
  echo "=== ${t#"$root"/}"
  if bash "$t"; then
    echo "PASS - ${t#"$root"/}"
  else
    echo "FAIL - ${t#"$root"/}"
    fail=1
  fi
  echo
done

if [[ $fail -ne 0 ]]; then
  echo "SpecForge: script tests failed" >&2
  exit 1
fi
echo "SpecForge: all script tests passed"
