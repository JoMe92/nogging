#!/usr/bin/env bash
# Append-only log sink for a supervised Claude session, used as the target of
# `tmux pipe-pane -o`. Reads pane output on stdin, appends it to <log>, and
# performs size-based rotation: when <log> reaches <max-bytes> it is rotated to
# <log>.1, existing <log>.N shift to <log>.(N+1), and anything past <depth> is
# dropped. No time-based rotation; matches the sync failure-log convention.
#
# Usage: session-log-writer <log-path> <max-bytes> <depth>
set -eu

log=${1:?log path required}
max=${2:?max bytes required}
depth=${3:?rotation depth required}

rotate() {
  local i
  rm -f "$log.$depth"
  for (( i = depth - 1; i >= 1; i-- )); do
    [ -f "$log.$i" ] && mv -f "$log.$i" "$log.$((i + 1))" || true
  done
  [ -f "$log" ] && mv -f "$log" "$log.1" || true
  : > "$log"
}

mkdir -p "$(dirname "$log")"
[ -f "$log" ] || : > "$log"

while IFS= read -r line || [ -n "$line" ]; do
  printf '%s\n' "$line" >> "$log"
  size=$(wc -c < "$log" 2>/dev/null || echo 0)
  if [ "$size" -ge "$max" ]; then
    rotate
  fi
done
