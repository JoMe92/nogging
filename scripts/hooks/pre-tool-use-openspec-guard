#!/usr/bin/env bash
set -euo pipefail
# Early Claude tool signal; supervised execution also has an OS mount fence.
root="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
helper="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/nogg"
python3 -c '
from importlib.machinery import SourceFileLoader
import json, sys
try:
    payload=json.load(sys.stdin)
    target=payload.get("tool_input",{}).get("file_path")
    if not target: sys.exit(0)
    bridge=SourceFileLoader("nogg_tool_guard",sys.argv[1]).load_module()
    protected,allowed=bridge.openspec_tool_decision(sys.argv[2],target)
    if not protected or allowed: sys.exit(0)
except Exception:
    pass
print("Nogging: OpenSpec write blocked by a boundary sentinel or a missing, stale, or foreign planning session lock; acquire your own active planning session lock before writing.",file=sys.stderr)
sys.exit(2)
' "$helper" "$root"
