#!/usr/bin/env bash
set -euo pipefail
message=$(head -n1 "$1")

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|test)(\([a-z0-9._/-]+\))?(!)?: .+'
if ! [[ "$message" =~ $pattern ]]; then
  echo "SpecForge: commit message must use Conventional Commits." >&2
  exit 1
fi

# Execution commits must be tied to claimed work: the subject carries a real
# Beads issue ID token, e.g. [SPEC-1cu]. The suffix is lower-case/digits, so a
# placeholder like [BEAD-XXX] or an empty [] does not satisfy the rule.
# Only the two writers already trusted to touch openspec/ (scripts/hooks/pre-commit)
# are exempt: SPECFORGE_WRITER=planning and SPECFORGE_WRITER=sync commit
# deterministic plan/mirror state, not execution work.
writer="${SPECFORGE_WRITER:-}"
if [[ "$writer" != "planning" && "$writer" != "sync" ]]; then
  bead_token='\[[A-Z][A-Z0-9]*-[0-9a-z]+\]'
  if ! [[ "$message" =~ $bead_token ]]; then
    {
      echo "SpecForge: execution commits must name a real Beads issue ID in the subject, e.g. [SPEC-1cu]."
      echo "Rule: the subject must contain a token [<PREFIX>-<id>] with a lower-case/digit id;"
      echo "a placeholder such as [BEAD-XXX] or an empty [] does not count."
      echo "Exemption: set SPECFORGE_WRITER=planning or SPECFORGE_WRITER=sync, and only for"
      echo "approved planning sessions or the deterministic sync commit."
    } >&2
    exit 1
  fi
fi
