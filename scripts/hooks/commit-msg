#!/usr/bin/env bash
set -euo pipefail
message=$(head -n1 "$1")
body=$(cat "$1")

# Historic exemption: commits 4f10ca8 and 4de5a99 landed on develop with the
# non-Conventional type "plan" and, being protected history, cannot be rewritten.
# The develop -> main release range includes them, so CI would reject them
# forever. Exempt exactly those two full subjects (string equality, nothing
# broader). The exemption lives here
# rather than in the workflow because the automation token cannot push workflow
# files.
historic_subject='plan(launch-hook-fixes): fix blocking-edge check, agent-binary preflight, absolute Stop hook'
historic_subject_2='plan(session-wake): add user pause mode, keep-warm rule and quiet hours'
if [[ "$message" == "$historic_subject" || "$message" == "$historic_subject_2" ]]; then
  exit 0
fi

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|test)(\([a-z0-9._/-]+\))?(!)?: .+'
if ! [[ "$message" =~ $pattern ]]; then
  echo "Nogging: commit message must use Conventional Commits." >&2
  exit 1
fi

# Execution commits must be tied to claimed work: the subject carries a real
# Beads issue ID token, e.g. [SPEC-1cu]. The suffix is lower-case/digits, so a
# placeholder like [BEAD-XXX] or an empty [] does not satisfy the rule.
# Only the two writers already trusted to touch openspec/ (scripts/hooks/pre-commit)
# are exempt: NOGGING_WRITER=planning and NOGGING_WRITER=sync commit
# deterministic plan/mirror state, not execution work.
#
# The exemption is honoured two ways, identically: the NOGGING_WRITER
# environment variable (local use), or a durable `Nogging-Writer: planning`
# / `Nogging-Writer: sync` trailer in the message body, so CI — which sees
# only the pushed commit object — applies the same rule. The Conventional
# subject requirement above is unconditional and applies to writer commits too.
#
# The legacy `SpecForge-Writer:` trailer (also SPECFORGE_WRITER) is accepted
# too: commits made before the Nogging rename are immutable history, and a PR
# range that crosses the rename point (e.g. develop -> main) must still
# recognize them as the valid writer commits they were when made.
writer="${NOGGING_WRITER:-${SPECFORGE_WRITER:-}}"
trailer='(^|'$'\n'')[Nn]ogging-[Ww]riter:[[:space:]]*(planning|sync)[[:space:]]*($|'$'\n'')'
legacy_trailer='(^|'$'\n'')[Ss]pec[Ff]orge-[Ww]riter:[[:space:]]*(planning|sync)[[:space:]]*($|'$'\n'')'
if [[ "$writer" != "planning" && "$writer" != "sync" ]] \
    && ! [[ "$body" =~ $trailer ]] && ! [[ "$body" =~ $legacy_trailer ]]; then
  bead_token='\[[A-Za-z][A-Za-z0-9]*-[0-9a-z]+\]'
  if ! [[ "$message" =~ $bead_token ]]; then
    {
      echo "Nogging: execution commits must name a real Beads issue ID in the subject, e.g. [SPEC-1cu]."
      echo "Rule: the subject must contain a token [<PREFIX>-<id>] whose prefix may be of either case"
      echo "and whose id is lower-case or digits;"
      echo "a placeholder such as [BEAD-XXX] or an empty [] does not count."
      echo "Exemption: set NOGGING_WRITER=planning or NOGGING_WRITER=sync, or add a"
      echo "Nogging-Writer: planning (or sync) trailer, and only for approved planning"
      echo "sessions or the deterministic sync commit."
    } >&2
    exit 1
  fi
fi
