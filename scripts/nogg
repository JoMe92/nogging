#!/usr/bin/env python3
"""Small deterministic bridge between OpenSpec and Beads.

It intentionally contains no LLM call and makes no semantic product decision.
"""
from __future__ import annotations

import argparse, datetime as dt, getpass, json, os, re, shlex, shutil, signal, socket, subprocess, sys, time, uuid
from dataclasses import dataclass, field
from pathlib import Path

# ROOT is the repository the bridge operates on. It defaults to the checkout the
# script lives in; NOGGING_ROOT overrides it so the test suite can point the
# bridge at a scratch repository.
ROOT = Path(os.environ.get("NOGGING_ROOT") or Path(__file__).resolve().parents[1]).resolve()
CFG = json.loads((ROOT / ".nogging/config.json").read_text())
LOCKS, STATE, REPORTS = (ROOT / ".nogging/locks", ROOT / ".nogging/state", ROOT / ".nogging/reports")
WORKTREE_STATE = STATE / "worktrees"
PR_STATE = STATE / "pull-requests"
TASK_RE = re.compile(r"^- \[[ x]\] (TASK-[A-Z0-9-]+)\s+(.+)$", re.M)
# Beads scopes `bd list` to non-closed issues by default. The mechanical sync
# must see closed mapped Beads too (a closed Bead is exactly what gets mirrored),
# so every read that feeds reconciliation asks for the full status set.
BEAD_STATUSES = "open,in_progress,blocked,deferred,closed"

class AuditError(RuntimeError):
    """An invariant / mapping / task-parse disagreement. Permanent: a human
    must resolve it before sync can make progress."""
class LockBusyError(RuntimeError):
    """Another sync holds the lock and it is not yet stale. Transient."""
class ToolError(RuntimeError):
    """A `git` / `bd` invocation exited non-zero. Treated as transient."""

def now(): return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()
def run(*args, check=True, env=None):
    result = subprocess.run(args, cwd=ROOT, text=True, capture_output=True, env=env)
    if check and result.returncode:
        raise ToolError(f"{' '.join(args)}: {result.stderr.strip() or result.stdout.strip()}")
    return result
def data_dir(path): path.mkdir(parents=True, exist_ok=True); return path
KEBAB_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
def require_kebab(value, label):
    if not KEBAB_RE.fullmatch(value or ""):
        raise RuntimeError(f"{label} must be a non-empty kebab-case value")
    return value
PERSONAS = CFG.get("personas", {})
def persona_identity(slug):
    """The `(name, email)` commit identity for a roster persona `slug`, from
    `.nogging/config.json`'s `personas` table. Raises if the slug is missing
    or incomplete — an unconfigured persona must fail loudly rather than let
    a commit land under no identity or the operator's own."""
    entry = PERSONAS.get(slug)
    if not isinstance(entry, dict) or not entry.get("name") or not entry.get("email"):
        raise RuntimeError(f"persona roster has no complete entry for '{slug}'")
    return entry["name"], entry["email"]
def ensure_worktree_config_extension(path):
    """Idempotently enable `extensions.worktreeConfig` for the repository at
    `path` (a linked worktree or the main checkout) so a later
    `git config --worktree` call scopes to that one worktree/checkout instead
    of the shared `.git/config`."""
    current = run("git", "-C", str(path), "config", "--get",
                  "extensions.worktreeConfig", check=False)
    if current.stdout.strip() != "true":
        run("git", "-C", str(path), "config", "extensions.worktreeConfig", "true")
def set_persona_identity(path, slug):
    """Set the worktree-scoped `user.name`/`user.email` at `path` (a linked
    worktree or the main checkout) to the roster identity for `slug`, so
    every commit made there for the rest of its life carries the right
    author automatically (design.md Decision 1) — no per-commit flag an
    agent could forget to pass."""
    ensure_worktree_config_extension(path)
    name, email = persona_identity(slug)
    run("git", "-C", str(path), "config", "--worktree", "user.name", name)
    run("git", "-C", str(path), "config", "--worktree", "user.email", email)
def worktree_record_path(kind, identifier, description):
    return WORKTREE_STATE / f"{kind}--{identifier}--{description}.json"
def write_worktree_record(path, record):
    """Atomically persist allocation intent before mutating Git worktrees."""
    data_dir(path.parent)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
    os.replace(tmp, path)
def worktree_records():
    """Read durable worktree records without mutating state.

    Allocation commands create these records in a later lifecycle task; recovery
    already understands them so an interrupted allocation remains visible.
    """
    out = []
    if not WORKTREE_STATE.is_dir(): return out
    for path in sorted(WORKTREE_STATE.glob("*.json")):
        try:
            record = json.loads(path.read_text())
        except (ValueError, OSError):
            out.append((path, None)); continue
        out.append((path, record if isinstance(record, dict) else None))
    return out
def recorded_worktree_lines():
    """Read-only reconciliation of durable records with Git's worktree list."""
    known = set()
    result = run("git", "worktree", "list", "--porcelain", check=False)
    if result.returncode == 0:
        known = {line[9:] for line in result.stdout.splitlines() if line.startswith("worktree ")}
    lines, attention = [], []
    for path, record in worktree_records():
        if record is None:
            lines.append(f"{path.name}: unreadable worktree record")
            attention.append("unreadable worktree record")
            continue
        location, branch = record.get("path"), record.get("branch")
        if not isinstance(location, str) or not isinstance(branch, str):
            lines.append(f"{path.name}: incomplete worktree record")
            attention.append("incomplete worktree record")
        elif location not in known:
            lines.append(f"{path.name}: recorded {branch} at {location} is missing")
            attention.append("missing recorded worktree")
    return lines, attention
def git_worktree_paths():
    result = run("git", "worktree", "list", "--porcelain", check=False)
    if result.returncode:
        raise RuntimeError("could not inspect existing Git worktrees")
    return {line[9:] for line in result.stdout.splitlines() if line.startswith("worktree ")}
def branch_exists(branch):
    return run("git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch}",
               check=False).returncode == 0
def planning_worktree(planning_id, description, location=None):
    """Allocate an isolated planning worktree from a freshly fetched develop."""
    planning_id = require_kebab(planning_id, "planning ID")
    description = require_kebab(description, "planning description")
    branch = f"plan/{planning_id}/{description}"
    location = Path(location).expanduser().resolve() if location else (
        ROOT.parent / f"{ROOT.name}-plan-{planning_id}-{description}")
    record_path = worktree_record_path("plan", planning_id, description)
    if record_path.exists():
        raise RuntimeError(f"planning allocation record already exists: {record_path.relative_to(ROOT)}")
    if location.exists():
        raise RuntimeError(f"planning worktree path already exists: {location}")
    if str(location) in git_worktree_paths():
        raise RuntimeError(f"planning worktree path is already registered: {location}")
    if branch_exists(branch):
        raise RuntimeError(f"planning branch already exists: {branch}")
    fetched = run("git", "fetch", "origin", "develop", check=False)
    if fetched.returncode:
        raise RuntimeError("could not update origin/develop before allocating a planning worktree")
    base = resolve_ref("origin/develop")
    if base is None:
        raise RuntimeError("origin/develop does not resolve after fetch")
    record = {"branch": branch, "created_at": now(), "description": description,
              "kind": "planning", "path": str(location), "planning_id": planning_id,
              "state": "allocating", "base_ref": base}
    # Persist intent first, so an interruption during `git worktree add` is
    # diagnosable rather than silently losing the allocation request.
    write_worktree_record(record_path, record)
    run("git", "worktree", "add", "-b", branch, str(location), base)
    set_persona_identity(location, "planner")
    record["state"] = "allocated"
    record["allocated_at"] = now()
    write_worktree_record(record_path, record)
    print(f"planning worktree allocated: {location}")
    print(f"branch: {branch} (from {base})")
    print(f"record: {record_path.relative_to(ROOT)}")
IMPLEMENT_BRANCH_RE = re.compile(r"^(feat|fix|chore|docs|refactor|perf|test)/[a-z0-9]+(?:-[a-z0-9]+)*$")
def claimed_bead(bead_id):
    matches = [issue for issue in beads() if str(issue_id(issue)) == bead_id]
    if not matches or matches[0].get("status") != "in_progress":
        raise RuntimeError(f"implementation worktree requires an in_progress claimed Bead: {bead_id}")
    return matches[0]
def implementation_worktree(bead_id, branch, location=None):
    """Allocate a per-Bead implementation checkout without touching develop."""
    if not IMPLEMENT_BRANCH_RE.fullmatch(branch or ""):
        raise RuntimeError("implementation branch must use a conventional <type>/<kebab-slug> form")
    claimed_bead(bead_id)
    safe_id = re.sub(r"[^a-z0-9-]", "-", bead_id.lower())
    location = Path(location).expanduser().resolve() if location else ROOT.parent / f"{ROOT.name}-{safe_id}"
    record_path = WORKTREE_STATE / f"implementation--{safe_id}.json"
    if record_path.exists():
        raise RuntimeError(f"implementation allocation record already exists: {record_path.relative_to(ROOT)}")
    if location.exists() or str(location) in git_worktree_paths():
        raise RuntimeError(f"implementation worktree path already exists: {location}")
    if branch_exists(branch):
        raise RuntimeError(f"implementation branch already exists: {branch}")
    fetched = run("git", "fetch", "origin", "develop", check=False)
    if fetched.returncode:
        raise RuntimeError("could not update origin/develop before allocating an implementation worktree")
    base = resolve_ref("origin/develop")
    if base is None: raise RuntimeError("origin/develop does not resolve after fetch")
    record = {"bead_id": bead_id, "branch": branch, "created_at": now(),
              "kind": "implementation", "path": str(location), "state": "allocating", "base_ref": base}
    write_worktree_record(record_path, record)
    run("git", "worktree", "add", "-b", branch, str(location), base)
    set_persona_identity(location, "lead")
    record["state"], record["allocated_at"] = "allocated", now()
    write_worktree_record(record_path, record)
    print(f"implementation worktree allocated: {location}")
    print(f"branch: {branch} (from {base}; Bead {bead_id})")
    print(f"record: {record_path.relative_to(ROOT)}")
WORKTREE_KIND_PERSONA = {"planning": "planner", "implementation": "lead"}
def persona_mismatch_notes():
    """A NOTE (never a FAIL) for each recorded, still-registered worktree
    whose `user.name` does not match its role's expected persona — catches a
    worktree created before this change, or one where identity-setting
    silently failed."""
    notes = []
    known = git_worktree_paths()
    for _path, record in worktree_records():
        if not isinstance(record, dict):
            continue
        slug = WORKTREE_KIND_PERSONA.get(record.get("kind"))
        location = record.get("path")
        if not slug or not isinstance(location, str) or location not in known:
            continue
        try:
            expected_name, _expected_email = persona_identity(slug)
        except RuntimeError:
            continue
        actual = run("git", "-C", location, "config", "--get", "user.name", check=False).stdout.strip()
        if actual != expected_name:
            notes.append(f"worktree {Path(location).name} ({record['kind']}) user.name is "
                         f"{actual or '(unset)'}, expected {expected_name}")
    return notes
LAUNCH_PROFILE_EXPECTED_MODE = {"trusted.json": "bypassPermissions", "orchestrator.json": "bypassPermissions"}
def launch_profile_notes():
    """A NOTE (never a FAIL) for each Claude launch-profile JSON directly under
    `.nogging/launch-profiles/` that sets `permissions.defaultMode:
    bypassPermissions` without also setting a top-level
    `skipDangerousModePermissionPrompt: true` (an interactive session would
    then block on the bypass-permissions disclaimer), and a separate NOTE when
    a shipped `trusted.json`/`orchestrator.json` carries a `defaultMode` other
    than the value docs/security-model.md documents for it. `.codex.toml` /
    `.pi.toml` siblings never match the `*.json` glob, so they are skipped
    without any special-casing."""
    notes = []
    profile_dir = ROOT / CFG.get("session_launch_profile_dir", ".nogging/launch-profiles")
    if not profile_dir.is_dir():
        return notes
    for path in sorted(profile_dir.glob("*.json")):
        try:
            profile = json.loads(path.read_text())
        except (ValueError, OSError) as exc:
            notes.append(f"launch profile {path.name} could not be read: {exc}")
            continue
        mode = (profile.get("permissions") or {}).get("defaultMode")
        if mode == "bypassPermissions" and profile.get("skipDangerousModePermissionPrompt") is not True:
            notes.append(
                f"launch profile {path.name} sets permissions.defaultMode: "
                f"bypassPermissions without a top-level "
                f"skipDangerousModePermissionPrompt: true — an interactive session "
                f"will block on the bypass-permissions disclaimer")
        expected = LAUNCH_PROFILE_EXPECTED_MODE.get(path.name)
        if expected is not None and mode != expected:
            notes.append(
                f"launch profile {path.name} has permissions.defaultMode "
                f"{mode!r}, expected {expected!r} per docs/security-model.md")
    return notes
def cleanup_worktree(record_name):
    """Retire only a clean recorded worktree whose branch reached develop."""
    path = WORKTREE_STATE / record_name
    if path.suffix != ".json" or path.parent != WORKTREE_STATE or not path.is_file():
        raise RuntimeError("cleanup requires one existing .nogging/state/worktrees/*.json record name")
    try: record = json.loads(path.read_text())
    except (ValueError, OSError): raise RuntimeError(f"unreadable worktree record: {path.name}")
    location, branch = record.get("path"), record.get("branch")
    if not isinstance(location, str) or not isinstance(branch, str):
        raise RuntimeError(f"incomplete worktree record: {path.name}")
    target = Path(location)
    if str(target) not in git_worktree_paths() or not target.is_dir():
        raise RuntimeError(f"recorded worktree is not available for safe cleanup: {target}")
    if run("git", "-C", str(target), "status", "--porcelain", check=False).stdout.strip():
        raise RuntimeError(f"refusing to clean dirty worktree: {target}")
    develop = resolve_ref("develop") or resolve_ref("origin/develop")
    if develop is None or run("git", "merge-base", "--is-ancestor", branch, develop, check=False).returncode:
        raise RuntimeError(f"refusing to clean branch not integrated into develop: {branch}")
    run("git", "worktree", "remove", str(target))
    # The explicit merge-base check above is authoritative. `branch -d` may
    # still reject a safely integrated branch when its upstream is the older
    # origin/develop, so delete the exact verified local ref without consulting
    # that stale upstream relationship.
    run("git", "branch", "-D", branch)
    path.unlink()
    print(f"worktree retired: {target} ({branch})")
def current_branch():
    out = run("git", "branch", "--show-current", check=False).stdout.strip()
    if not out or out == "develop":
        raise RuntimeError("pull requests must be created from an implementation branch, not develop")
    return out
def pull_request(plan, tasks, decisions, validations, limitations):
    """Create or find an open implementation PR; intentionally never merges."""
    branch = current_branch()
    found = run("gh", "pr", "list", "--head", branch, "--base", "develop", "--state", "open",
                "--json", "url", check=False)
    if found.returncode: raise RuntimeError("could not query pull requests with gh")
    try: existing = json.loads(found.stdout or "[]")
    except ValueError: existing = []
    url = existing[0].get("url") if existing and isinstance(existing[0], dict) else None
    body = "\n".join(["## Plan and tasks", f"Plan: {plan}", "Tasks: " + (", ".join(tasks) or "not specified"),
                      "## Implemented", "Describe the implemented behavior.",
                      "## Technical decisions", "\n".join(f"- {x}" for x in decisions) or "- None recorded.",
                      "## Validation", "\n".join(f"- {x}" for x in validations) or "- Not recorded.",
                      "## Limitations / follow-up", "\n".join(f"- {x}" for x in limitations) or "- None."]) + "\n"
    if not url:
        title = f"{plan}: implementation"
        created = run("gh", "pr", "create", "--base", "develop", "--head", branch,
                      "--title", title, "--body", body, check=False)
        if created.returncode: raise RuntimeError("could not create pull request with gh")
        url = created.stdout.strip().splitlines()[-1] if created.stdout.strip() else None
    if not url: raise RuntimeError("GitHub CLI did not return a pull request URL")
    record = {"base": "develop", "branch": branch, "created_at": now(), "plan": plan,
              "tasks": tasks, "url": url, "state": "open",
              "initial_check_after": (dt.datetime.now(dt.timezone.utc) + dt.timedelta(minutes=5)).replace(microsecond=0).isoformat()}
    write_worktree_record(PR_STATE / (re.sub(r"[^a-z0-9-]", "-", branch) + ".json"), record)
    print(f"pull request: {url}")
def pull_request_ci():
    branch = current_branch(); path = PR_STATE / (re.sub(r"[^a-z0-9-]", "-", branch) + ".json")
    if not path.is_file(): raise RuntimeError("no persisted pull request record for this branch")
    rec = json.loads(path.read_text()); due = dt.datetime.fromisoformat(rec["initial_check_after"])
    if dt.datetime.now(dt.timezone.utc) < due:
        print(f"CI initial inspection pending until {due.isoformat()}"); return
    out = run("gh", "pr", "checks", rec["url"], "--required", "--json", "name,state,bucket", check=False)
    try: checks = json.loads(out.stdout or "[]")
    except ValueError: raise RuntimeError("could not parse required pull request checks")
    scope = "required"
    if not checks:
        out = run("gh", "pr", "checks", rec["url"], "--json", "name,state,bucket", check=False)
        try: checks = json.loads(out.stdout or "[]")
        except ValueError: raise RuntimeError("could not parse pull request checks")
        scope = "all"
    if not checks:
        rec["state"] = "ci_pending"
        rec["last_checked_at"] = now(); rec["check_scope"] = scope
        write_worktree_record(path, rec)
        print(f"CI state: ci_pending ({scope} checks; no runs reported yet)")
        return
    # `gh pr checks` deliberately exits non-zero for failed/pending checks, so
    # valid JSON output is authoritative. A non-zero exit with no checks is a
    # genuine query failure.
    if out.returncode and not checks: raise RuntimeError("could not inspect required pull request checks")
    failed = [c.get("name", "unnamed") for c in checks if str(c.get("bucket", "")).lower() in ("fail", "cancel")]
    if failed: rec["state"] = "ci_failed"; rec["failed_checks"] = failed
    elif checks and all(str(c.get("bucket", "")).lower() in ("pass", "skipping") for c in checks): rec["state"] = "ready_for_user_review"
    else: rec["state"] = "ci_pending"
    rec["last_checked_at"] = now(); rec["check_scope"] = scope; write_worktree_record(path, rec)
    print(f"CI state: {rec['state']} ({scope} checks)")
    if failed: print("failed required checks: " + ", ".join(failed))
def changes():
    base = ROOT / "openspec/changes"
    return [p for p in base.iterdir() if p.is_dir() and p.name != "archive"] if base.exists() else []
# `openspec archive <name>` moves a completed change to
# `openspec/changes/archive/YYYY-MM-DD-<name>/`. This strips that date prefix
# back to the original change name so an archived task still matches the
# `openspec:change:` label on its (closed) Beads.
ARCHIVE_DATE_PREFIX_RE = re.compile(r"^\d{4}-\d{2}-\d{2}-")
def task_map(include_archived=False):
    found, duplicates = {}, []
    for change in changes():
        file = change / "tasks.md"
        if not file.exists(): continue
        for task, title in TASK_RE.findall(file.read_text()):
            if task in found: duplicates.append(task)
            found[task] = {"change": change.name, "file": file, "title": title}
    if include_archived:
        archive_base = ROOT / "openspec/changes/archive"
        if archive_base.is_dir():
            for change in sorted(p for p in archive_base.iterdir() if p.is_dir()):
                file = change / "tasks.md"
                if not file.exists(): continue
                name = ARCHIVE_DATE_PREFIX_RE.sub("", change.name)
                for task, title in TASK_RE.findall(file.read_text()):
                    # A live task with the same ID always wins; an archived
                    # same-ID pair is normal after archiving and is not a
                    # duplicate, so it never touches `duplicates`.
                    if task in found: continue
                    found[task] = {"change": name, "file": file, "title": title, "archived": True}
    return found, duplicates
def task_map_at_ref(ref, include_archived=False):
    """Read task mappings from a committed ref without switching worktrees."""
    listing = run("git", "ls-tree", "-r", "--name-only", ref, "--", "openspec/changes", check=False)
    if listing.returncode: return {}, []
    found, duplicates = {}, []
    for name in listing.stdout.splitlines():
        if not name.endswith("/tasks.md") or "/archive/" in name: continue
        text = run("git", "show", f"{ref}:{name}", check=False).stdout
        change = Path(name).parent.name
        for task, title in TASK_RE.findall(text):
            if task in found: duplicates.append(task)
            found[task] = {"change": change, "file": None, "title": title, "ref": ref}
    return found, duplicates
def tick_task_line(path, task):
    """Flip the one unticked `- [ ] <task>` line in `path` to `- [x]`.

    The single implementation of "what ticking means" for both `sync()` (via
    its closed-Bead mirror pass) and `task-done` (a Lead's explicit, synchronous
    call). Naturally idempotent: the regex only matches the unticked form, so a
    line already ticked by either caller is a no-op for the other, in either
    order. Returns True if the file changed.
    """
    text = path.read_text()
    updated = re.sub(rf"^- \[ \] ({re.escape(task)}\b)", r"- [x] \1", text, flags=re.M)
    if updated == text: return False
    path.write_text(updated)
    return True
def task_done(bead_id):
    """`scripts/nogg task-done <bead-id>`: tick the Bead's mapped `tasks.md`
    line. Called by the Lead Agent's close protocol immediately after `bd
    close`, bundled into the same execution commit. Never writes
    `execution-log.md` — that stays `sync()`'s job (design.md, Decision 2).
    """
    out = run(CFG["beads_command"], "show", bead_id, "--json").stdout.strip()
    decoded = json.loads(out or "[]")
    records = decoded.get("issues", decoded) if isinstance(decoded, dict) else decoded
    if isinstance(records, dict): records = [records]
    if not records:
        raise RuntimeError(f"task-done: no such Bead {bead_id}")
    issue = records[0]
    if issue.get("status") != "closed":
        raise RuntimeError(f"task-done: {bead_id} is not closed (status: "
                            f"{issue.get('status')!r}); run `bd close {bead_id}` first")
    _change, task = mapping(issue)
    if not task:
        raise RuntimeError(f"task-done: {bead_id} carries no openspec:task: label")
    tasks, _duplicates = task_map()
    entry = tasks.get(task)
    if entry is None or entry.get("archived"):
        print(f"task-done: {task} not found in a live tasks.md; nothing to tick")
        return
    if tick_task_line(entry["file"], task):
        print(f"task-done: ticked {task} in {entry['file'].relative_to(ROOT)}")
    else:
        print(f"task-done: {task} already ticked in {entry['file'].relative_to(ROOT)}")
def beads():
    out = run(CFG["beads_command"], "list", "--status", BEAD_STATUSES, "--limit", "0", "--json").stdout.strip()
    decoded = json.loads(out or "[]")
    return decoded.get("issues", decoded) if isinstance(decoded, dict) else decoded
def labels(issue): return issue.get("labels") or []
DISCOVERY_LABEL = "discovery"
ACK_LEDGER = STATE / "acknowledged-discoveries.json"
def load_ack():
    """Bead ID -> acknowledgement timestamp. A planning session writes it; the
    mechanical layer only records the acknowledgement, it never decides one.
    A missing or unreadable ledger just means nothing is acknowledged yet."""
    if not ACK_LEDGER.exists(): return {}
    try:
        data = json.loads(ACK_LEDGER.read_text())
        return data if isinstance(data, dict) else {}
    except (ValueError, OSError):
        return {}
def ack_discoveries(ids):
    ledger = load_ack()
    for i in ids: ledger[i] = now()
    data_dir(STATE).joinpath("acknowledged-discoveries.json").write_text(
        json.dumps(ledger, indent=2, sort_keys=True) + "\n")
    print(f"acknowledged {len(ids)} discovery Bead(s): {', '.join(ids)}")
def discovery_is_closed(issue): return issue.get("status") == "closed"
def pending_discoveries():
    """Beads carrying the native `discovery` label, regardless of status.

    The label alone marks a discovery; the note is human-readable prose and is
    never parsed here. A discovery closed before a planning session reviews it
    (exactly what happened to SPEC-1cu) must still surface, so this reads the
    full status set rather than the non-closed default. Ordering: blocked
    first, then open discoveries, then closed-but-unreviewed ones.
    """
    out = run(CFG["beads_command"], "list", "--label", DISCOVERY_LABEL,
              "--status", BEAD_STATUSES, "--limit", "0", "--json").stdout.strip()
    decoded = json.loads(out or "[]")
    issues = decoded.get("issues", decoded) if isinstance(decoded, dict) else decoded
    acknowledged = load_ack()
    issues = [i for i in issues
              if DISCOVERY_LABEL in labels(i) and issue_id(i) not in acknowledged]
    return sorted(issues, key=lambda i: (i.get("status") != "blocked",
                                         discovery_is_closed(i),
                                         str(issue_id(i) or "")))
def issue_note(identifier):
    out = run(CFG["beads_command"], "show", identifier, "--json").stdout.strip()
    decoded = json.loads(out or "[]")
    records = decoded.get("issues", decoded) if isinstance(decoded, dict) else decoded
    if isinstance(records, dict): records = [records]
    return (records[0].get("notes") or "").strip() if records else ""
def discoveries():
    issues = pending_discoveries()
    if not issues:
        print("no pending discoveries")
        return
    blocking = sum(1 for i in issues if i.get("status") == "blocked")
    closed = sum(1 for i in issues if discovery_is_closed(i))
    noun = "discovery" if len(issues) == 1 else "discoveries"
    print(f"{len(issues)} pending {noun} ({blocking} blocking)")
    if closed:
        print(f"  ({closed} already closed, still awaiting planning review)")
    for issue in issues:
        print()
        marker = "  (closed — awaiting review)" if discovery_is_closed(issue) else ""
        print(f"[{issue.get('status') or 'unknown'}] {issue_id(issue)}  {(issue.get('title') or '').strip()}{marker}".rstrip())
        note = issue_note(issue_id(issue))
        for line in (note.splitlines() if note else ["(no human-readable note recorded)"]):
            print(f"    {line}")
def mapping(issue):
    ls = labels(issue)
    change = next((x.split(":", 2)[2] for x in ls if x.startswith("openspec:change:")), None)
    task = next((x.split(":", 2)[2] for x in ls if x.startswith("openspec:task:")), None)
    return change, task
def issue_id(issue): return issue.get("id") or issue.get("identifier") or issue.get("issue_id")
# The OpenSpec write boundary sentinel. Its presence tells the tool-agnostic
# guards that `openspec/` is closed to execution-agent writes. `plan-begin`
# removes it, `plan-end` writes it, a fresh install starts with it present.
# It is advisory to the guards, not a file-mode change, so `git switch` /
# `merge` / `checkout` and the `sync` writer are unaffected by it.
SENTINEL = LOCKS / "openspec.readonly"
def write_sentinel(by="plan-end"):
    data_dir(LOCKS)
    SENTINEL.write_text(json.dumps({"closed_at": now(), "by": by}, indent=2) + "\n")
def remove_sentinel():
    SENTINEL.unlink(missing_ok=True)
def boundary_state_line():
    """One read-only line describing the OpenSpec write boundary, for `doctor`:
    OPEN during an active planning session, LOCKED otherwise, and LOCKED naming
    a stale planning lock as the reason when one is still on disk."""
    ttl = CFG.get("planning_lock_ttl_seconds", 7200)
    fresh = fresh_lock("planning", ttl)
    if fresh and not SENTINEL.exists():
        try:
            age = int((dt.datetime.now(dt.timezone.utc)
                       - dt.datetime.fromisoformat(fresh["created_at"])).total_seconds())
        except (ValueError, KeyError, TypeError):
            age = -1
        return f"openspec write boundary: OPEN (planning session active, lock age {age}s)"
    if (LOCKS / "planning.lock").exists() and not fresh:
        return "openspec write boundary: LOCKED (stale planning lock present — run plan-end --force)"
    return "openspec write boundary: LOCKED"
def dolt_ahead_of_remote():
    """Local Dolt commits on the current branch not present on its configured
    remote, read entirely from local Dolt refs (no network call) — `None` when
    there is no configured remote or the comparison cannot be made (a remote
    never fetched/pushed yet has no local `remotes/<name>/<branch>` ref)."""
    try:
        remotes = json.loads(run(CFG["beads_command"], "dolt", "remote", "list",
                                  "--json", check=False).stdout or "[]")
    except ValueError:
        return None
    if not remotes:
        return None
    remote_name = remotes[0].get("name")
    branch = "main"
    branches = run(CFG["beads_command"], "branch", check=False).stdout
    for line in branches.splitlines():
        line = line.strip()
        if line.startswith("*"):
            branch = line.lstrip("*").strip() or branch
            break
    query = (f"SELECT COUNT(*) AS ahead FROM dolt_log('{branch}') WHERE commit_hash "
             f"NOT IN (SELECT commit_hash FROM dolt_log('remotes/{remote_name}/{branch}'))")
    result = run(CFG["beads_command"], "sql", "--json", query, check=False)
    if result.returncode:
        return None
    try:
        rows = json.loads(result.stdout or "[]")
        return int(rows[0]["ahead"])
    except (ValueError, KeyError, IndexError, TypeError):
        return None
_PREFIX_RULE_RE = re.compile(r"^\s*(?:prefix_rule|regex_rule)\s*\(")
def _codex_rule_files():
    """Every Codex execpolicy `.rules` file that could apply here: the user
    layer `~/.codex/rules/*.rules`, this repo's `.codex/rules/*.rules`, and a
    bare `<repo>/.rules`. Missing directories are simply skipped."""
    seen, out = set(), []
    for d in (Path.home() / ".codex/rules", ROOT / ".codex/rules"):
        if d.is_dir():
            out.extend(sorted(p for p in d.glob("*.rules") if p.is_file()))
    bare = ROOT / ".rules"
    if bare.is_file():
        out.append(bare)
    return [p for p in out if not (p in seen or seen.add(p))]
def stale_codex_rule_lines():
    """INFO lines for any Codex `prefix_rule` / `regex_rule` whose command
    pattern names a filesystem path that does not resolve under ROOT — a rule
    left behind by an unrelated project (e.g. the `~/.codex/rules/default.rules`
    `mkdir -p /srv/repos/...` leftover). Hygiene only, never a failure."""
    lines = []
    for f in _codex_rule_files():
        try:
            text = f.read_text()
        except OSError:
            continue
        for raw in text.splitlines():
            if not _PREFIX_RULE_RE.match(raw):
                continue
            for tok in re.findall(r'"([^"]*)"|\'([^\']*)\'', raw):
                val = tok[0] or tok[1]
                # Only tokens that look like a path (absolute, or containing a
                # separator) are candidates; plain command words are ignored.
                if not val or (not val.startswith(("/", "~", ".")) and "/" not in val):
                    continue
                cand = Path(val).expanduser()
                if not cand.is_absolute():
                    cand = (ROOT / val)
                try:
                    resolved = cand.resolve()
                    inside = resolved == ROOT or ROOT in resolved.parents
                except (OSError, RuntimeError):
                    inside = False
                if not (inside and resolved.exists()):
                    lines.append(f"stale external Codex rule: {raw.strip()} ({f})")
                    break
    return lines
def codex_home():
    """`$CODEX_HOME` if set, else `~/.codex` — the dir Codex 0.148 loads custom
    prompts from (`<CODEX_HOME>/prompts/`)."""
    return Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex"))
def pi_trust_path():
    """`~/.pi/agent/trust.json` — Pi's per-project trust decision store. No
    env-var override exists for this location (unlike Codex's CODEX_HOME);
    confirmed from the installed @earendil-works/pi-coding-agent source."""
    return Path.home() / ".pi/agent/trust.json"
def pi_project_trusted(workdir):
    """Whether `workdir` (or its nearest trusted/untrusted ancestor) has a
    standing Pi project-trust decision, mirroring Pi's own nearest-ancestor
    lookup (ProjectTrustStore.getEntry / findNearestTrustEntry): walk upward
    from `workdir` until an entry is found. Returns True/False when a
    decision exists, None when nothing in the trust file covers this path at
    all (a fresh project pi has never been run against, or the trust file
    itself doesn't exist yet)."""
    path = pi_trust_path()
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text())
    except (ValueError, OSError):
        return None
    if not isinstance(data, dict):
        return None
    cur = Path(workdir).resolve()
    while True:
        val = data.get(str(cur))
        if isinstance(val, bool):
            return val
        parent = cur.parent
        if parent == cur:
            return None
        cur = parent
def _codex_repo_prompts():
    """The repo's version-controlled Codex prompt files, `.codex/prompts/*.md`."""
    d = ROOT / ".codex/prompts"
    return sorted(p for p in d.glob("*.md") if p.is_file()) if d.is_dir() else []
def codex_prompt_link_plan():
    """For each `.codex/prompts/*.md` in the repo, a `(src, target, state)` row
    where `target` is `<CODEX_HOME>/prompts/nogging-<basename>.md` and `state`
    is one of:
      linked     — `target` is our symlink, pointing at `src`
      wrong      — `target` is a symlink, but to something else
      collision  — `target` exists and is not a symlink (a real file/dir)
      missing    — nothing at `target`
    Read-only; used by `codex-prompts-link` and by the `doctor` NOTE."""
    dest_dir = codex_home() / "prompts"
    plan = []
    for src in _codex_repo_prompts():
        target = dest_dir / f"nogging-{src.name}"
        if target.is_symlink():
            try:
                resolved = target.resolve()
            except (OSError, RuntimeError):
                resolved = None
            state = "linked" if resolved == src.resolve() else "wrong"
        elif target.exists():
            state = "collision"
        else:
            state = "missing"
        plan.append((src, target, state))
    return plan
def codex_prompts_link(unlink=False):
    """Symlink every repo `.codex/prompts/*.md` into `<CODEX_HOME>/prompts/` as
    `nogging-<basename>.md` (Codex 0.148 only reads user-scoped prompts).
    Idempotent: a correct link is left, a wrong target is repointed, a real file
    that is not our symlink is reported and left. `--unlink` removes only the
    `nogging-*` symlinks."""
    dest_dir = codex_home() / "prompts"
    if unlink:
        removed = []
        if dest_dir.is_dir():
            for p in sorted(dest_dir.glob("nogging-*")):
                if p.is_symlink():
                    p.unlink()
                    removed.append(p)
        for p in removed:
            print(f"unlinked   {p}")
        if not removed:
            print(f"nothing to unlink under {dest_dir}")
        return
    plan = codex_prompt_link_plan()
    if not plan:
        print(f"no .codex/prompts/*.md under {ROOT} — nothing to link")
        return
    dest_dir.mkdir(parents=True, exist_ok=True)
    unresolved = 0
    for src, target, state in plan:
        if state == "linked":
            print(f"ok         {target} -> {src}")
        elif state == "collision":
            unresolved += 1
            print(f"SKIP       {target} exists and is not a nogging symlink — "
                  f"resolve it by hand, then re-run")
        else:  # missing or wrong: (re)point at src
            if target.is_symlink():
                target.unlink()
            target.symlink_to(src)
            print(f"{'relinked' if state == 'wrong' else 'linked  '}   {target} -> {src}")
    if unresolved:
        print(f"{unresolved} file(s) need operator action (see SKIP above)")
def lock(name, ttl, force=False):
    path = data_dir(LOCKS) / f"{name}.lock"
    if path.exists() and not force:
        info = json.loads(path.read_text())
        then = dt.datetime.fromisoformat(info["created_at"])
        if (dt.datetime.now(dt.timezone.utc) - then).total_seconds() < ttl:
            raise LockBusyError(f"{name} lock held by {info['host']} pid {info['pid']}; use --force only after verifying it is stale")
    path.write_text(json.dumps({"pid": os.getpid(), "host": socket.gethostname(), "created_at": now()}, indent=2) + "\n")
    return path
def orchestrator_lock_ttl():
    """Staleness horizon for `.nogging/locks/orchestrator.lock`. Long by
    default — the orchestrator is always-on and its supervisor rewrites the
    lock's `created_at` on every (re)start — so a lock only reads as stale once
    the supervisor has been gone for a full day."""
    return int(CFG.get("orchestrator_lock_ttl_seconds", 86400))
def acquire_orchestrator_lock(force=False):
    """Acquire the single-instance orchestrator lock. Same JSON shape as the
    planning lock (`pid` / `host` / `created_at`) and the same TTL staleness
    rule, plus a same-host pid-liveness check: a fresh lock whose holder process
    is gone is reclaimable without `--force`. Raises `LockBusyError`, naming the
    holder, when a fresh lock is held by a live process (or by any process on
    another host, which cannot be probed). `--force` reclaims unconditionally,
    consistent with `plan-end --force`."""
    path = data_dir(LOCKS) / "orchestrator.lock"
    if path.exists() and not force:
        try:
            info = json.loads(path.read_text())
        except (ValueError, OSError):
            info = {}
        fresh = fresh_lock("orchestrator", orchestrator_lock_ttl()) is not None
        same_host = info.get("host") == socket.gethostname()
        alive = (same_host and isinstance(info.get("pid"), int)
                 and pid_alive(info["pid"]))
        if fresh and (alive or not same_host):
            raise LockBusyError(
                f"orchestrator lock held by {info.get('host', '?')} pid "
                f"{info.get('pid', '?')}; use --force only after verifying it is stale")
    path.write_text(json.dumps(
        {"pid": os.getpid(), "host": socket.gethostname(), "created_at": now()},
        indent=2) + "\n")
    return path
def release_orchestrator_lock():
    (LOCKS / "orchestrator.lock").unlink(missing_ok=True)
LIMBO_TOKEN_RE = re.compile(r"\[([A-Z][A-Z0-9]*-[0-9a-z]+)\]")
def branch_commit_tokens():
    """Bead ID token `[<id>]` -> newest non-merge commit SHA on HEAD's history
    whose subject carries it (the `[SPEC-xxx]` token the `commit-msg` hook
    enforces on execution commits). Empty when this is not a git repository."""
    res = run("git", "log", "--no-merges", "--format=%H %s", check=False)
    if res.returncode:
        return {}
    out = {}
    for line in res.stdout.splitlines():
        h, _, subject = line.partition(" ")
        for token in LIMBO_TOKEN_RE.findall(subject):
            out.setdefault(token, h)
    return out
def limbo_warnings(issues, commit_tokens=None):
    """`LIMBO: <id> committed in <sha> but status=<status>` for every Bead that
    has a commit carrying its ID token on HEAD's history but is not closed (W1:
    a committed-but-not-closed Bead is invisible and risks a duplicate commit on
    resume). A warning, never a problem — the sync timer must keep mirroring the
    Beads that *are* closed."""
    commit_tokens = branch_commit_tokens() if commit_tokens is None else commit_tokens
    out = []
    for issue in issues:
        bid = str(issue_id(issue) or "")
        sha = commit_tokens.get(bid)
        if not bid or not sha:
            continue
        status = issue.get("status") or "unknown"
        if status != "closed":
            out.append(f"LIMBO: {bid} committed in {sha[:12]} but status={status}")
    return out
def validate(fallback_ref=None):
    # include_archived=True so a closed Bead still labelled for a change that
    # has since been archived resolves cleanly instead of tripping "maps missing
    # task" / "change label disagrees". materialize() and sync() keep using the
    # live-only map.
    #
    # Returns (tasks, issues, problems, warnings). `problems` are hard
    # disagreements — `sync()` raises `AuditError` on any of them and the sync
    # timer stops until a human resolves it. `warnings` are advisory: a
    # committed-but-open Bead and the like, surfaced by `doctor` / `recover`
    # but never blocking the mirror (a warning must not redden `sync`).
    tasks, duplicates = task_map(include_archived=True); issues = beads()
    fallback, fallback_duplicates = task_map_at_ref(fallback_ref, include_archived=True) if fallback_ref else ({}, [])
    problems = []; warnings = []
    if duplicates: problems.append("duplicate task IDs: " + ", ".join(sorted(set(duplicates))))
    seen = {}
    for issue in issues:
        change, task = mapping(issue)
        if bool(change) != bool(task): problems.append(f"{issue_id(issue)} has incomplete OpenSpec labels")
        if task:
            if task not in tasks and task in fallback:
                tasks[task] = fallback[task]
            if task not in tasks: problems.append(f"{issue_id(issue)} maps missing task {task}")
            elif tasks[task]["change"] != change: problems.append(f"{issue_id(issue)} change label disagrees with {task}")
            if task in seen: problems.append(f"multiple Beads map {task}: {seen[task]}, {issue_id(issue)}")
            seen[task] = issue_id(issue)
    for task, info in tasks.items():
        # An archived tasks.md is frozen — its checked lines were already
        # backed by a closed Bead when the change was archived and nothing can
        # change them now, so skip the reverse check for archived files.
        if info.get("archived") or info.get("file") is None: continue
        if re.search(rf"^- \[x\] {re.escape(task)}\b", info["file"].read_text(), re.M):
            issue = next((i for i in issues if mapping(i)[1] == task), None)
            if not issue or issue.get("status") != "closed": problems.append(f"checked task {task} has no closed Bead")
    warnings.extend(limbo_warnings(issues))
    return tasks, issues, problems, warnings
def archive_ready_changes(tasks, issues):
    """Live (non-archived) changes whose every live task has a closed mapped
    Bead — candidates `doctor` reports as ready for `/plan`'s archive step.

    Uses the same closed-inclusive `issues` (from `beads()`, via `validate()`)
    that `sync()`/`materialize()` already read, not the default closed-
    excluding `bd list`. A change with any task that has no mapped Bead yet,
    or whose mapped Bead is not closed, is excluded — this never fires for a
    change still in progress or not yet materialized.
    """
    by_change = {}
    for task, info in tasks.items():
        if info.get("archived"): continue
        by_change.setdefault(info["change"], set()).add(task)
    closed_tasks = {mapping(i)[1] for i in issues
                    if mapping(i)[1] and i.get("status") == "closed"}
    return sorted(change for change, task_ids in by_change.items()
                  if task_ids <= closed_tasks)
def materialize(change):
    tasks, issues, problems, _warnings = validate()
    if problems: raise AuditError("validation failed:\n- " + "\n- ".join(problems))
    selected = [(task, info) for task, info in tasks.items()
                if info["change"] == change and not info.get("archived")]
    if not selected: raise RuntimeError(f"no tasks found for change {change}")
    # `issues` comes from beads(), which reads the full status set, so a task
    # whose mapped Bead is already closed counts as materialized and is not
    # recreated (discovery SPEC-dvu: a partly-done change was duplicating the
    # Beads of its finished tasks on a re-run).
    existing = {mapping(issue)[1] for issue in issues if mapping(issue)[0] == change}
    # A resumable journal: which tasks this run set out to create, and which it
    # has a Bead for so far. A task whose Bead already exists counts as created;
    # `tasks_planned` minus `tasks_created` is exactly what a resumed run (or
    # `recover`) still needs. Written before the first `bd create`, updated after
    # each, deleted on clean completion.
    planned = [task for task, _ in selected]
    created = [task for task in planned if task in existing]
    journal = data_dir(STATE) / f"materialize-{change}.json"
    started = now()
    def write_journal():
        journal.write_text(json.dumps(
            {"started_at": started, "tasks_planned": planned, "tasks_created": sorted(created)},
            indent=2, sort_keys=True) + "\n")
    write_journal()
    for task, info in selected:
        if task in existing:
            print(f"already materialized {task}")
            continue
        run(CFG["beads_command"], "create", "--title", f"{task}: {info['title']}", "--type", "task", "--labels", f"openspec:change:{change},openspec:task:{task}")
        created.append(task)
        write_journal()
        print(f"materialized {task}")
    journal.unlink(missing_ok=True)
def commit_refs(issue):
    """Implementation commit references for a closed Bead, determined without a
    native Beads field:

    - every `git log` subject carrying the Bead ID token `[<id>]` (the token the
      `commit-msg` hook enforces on execution commits);
    - any 7-40 hex SHA the execution agent already wrote into the Bead note.

    Results are de-duplicated (a short note SHA that prefixes a full log hash is
    treated as the same commit). The caller states explicitly when the list is
    empty.
    """
    bid = str(issue_id(issue) or "")
    full = []
    if bid:
        token = f"[{bid}]"
        res = run("git", "log", "--format=%H %s", check=False)
        for line in res.stdout.splitlines():
            h, _, subject = line.partition(" ")
            if token in subject and h not in full:
                full.append(h)
    refs = [h[:12] for h in full]
    note = (issue.get("notes") or "").lower()
    for sha in dict.fromkeys(re.findall(r"\b[0-9a-f]{7,40}\b", note)):
        if not any(c.isdigit() for c in sha):
            continue
        if any(h.startswith(sha) for h in full) or sha in refs:
            continue
        refs.append(sha)
    return refs
def closure_event_key(issue):
    """Stable per-closure marker: `closed_at`, falling back to `updated_at`."""
    stamp = issue.get("closed_at") or issue.get("updated_at") or "closed"
    return f"<!-- nogg:{issue_id(issue)}:{stamp} -->"
def execution_log_entry(issue, task):
    """Render one enriched execution-log entry for a closed mapped Bead.

    Carries the Bead ID, the closure timestamp (`closed_at`, falling back to
    `updated_at`), determinable implementation commit references, and the Bead's
    human-readable note preserved verbatim as an indented block. The entry is
    written even when no commit reference is found; absence is stated.
    """
    bid = issue_id(issue)
    closed_at = issue.get("closed_at") or issue.get("updated_at") or "unknown"
    lines = [closure_event_key(issue),
             f"- {now()} — {bid} closed for {task} (Bead closed at {closed_at})."]
    refs = commit_refs(issue)
    lines.append(f"  - implementation commits: {', '.join(refs)}" if refs
                 else "  - implementation commits: none found")
    note = (issue.get("notes") or "").strip()
    if note:
        lines.append("  - Bead note:")
        lines.extend("    " + ln for ln in note.splitlines())
    else:
        lines.append("  - Bead note: (none recorded)")
    return "\n".join(lines) + "\n"
FAILURE_RECORD = STATE / "sync-failure.json"
def classify_failure(exc):
    """Mechanical classification by exception type/source.

    Permanent (an operator must resolve the disagreement, no automatic retry):
    an `AuditError` — a failed invariant audit, a mapping conflict, a missing
    task, a malformed `tasks.md`.

    Transient (safe to retry until `max_attempts`): `LockBusyError` (the sync
    lock is held but not yet stale), `ToolError` (a `git`/`bd` invocation
    failed), a JSON decode of a partial `bd` response, and anything else.
    """
    if isinstance(exc, AuditError): return "permanent"
    if isinstance(exc, (LockBusyError, ToolError, json.JSONDecodeError)): return "transient"
    if "audit failed" in str(exc).lower() or "validation failed" in str(exc).lower():
        return "permanent"
    return "transient"
def record_failure(exc):
    """Persist a structured, classified active-failure record. Consecutive
    failed syncs increment `attempts`; a successful sync clears the record."""
    st = data_dir(STATE)
    prev = {}
    if FAILURE_RECORD.exists():
        try: prev = json.loads(FAILURE_RECORD.read_text())
        except (ValueError, OSError): prev = {}
    classification = classify_failure(exc)
    attempts = int(prev.get("attempts", 0)) + 1
    max_attempts = int(CFG.get("sync_max_attempts", 5))
    stamp = now()
    retryable = classification == "transient" and attempts < max_attempts
    if retryable:
        base = int(CFG.get("sync_retry_base_seconds", CFG.get("sync_interval_seconds", 30)))
        cap = int(CFG.get("sync_retry_cap_seconds", 1800))
        delay = min(cap, base * (2 ** (attempts - 1)))
        next_retry = (dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
                      + dt.timedelta(seconds=delay)).isoformat()
    else:
        next_retry = None
    record = {"classification": classification, "error": str(exc),
              "attempts": attempts, "max_attempts": max_attempts,
              "first_seen": prev.get("first_seen", stamp), "last_seen": stamp,
              "next_retry_after": next_retry}
    (st / "sync-failure.json").write_text(json.dumps(record, indent=2) + "\n")
    with (st / "sync-failures.jsonl").open("a") as fh:
        fh.write(json.dumps({"event_time": stamp, **record}) + "\n")
    (st / "last-error.json").unlink(missing_ok=True)
    return record
def clear_failure():
    FAILURE_RECORD.unlink(missing_ok=True)
def read_last_success():
    """The parsed `last-success.json`, or `{}` when it is missing or unreadable.
    A legacy `{"at": ...}`-only file (no `branch`) reads back fine — callers use
    `.get("branch")`."""
    try:
        data = json.loads((STATE / "last-success.json").read_text())
        return data if isinstance(data, dict) else {}
    except (ValueError, OSError):
        return {}
SKIP_RECORD = STATE / "last-skip.json"
def record_skip(reason):
    """Persist why the most recent tick skipped, so a mirror that has quietly
    stalled (a long planning session, a forgotten mid-merge) is visible to
    `doctor`. Cleared by the next real or no-op sync."""
    data_dir(STATE).joinpath("last-skip.json").write_text(
        json.dumps({"at": now(), "reason": reason}, indent=2) + "\n")
def clear_skip():
    SKIP_RECORD.unlink(missing_ok=True)
def parse_iso(iso):
    """Parse an ISO 8601 timestamp, accepting a trailing 'Z' (as Beads emits)
    on every supported Python version — `datetime.fromisoformat` only started
    accepting 'Z' directly in Python 3.11."""
    return dt.datetime.fromisoformat(iso.replace("Z", "+00:00"))
def humanize_age(iso):
    """A compact age string (`45s`, `12m`, `3h`, `2d`) for an ISO timestamp, or
    `age unknown` when it will not parse."""
    try:
        secs = int((dt.datetime.now(dt.timezone.utc)
                    - parse_iso(iso)).total_seconds())
    except (ValueError, TypeError, AttributeError):
        return "age unknown"
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs >= size:
            return f"{secs // size}{unit}"
    return f"{max(secs, 0)}s"
def sync(on_request=False):
    state, info = repo_sync_state(on_request=on_request)
    if state == "skip":
        # A skipped tick is a no-op, not a failure: no sync-failure.json, no
        # backoff, last-success.json untouched, so the next tick just retries.
        # `sync --now` (on_request) is allowed on a protected branch but a
        # genuine mid-operation / held planning lock still refuses here — the
        # operator has to finish that first.
        record_skip(info)
        if on_request:
            print(f"sync --now: refused — {info}; finish that first, then rerun")
        else:
            print(f"sync: skipped ({info})")
        return
    branch = info
    path = None
    try:
        path = lock("sync", CFG["sync_lock_ttl_seconds"])
        tasks, issues, problems, _warnings = validate()
        if problems: raise AuditError("audit failed:\n- " + "\n- ".join(problems))
        changed = []
        for issue in issues:
            change, task = mapping(issue)
            if not task or issue.get("status") != "closed": continue
            # A closed Bead whose task now lives only in an archived change is
            # already mirrored in that change's (archived) execution log. Never
            # recreate a live directory or rewrite the frozen archived tasks.md.
            if tasks.get(task, {}).get("archived"): continue
            log = ROOT / "openspec/changes" / change / "execution-log.md"
            log.parent.mkdir(parents=True, exist_ok=True)
            key = closure_event_key(issue)
            current = log.read_text() if log.exists() else "# Execution log\n"
            if key not in current:
                log.write_text(current + "\n" + execution_log_entry(issue, task))
                changed.append(log)
            f = tasks[task]["file"]
            if tick_task_line(f, task): changed.append(f)
        if changed:
            run("git", "add", *sorted({str(p.relative_to(ROOT)) for p in changed}))
            # `sync`'s working directory is whatever branch the timer finds
            # checked out — commonly the shared checkout, which may also host
            # the orchestrator's own `git config --worktree` identity. A
            # direct author/committer override here avoids fighting over that
            # shared `--worktree` config with whichever persona set it last.
            sync_name, sync_email = persona_identity("sync")
            run("git", "commit",
                "-m", "chore(sync): mirror Beads execution evidence",
                "-m", "Nogging-Writer: sync",
                env={**os.environ, "NOGGING_WRITER": "sync",
                     "GIT_AUTHOR_NAME": sync_name, "GIT_AUTHOR_EMAIL": sync_email,
                     "GIT_COMMITTER_NAME": sync_name, "GIT_COMMITTER_EMAIL": sync_email})
            print(f"synced {len(set(changed))} file(s)")
        else: print("sync: no changes")
        prev = read_last_success()
        prev_branch = prev.get("branch")
        if prev_branch and prev_branch != branch:
            print(f"sync: note — mirroring on {branch} (last run was on {prev_branch})")
        data_dir(STATE).joinpath("last-success.json").write_text(
            json.dumps({"at": now(), "branch": branch}, indent=2) + "\n")
        clear_failure()
        clear_skip()
    except Exception as exc:
        record_failure(exc)
        raise
    finally:
        if path is not None: path.unlink(missing_ok=True)
SYNC_PID = STATE / "sync.pid"
def pid_alive(pid):
    """True if `pid` names a process this user can see. A permission error still
    means the process exists; only 'no such process' counts as dead."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True
def fresh_lock(name, ttl):
    """The lock-file contents if `<name>.lock` exists and is younger than `ttl`
    seconds, else None. A missing or unparseable file reads as not-held."""
    path = LOCKS / f"{name}.lock"
    if not path.exists():
        return None
    try:
        info = json.loads(path.read_text())
        then = dt.datetime.fromisoformat(info["created_at"])
    except (ValueError, OSError, KeyError):
        return None
    if (dt.datetime.now(dt.timezone.utc) - then).total_seconds() < ttl:
        return info
    return None
# Git-dir marker -> the reason string a sync tick prints when it finds it. `.git`
# is resolved with `git rev-parse --git-dir` (never a literal `.git/`) so the
# checks also fire when `sync` runs inside a linked worktree.
MIDOP_MARKERS = (
    ("MERGE_HEAD", "merge in progress"),
    ("rebase-merge", "rebase in progress"),
    ("rebase-apply", "rebase in progress"),
    ("CHERRY_PICK_HEAD", "cherry-pick in progress"),
    ("BISECT_LOG", "bisect in progress"),
)
def git_dir():
    """The absolute path to the repository's git directory, or None when the
    working tree is not a git repository."""
    res = run("git", "rev-parse", "--git-dir", check=False)
    if res.returncode:
        return None
    p = Path(res.stdout.strip())
    return p if p.is_absolute() else (ROOT / p)
def repo_sync_state(on_request=False):
    """Classify the repository for a mechanical sync pass.

    Returns `("ok", branch)` when a mirror commit is safe, or `("skip", reason)`
    when the tick must be a no-op:

    - a fresh `planning.lock` is held (planning and sync must not interleave);
    - a merge, rebase, cherry-pick, or bisect is in progress;
    - `HEAD` is detached;
    - `HEAD` is on a branch in `sync_protected_branches` and `on_request` is
      False (an operator-invoked `sync --now` passes `on_request=True` and is
      allowed on a protected branch, but the first three still skip).
    """
    if fresh_lock("planning", CFG["planning_lock_ttl_seconds"]) is not None:
        return ("skip", "planning session active")
    gd = git_dir()
    if gd is not None:
        for marker, reason in MIDOP_MARKERS:
            if (gd / marker).exists():
                return ("skip", reason)
    res = run("git", "symbolic-ref", "-q", "--short", "HEAD", check=False)
    if res.returncode != 0:
        return ("skip", "detached HEAD")
    branch = res.stdout.strip()
    protected = CFG.get("sync_protected_branches", ["main", "develop"])
    if not on_request and branch in protected:
        return ("skip", f"on protected branch {branch}")
    return ("ok", branch)
def sync_now():
    """On-demand reconciliation for `/sync-now`.

    Encapsulates the three cases so the command file stays a one-liner:
    signal a resident sync daemon if one is running (none exists under the
    current oneshot timer, kept for a future daemon); otherwise run one pass
    directly; and if the 30-second timer already holds the sync lock, report
    the contention and exit without retrying rather than racing it.
    """
    if SYNC_PID.exists():
        try:
            pid = int(SYNC_PID.read_text().split()[0])
        except (ValueError, OSError):
            pid = None
        if pid and pid_alive(pid):
            os.kill(pid, signal.SIGUSR1)
            print(f"signalled sync daemon pid {pid} (SIGUSR1) to reconcile now")
            return
    held = fresh_lock("sync", CFG["sync_lock_ttl_seconds"])
    if held:
        print(f"sync lock held by {held.get('host', '?')} pid {held.get('pid', '?')}; "
              f"the timer is mid-pass — not retrying")
        return
    try:
        sync(on_request=True)
    except LockBusyError as exc:
        # The timer grabbed the lock between the check above and sync()'s own
        # acquire. Same outcome: report, do not retry.
        print(f"{exc}; the timer is mid-pass — not retrying")
# --- session observability: per-agent state adapters -----------------------
# An Adapter is a plain data record, not a single global keyword table: an
# `ignore` pattern list (benign chrome stripped before classifying) plus
# ordered per-state pattern lists. This is a direct fix for the hand-rolled
# predecessor's false-positive problem — every Claude pane permanently
# showing `Auto-update failed: no write permission to npm prefix`, which a
# bare `failed` keyword match flagged as needing attention forever (#23).
@dataclass
class Adapter:
    name: str
    ignore: list = field(default_factory=list)
    working: list = field(default_factory=list)
    waiting_bg: list = field(default_factory=list)
    needs_input: list = field(default_factory=list)
    limit: list = field(default_factory=list)
    idle: list = field(default_factory=list)
    # Checked only when `idle` would otherwise be reported (Claude-only — no
    # equivalent permission-mode status line exists for Codex).
    manual_mode: list = field(default_factory=list)

def _pats(*patterns, flags=0):
    return [re.compile(p, flags) for p in patterns]

# Patterns are shipped verbatim from design.md's production-observed tables
# (#23) — not re-derived — because re-guessing them would re-risk the exact
# false-positive class this change exists to fix.
CLAUDE_ADAPTER = Adapter(
    name="claude",
    ignore=_pats(r"Auto-update failed", r"Tip:"),
    working=_pats(r"esc to interrupt"),
    waiting_bg=_pats(r"\d+ shells?( still running)?", r"\d+ monitors?"),
    needs_input=_pats(r"Do you want to proceed", r"Allow this", r"❯ 1\. Yes"),
    limit=_pats(r"usage limit reached", r"rate limit", flags=re.I),
    idle=_pats(r"❯\s*$"),
    manual_mode=_pats(r"⏸ manual mode on"),
)
CODEX_ADAPTER = Adapter(
    name="codex",
    working=_pats(r"Working \("),
    idle=_pats(r"Ask Codex to do anything"),
    # `undelivered_input`: `Pasted Content` sitting visible is the lost-
    # message failure mode itself (#23) — pane text otherwise reads idle.
    needs_input=_pats(r"Pasted Content"),
)
ADAPTERS = {"claude": CLAUDE_ADAPTER, "codex": CODEX_ADAPTER}
# Classification precedence, fixed: `limit` > `needs_input` > `working` >
# `waiting_background` > `idle` (narrowed to `awaiting_manual_approval` when
# `adapter.manual_mode` also matches), else `unknown`.
_CLASSIFY_ORDER = (
    ("limit", "limit"), ("needs_input", "needs_input"),
    ("working", "working"), ("waiting_bg", "waiting_background"),
    ("idle", "idle"),
)
def classify(pane_text, adapter):
    """Classify `pane_text` (a captured tmux pane) under `adapter`.

    Reads only the last ~15 lines (never full scrollback), strips lines
    matching `adapter.ignore` first, then checks states in the fixed
    precedence order above. An `idle` hit is narrowed to
    `awaiting_manual_approval` when `adapter.manual_mode` also matches one of
    the kept lines (Claude-only: `CODEX_ADAPTER.manual_mode` is empty, so
    this never fires for Codex). Returns `unknown` when nothing matches."""
    lines = (pane_text or "").splitlines()[-15:]
    kept = [ln for ln in lines
            if not any(p.search(ln) for p in adapter.ignore)]
    for attr, state in _CLASSIFY_ORDER:
        patterns = getattr(adapter, attr)
        if patterns and any(p.search(ln) for ln in kept for p in patterns):
            if state == "idle" and any(
                    p.search(ln) for ln in kept for p in adapter.manual_mode):
                return "awaiting_manual_approval"
            return state
    return "unknown"
# --- session supervision ---------------------------------------------------
# A thin, mechanical layer that runs each Nogging-launched Claude Code
# session inside a named tmux session on a dedicated server socket, tracks it
# with a durable JSON record, and exposes list / attach / log / stop / cleanup
# from a plain SSH shell. It starts and tracks processes; it makes no product
# decision and never mutates a Bead.

SESSION_ACTIVE_STATES = {"starting", "running", "idle"}
SESSION_TERMINAL_STATES = {"stopped", "failed", "retired"}
# Environment variable names whose values must never reach the metadata record,
# the tmux scrollback, or the log. Matched case-insensitively as substrings.
SECRET_NAME_RE = re.compile(r"TOKEN|SECRET|PASSWORD|PASSWD|APIKEY|API_KEY|_KEY|CREDENTIAL|AUTH", re.I)
# A dotted-key `= value` assignment whose key is secret-named, as it would
# appear inside a `-c key=value` agent config override on the recorded
# command line. The value (quoted or bare) is scrubbed even when it is a
# literal that never passed through the environment.
_SECRET_ASSIGN_RE = re.compile(
    r"([\w.-]*(?:TOKEN|SECRET|PASSWORD|PASSWD|APIKEY|API_KEY|_KEY|CREDENTIAL|AUTH)[\w.-]*\s*=\s*)"
    r"(\"[^\"]*\"|'[^']*'|\S+)", re.I)

def scfg(key, default): return CFG.get(key, default)
def multi_machine_enabled(): return bool(scfg("multi_machine", False))
# A short, fixed deny-list unioned into `permissions.deny` of every launch
# profile — named, default, or a path the operator supplied — before the
# effective settings file is written. No profile can grant these. It is a
# guard rail against an accident or a prompt-injected `rm -rf ~`, not an
# OS-level boundary; keep it short so a settings-schema change is a small edit.
FLOOR_DENY = [
    "Bash(rm -rf:*)", "Bash(rm -fr:*)", "Bash(sudo:*)", "Bash(dd:*)",
    "Bash(mkfs:*)", "Bash(mkfs.*:*)", "Bash(shutdown:*)", "Bash(reboot:*)",
]
def merge_floor(settings):
    """Return a deep copy of `settings` with FLOOR_DENY unioned into
    `permissions.deny`. Existing deny entries are kept and order is stable;
    the input dict is never mutated."""
    result = json.loads(json.dumps(settings))
    perms = result.setdefault("permissions", {})
    deny = list(perms.get("deny") or [])
    for entry in FLOOR_DENY:
        if entry not in deny:
            deny.append(entry)
    perms["deny"] = deny
    return result
# Edit-tool deny rules that make openspec/ a read-only root in the effective
# authority of a launched Claude execution session. The tool-agnostic sibling of
# the PreToolUse guard: the guard is the fast in-model signal, these are the
# per-session authority backstop. Unioned in (never replacing) the profile's own
# deny list, exactly like FLOOR_DENY.
OPENSPEC_READONLY_DENY = ["Edit(openspec/**)", "Write(openspec/**)", "MultiEdit(openspec/**)"]
def deny_openspec_writes(settings):
    """Return a deep copy of `settings` with OPENSPEC_READONLY_DENY unioned into
    `permissions.deny`. Same contract as merge_floor(): input never mutated,
    existing entries kept, order stable."""
    result = json.loads(json.dumps(settings))
    perms = result.setdefault("permissions", {})
    deny = list(perms.get("deny") or [])
    for entry in OPENSPEC_READONLY_DENY:
        if entry not in deny:
            deny.append(entry)
    perms["deny"] = deny
    return result
# Claude Layer 2 (design.md Decision 4): one `Stop` and one `Notification`
# hook entry, each invoking `session emit` so `watch` can prefer a structured
# events file over pane-scraping. Appended into `hooks.<event>` by
# merge_observability_hooks() below — never replacing or reordering an
# existing entry for that event, exactly like FLOOR_DENY / OPENSPEC_READONLY_DENY.
OBSERVABILITY_HOOKS = {
    "Stop": {"hooks": [{"type": "command", "command": "scripts/nogg session emit turn_end"}]},
    "Notification": {"hooks": [{"type": "command", "command": "scripts/nogg session emit needs_input"}]},
}
def merge_observability_hooks(settings):
    """Return a deep copy of `settings` with the Layer-2 Stop/Notification
    hook entries appended to `hooks.<event>` — appended, never replacing or
    reordering any existing entry for that event. Input never mutated."""
    result = json.loads(json.dumps(settings))
    hooks = result.setdefault("hooks", {})
    for event, entry in OBSERVABILITY_HOOKS.items():
        existing = list(hooks.get(event) or [])
        existing.append(entry)
        hooks[event] = existing
    return result
def resolve_launch_file(value, dir_key, default_dir, suffix):
    """Resolve a `--profile` / `--prompt` value to a concrete file.

    A bare name resolves under the configured directory
    (`<dir>/<value><suffix>`); anything else is treated as a filesystem path,
    absolute or relative to the repo root. Returns `(resolved_path, label)`
    where `label` is the bare name for a directory hit or the basename for a
    supplied path. Raises before any tmux session is created when nothing
    resolves."""
    named = (ROOT / scfg(dir_key, default_dir) / f"{value}{suffix}")
    if named.is_file():
        return named.resolve(), value
    candidate = Path(value) if Path(value).is_absolute() else (ROOT / value)
    if candidate.is_file():
        return candidate.resolve(), candidate.name
    raise RuntimeError(
        f"launch file {value!r} did not resolve: neither {named} nor "
        f"{candidate} exists")
def tmux_bin(): return scfg("session_tmux_command", "tmux")
def tmux_socket(): return scfg("session_tmux_socket", "nogging")
def sessions_dir(): return data_dir(ROOT / scfg("session_state_dir", ".nogging/state/sessions"))
def tmux(*args, check=True):
    """Invoke the dedicated Nogging tmux server (never the operator's own)."""
    return run(tmux_bin(), "-L", tmux_socket(), *args, check=check)
def tmux_has_session(name):
    return tmux("has-session", "-t", name, check=False).returncode == 0
def tmux_sessions():
    res = tmux("list-sessions", "-F", "#{session_name}", check=False)
    if res.returncode != 0: return set()
    return {ln.strip() for ln in res.stdout.splitlines() if ln.strip()}
def secret_values():
    return [v for k, v in os.environ.items()
            if v and len(v) >= 4 and SECRET_NAME_RE.search(k)]
def redact(text):
    for v in secret_values(): text = text.replace(v, "***REDACTED***")
    return _SECRET_ASSIGN_RE.sub(lambda m: m.group(1) + "***REDACTED***", text)
def redact_argv(argv): return [redact(a) for a in argv]
def owner_identity(explicit=None):
    user = explicit or os.environ.get("SUDO_USER") or getpass.getuser()
    conn = os.environ.get("SSH_CONNECTION", "").split()
    return f"{user} (ssh {conn[0]})" if conn else user
def slugify(name):
    """Lowercase, non-alphanumerics to single hyphens, trimmed; empty -> 'repo'.
    Mirrors bin/lib/install.js slugify() so a session name and a systemd unit
    name for the same repo agree on the slug."""
    s = re.sub(r"-+$", "", re.sub(r"^-+", "", re.sub(r"[^a-z0-9]+", "-", str(name).lower())))
    return s or "repo"
def repo_slug():
    """The per-repository slug — `slugify(<repo dir basename>)`. Used for the
    singleton orchestrator session name `nogg-orchestrator-<slug>`."""
    return slugify(ROOT.name)
def normalize_role(role):
    """Return (metadata_role, name_slug). Accepts `lead`, `specialist:<type>`
    or `spec-<type>`, and `orchestrator` (the always-on Orchestration Agent —
    Bead-less, floor-liftable under the `orchestrator` profile)."""
    if role == "lead": return "lead", "lead"
    if role == "orchestrator": return "orchestrator", "orchestrator"
    if role.startswith("specialist:"):
        t = role.split(":", 1)[1]
        if t: return f"specialist:{t}", f"spec-{t}"
    if role.startswith("spec-") and role[5:]:
        return f"specialist:{role[5:]}", role
    raise RuntimeError(
        f"--role must be 'lead', 'specialist:<type>' or 'orchestrator', got {role!r}")
def session_records():
    """Enumerate true session-record files only.

    The per-session effective-settings file is `<name>.settings.json` and is
    itself valid JSON, so a bare `*.json` glob would load it as a bogus record
    (a spurious `unknown` row in `session list`, and it would fool the no-name
    `cleanup` server-kill guard). Skip anything ending in `.settings.json`, and
    belt-and-braces skip any `.json` that does not carry the record shape
    (a `name` and a `bead_id`). `session list`, both `session cleanup`
    variants, and the `session_launch` collision guard all read through here."""
    out = []
    for p in sorted(sessions_dir().glob("*.json")):
        if p.name.endswith(".settings.json"): continue
        try: rec = json.loads(p.read_text())
        except (ValueError, OSError): continue
        # A true record has a `name` and a `bead_id` key (the orchestrator's is
        # null, so test presence, not truthiness) or a `role`. The per-session
        # `<name>.settings.json` is a bare permissions dict — no name, no role,
        # no bead_id — and is still skipped.
        if not (isinstance(rec, dict) and rec.get("name")
                and ("bead_id" in rec or rec.get("role"))): continue
        out.append((p, rec))
    return out
def load_session(name):
    p = sessions_dir() / f"{name}.json"
    if not p.exists(): raise RuntimeError(f"no managed session named {name}")
    return p, json.loads(p.read_text())
def write_session(path, rec):
    rec["updated_at"] = now()
    path.write_text(json.dumps(rec, indent=2, sort_keys=True) + "\n")
def transition(path, rec, state, **extra):
    """Record a lifecycle-state transition durably. `starting`/`running`/`idle`
    are active states; `stopped`/`failed`/`retired` are terminal and carry
    `ended_at` plus an `exit_reason`."""
    rec["state"] = state
    if state in SESSION_TERMINAL_STATES and state != "retired":
        rec.setdefault("ended_at", None)
        rec["ended_at"] = rec.get("ended_at") or now()
        rec["exit_reason"] = extra.pop("exit_reason", None) or rec.get("exit_reason") or state
    for k, v in extra.items(): rec[k] = v
    write_session(path, rec)
    return rec
def bead_exists(bead_id):
    res = run(CFG["beads_command"], "show", bead_id, "--json", check=False)
    if res.returncode != 0: return False
    try: decoded = json.loads(res.stdout.strip() or "[]")
    except ValueError: return False
    records = decoded.get("issues", decoded) if isinstance(decoded, dict) else decoded
    if isinstance(records, dict): records = [records]
    return any(str(issue_id(r)) == str(bead_id) for r in records if isinstance(r, dict))
def bead_change(bead_id):
    """The `openspec:change:` label value on `bead_id`, or None if the Bead
    does not exist or carries no such label. Read-only (`bd show --json`)."""
    res = run(CFG["beads_command"], "show", bead_id, "--json", check=False)
    if res.returncode != 0:
        return None
    try:
        decoded = json.loads(res.stdout.strip() or "[]")
    except ValueError:
        return None
    records = decoded.get("issues", decoded) if isinstance(decoded, dict) else decoded
    if isinstance(records, dict): records = [records]
    if not records:
        return None
    change, _task = mapping(records[0])
    return change
def session_name_in_use(name):
    """A name is in use if the metadata store already has a record or log for
    it, or a tmux session by that name exists on the dedicated server."""
    sdir = sessions_dir()
    return ((sdir / f"{name}.json").exists() or (sdir / f"{name}.log").exists()
            or tmux_has_session(name))
def gen_session_name(role_slug, bead_id):
    """Deterministic shape `sf-<role>-<bead>-<nonce>`; the nonce (UTC timestamp
    plus a short random suffix) is regenerated on any collision with an
    existing managed record, a leftover log, or a live tmux session. Never
    returns a name that is already in use; never reuses or overwrites one."""
    for _ in range(64):
        nonce = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S") + "-" + os.urandom(2).hex()
        name = re.sub(r"[^a-z0-9_.-]", "-", f"sf-{role_slug}-{bead_id}-{nonce}".lower())
        if not session_name_in_use(name):
            return name
    raise RuntimeError("could not generate a collision-free session name; "
                       "no existing session was reused or overwritten")
def resolve_codex_profile(profile, full_access):
    """Resolve a Codex launch level to a `.codex.toml` spec.

    Same name-or-path rules as the Claude resolver, but the directory suffix
    is `.codex.toml` and the default level is `restricted`. A `--profile`
    that points at a `.json` file is a Claude settings file and is rejected
    here, before any session exists — a Codex launch has no `permissions`
    file. A supplied `.toml` path is used directly. The `session_launch_profile`
    config key names a Claude `.json` and does not apply to a Codex launch."""
    value = profile or ("trusted" if full_access else "restricted")
    if Path(value).suffix == ".json":
        raise RuntimeError(
            f"--profile {value!r} is a Claude settings file; --agent codex takes a "
            f"Codex launch spec (a level name or a .codex.toml path), not a permissions JSON")
    return resolve_launch_file(
        value, "session_launch_profile_dir", ".nogging/launch-profiles", ".codex.toml")
def resolve_pi_profile(profile, full_access):
    """Resolve a Pi launch level to a `.pi.toml` spec.

    Same name-or-path rules as the other resolvers, but the directory suffix
    is `.pi.toml` and the default level is `restricted`. A `--profile` that
    points at a Claude settings JSON or a Codex `.codex.toml` spec is rejected
    here, before any session exists — a Pi launch has no `permissions` file
    and no sandbox/approval/network spec. `Path.suffix` only returns the LAST
    suffix, so `foo.codex.toml` and `foo.pi.toml` both report `.toml`; the
    Codex case is therefore checked with a full-suffix `endswith`, not
    `Path.suffix`."""
    value = profile or ("trusted" if full_access else "restricted")
    if Path(value).suffix == ".json":
        raise RuntimeError(
            f"--profile {value!r} is a Claude settings file; --agent pi takes a "
            f"Pi launch spec (a level name or a .pi.toml path), not a permissions JSON")
    if str(value).endswith(".codex.toml"):
        raise RuntimeError(
            f"--profile {value!r} is a Codex launch spec; --agent pi takes a "
            f"Pi launch spec (a level name or a .pi.toml path), not a .codex.toml file")
    return resolve_launch_file(
        value, "session_launch_profile_dir", ".nogging/launch-profiles", ".pi.toml")
def resolved_launch_pair(profile, prompt, full_access, agent="claude"):
    """Resolve the launch selection to concrete files.

    Returns `(profile_path, profile_label, prompt_path)`. `--full-access`
    fills in `trusted` / `autonomous` for whichever flag was not given.
    With no selection the restricted profile and the no-autonomous-claim
    prompt are used; an explicitly configured `session_launch_profile` /
    `session_launch_prompt` key still wins over the directory default.
    The prompt is tool-neutral prose and resolves the same for every agent;
    the profile resolves per agent (`.json` for claude, `.codex.toml` for
    codex). Any resolution failure raises before a session is created."""
    if full_access:
        profile = profile or "trusted"
        prompt = prompt or "autonomous"
    if agent == "codex":
        profile_path, profile_label = resolve_codex_profile(profile, full_access)
    elif agent == "pi":
        profile_path, profile_label = resolve_pi_profile(profile, full_access)
    elif profile is not None:
        profile_path, profile_label = resolve_launch_file(
            profile, "session_launch_profile_dir", ".nogging/launch-profiles", ".json")
    elif "session_launch_profile" in CFG:
        profile_path, profile_label = (ROOT / CFG["session_launch_profile"]).resolve(), "restricted"
    else:
        profile_path, profile_label = resolve_launch_file(
            "restricted", "session_launch_profile_dir", ".nogging/launch-profiles", ".json")
    if prompt is not None:
        prompt_path, _ = resolve_launch_file(
            prompt, "session_launch_prompt_dir", ".nogging/launch-prompts", ".md")
    elif "session_launch_prompt" in CFG:
        prompt_path = (ROOT / CFG["session_launch_prompt"]).resolve()
    else:
        prompt_path, _ = resolve_launch_file(
            "no-autonomous-claim", "session_launch_prompt_dir", ".nogging/launch-prompts", ".md")
    return profile_path, profile_label, prompt_path
def load_profile_settings(path):
    """Read a profile file as JSON and require a `permissions` object. Fails
    loudly rather than starting Claude unconstrained on a malformed file."""
    try:
        data = json.loads(Path(path).read_text())
    except (OSError, ValueError) as exc:
        raise RuntimeError(f"launch profile {path} is not readable JSON: {exc}")
    if not isinstance(data, dict) or not isinstance(data.get("permissions"), dict):
        raise RuntimeError(
            f"launch profile {path} has no 'permissions' object; launch refused")
    return data
CODEX_SANDBOX_MODES = ("read-only", "workspace-write", "danger-full-access")
CODEX_APPROVAL_POLICIES = ("untrusted", "on-request", "never")
def load_codex_spec(path):
    """Read a `.codex.toml` launch fragment: the three flat keys `sandbox`,
    `ask_for_approval`, `network_access`. Deliberately a tiny tolerant reader
    (no `tomllib` dependency, so the bridge still runs on Python < 3.11): one
    `key = value` per line, `#` comments and blanks ignored, values are a
    double-quoted string or a bare `true`/`false`. Fails loudly rather than
    starting Codex on a malformed or under-specified spec."""
    try:
        text = Path(path).read_text()
    except OSError as exc:
        raise RuntimeError(f"Codex launch spec {path} is not readable: {exc}")
    spec = {}
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if "=" not in line:
            raise RuntimeError(f"Codex launch spec {path}: cannot parse line {raw!r}")
        key = line.partition("=")[0].strip()
        value = line.partition("=")[2].strip()
        if len(value) >= 2 and value[0] == value[-1] == '"':
            spec[key] = value[1:-1]
        elif value in ("true", "false"):
            spec[key] = (value == "true")
        else:
            raise RuntimeError(
                f"Codex launch spec {path}: value for {key!r} must be a quoted "
                f"string or true/false, got {value!r}")
    missing = [k for k in ("sandbox", "ask_for_approval", "network_access") if k not in spec]
    if missing:
        raise RuntimeError(f"Codex launch spec {path} is missing key(s): {', '.join(missing)}")
    if spec["sandbox"] not in CODEX_SANDBOX_MODES:
        raise RuntimeError(
            f"Codex launch spec {path}: sandbox {spec['sandbox']!r} not one of {CODEX_SANDBOX_MODES}")
    if spec["ask_for_approval"] not in CODEX_APPROVAL_POLICIES:
        raise RuntimeError(
            f"Codex launch spec {path}: ask_for_approval {spec['ask_for_approval']!r} "
            f"not one of {CODEX_APPROVAL_POLICIES}")
    if not isinstance(spec["network_access"], bool):
        raise RuntimeError(f"Codex launch spec {path}: network_access must be true or false")
    return spec
def load_pi_spec(path):
    """Read a `.pi.toml` launch fragment: two OPTIONAL flat keys, `provider`
    and `model`. Deliberately a tiny tolerant reader (same shape as
    `load_codex_spec`, no `tomllib` dependency): one `key = value` per line,
    `#` comments and blanks ignored, values are a double-quoted string. Unlike
    Codex, Pi's authority floor comes unconditionally from the guard
    extension (`.pi/extensions/nogging-guard.ts`), not from this spec, so
    neither key is required — a file with none of them, or no keys at all, is
    valid and resolves to `{}`. A malformed line still fails loudly."""
    try:
        text = Path(path).read_text()
    except OSError as exc:
        raise RuntimeError(f"Pi launch spec {path} is not readable: {exc}")
    spec = {}
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if "=" not in line:
            raise RuntimeError(f"Pi launch spec {path}: cannot parse line {raw!r}")
        key = line.partition("=")[0].strip()
        value = line.partition("=")[2].strip()
        if len(value) >= 2 and value[0] == value[-1] == '"':
            spec[key] = value[1:-1]
        else:
            raise RuntimeError(
                f"Pi launch spec {path}: value for {key!r} must be a quoted "
                f"string, got {value!r}")
    return spec
def resolve_agent(agent):
    """The agent binary a launch runs: the explicit `--agent` flag wins, then
    the `session_agent` config key, then the historical `claude` default. No
    existing install changes behaviour: the key is absent by default."""
    resolved = agent or scfg("session_agent", "claude")
    if resolved not in ("claude", "codex", "pi"):
        raise RuntimeError(
            f"session_agent {resolved!r} is not a known agent (claude, codex, pi)")
    return resolved
def session_launch(role, bead, cwd, read_only, owner,
                   profile=None, prompt=None, full_access=False, agent=None,
                   resume=None, kickoff=False):
    """Start a supervised agent session for a Bead.

    `resume`, when truthy, is the specific prior Claude conversation's session
    ID to continue via `--resume <id>` — never a bare `--continue`, which
    resumes whichever conversation is most recent for `cwd` and can pick up an
    unrelated one (SPEC-nfz8). Falsy `resume` cold-starts a Claude agent with a
    freshly generated `--session-id`, recorded as `claude_session_id` so a
    later launch can resume this exact conversation.

    This function performs NO Beads mutation. The only `bd` call it makes is
    the read-only `bd show` inside bead_exists(); it never claims, starts, or
    otherwise changes a Bead. Claiming stays a deliberate in-session action
    the operator directs (see .nogging/session-launch-prompt.md)."""
    agent = resolve_agent(agent)
    role_meta, role_slug = normalize_role(role)
    is_orchestrator = role_meta == "orchestrator"
    # The Orchestration Agent is not anchored to a Bead: `--bead` may be omitted
    # for it (and is ignored if passed), recorded as a null `bead_id`. Every
    # other role still requires a real, existing Bead.
    if is_orchestrator:
        bead = None
    elif not bead:
        raise RuntimeError("--bead is required for every role except 'orchestrator'")
    # An execution session (any non-planning role) launched outside a fresh
    # planning session gets openspec/ as a read-only root in its effective
    # authority — tool-agnostically. A planning role, or a launch while a fresh
    # planning lock is held, keeps openspec/ writable.
    openspec_readonly = (
        not role_meta.startswith("planning")
        and fresh_lock("planning", CFG["planning_lock_ttl_seconds"]) is None
    )
    # Resolve and validate the launch profile / prompt before anything about a
    # session exists on disk or in tmux.
    profile_path, profile_label, prompt_path = resolved_launch_pair(
        profile, prompt, full_access, agent)
    # A Claude launch reads a `permissions` JSON; a Codex launch reads a
    # `.codex.toml` sandbox/approval spec; a Pi launch reads an optional
    # `.pi.toml` provider/model spec. All are validated here, before a
    # session exists.
    if is_orchestrator and agent != "claude":
        raise RuntimeError("--role orchestrator is Claude Code only in this version")
    source_settings = load_profile_settings(profile_path) if agent == "claude" else None
    codex_spec = load_codex_spec(profile_path) if agent == "codex" else None
    pi_spec = load_pi_spec(profile_path) if agent == "pi" else None
    # The command-floor / openspec-boundary lift is the orchestrator's alone: the
    # `nogging_floor` / `nogging_openspec_readonly` profile keys are honoured
    # ONLY for --role orchestrator. For every other role they are ignored — the
    # floor is unioned and openspec/ fenced exactly as before — so a lead or
    # specialist session pointed at the `orchestrator` profile still runs floored
    # and openspec/-fenced.
    floor_lifted = False
    if is_orchestrator and isinstance(source_settings, dict):
        floor_lifted = source_settings.get("nogging_floor") is False
        if source_settings.get("nogging_openspec_readonly") is False:
            openspec_readonly = False
    if not is_orchestrator and not bead_exists(bead):
        raise RuntimeError(f"Bead {bead} does not exist; launch refused")
    live = tmux_sessions()
    for _, rec in session_records():
        if is_orchestrator:
            if (rec.get("role") == "orchestrator"
                    and rec.get("state") in SESSION_ACTIVE_STATES and rec.get("name") in live):
                raise RuntimeError(
                    f"a live orchestrator session already exists: {rec['name']} "
                    f"(use `orchestrator run` to adopt it)")
        elif (rec.get("bead_id") == bead and rec.get("role") == role_meta
                and rec.get("state") in SESSION_ACTIVE_STATES and rec.get("name") in live):
            raise RuntimeError(
                f"a live {role_meta} session already covers {bead}: {rec['name']}")
    # The orchestrator is a singleton: a fixed, nonce-free `nogg-orchestrator-<slug>`
    # name (a stale terminal record of the same name is reused in place). Every
    # other role gets the deterministic `sf-<role>-<bead>-<nonce>` shape.
    name = f"nogg-orchestrator-{repo_slug()}" if is_orchestrator else gen_session_name(role_slug, bead)
    workdir = str(Path(cwd or ROOT).resolve())
    sdir = sessions_dir()
    rec_path, log_path = sdir / f"{name}.json", sdir / f"{name}.log"
    if tmux_has_session(name):    # last-line race guard
        raise RuntimeError(f"session {name} already exists; refusing to reuse or overwrite it")
    if rec_path.exists():
        # The singleton orchestrator reuses its fixed name once the prior record
        # is terminal; every other session name is nonce-unique and must not be
        # reused or overwritten.
        prior_terminal = is_orchestrator and (
            json.loads(rec_path.read_text()).get("state") in SESSION_TERMINAL_STATES)
        if not prior_terminal:
            raise RuntimeError(f"session {name} already exists; refusing to reuse or overwrite it")
    wrapper = str((ROOT / "scripts/session-launch").resolve())
    inner = [wrapper, "--prompt", str(prompt_path), "--cwd", workdir]
    if bead:
        inner += ["--bead", bead]
    claude_session_id = None
    if agent == "claude":
        if resume:
            inner += ["--resume", resume]
            claude_session_id = resume
        else:
            claude_session_id = str(uuid.uuid4())
            inner += ["--session-id", claude_session_id]
        if is_orchestrator:
            # The "reachable from a phone" requirement is Remote Control, which
            # `claude` only turns on when asked — it is never automatic. Without
            # this the orchestrator's own docs (docs/operating-model.md:
            # "the launched session registers with Remote Control") were false.
            inner += ["--remote-control", name]
    if agent == "claude":
        # Write the merged, floored settings for THIS session and pass that file
        # to Claude — never the source profile, which is left untouched. The
        # claude wrapper call is byte-for-byte what it was before agent
        # selection existed (no `--agent` argument).
        effective_path = sdir / f"{name}.settings.json"
        # The Nogging-only keys never reach Claude; strip them from the copy.
        base_settings = {k: v for k, v in source_settings.items()
                         if k not in ("//", "nogging_floor", "nogging_openspec_readonly")}
        settings_out = base_settings if floor_lifted else merge_floor(base_settings)
        if openspec_readonly:
            settings_out = deny_openspec_writes(settings_out)
        settings_out = merge_observability_hooks(settings_out)
        effective_path.write_text(json.dumps(settings_out, indent=2) + "\n")
        effective_settings_path = str(effective_path)
        inner[1:1] = ["--settings", effective_settings_path]
    elif agent == "codex":  # no per-session permissions file — the floor is
           # the repo's `.codex/rules/` execpolicy directory, which Codex loads
           # from the working tree. That floor file ships with `codex-onboarding`;
           # warn (do not fail) when it is not present yet.
        floor_file = Path(workdir) / ".codex/rules/nogging.rules"
        if not floor_file.is_file():
            print(f"warning: {floor_file} is absent — the Nogging command floor for "
                  f"Codex is not in place for this session (it ships with the "
                  f"codex-onboarding change). Continuing.", file=sys.stderr)
        effective_settings_path = None
        sandbox = "read-only" if read_only else codex_spec["sandbox"]
        inner[1:1] = ["--agent", "codex", "--sandbox", sandbox,
                      "--approval", codex_spec["ask_for_approval"],
                      "--network", "on" if codex_spec["network_access"] else "off"]
        # Codex has no per-session permissions file, so openspec/ read-only is
        # requested at the wrapper: it maps to codex's readable-root flag where
        # the installed build exposes it on a plain launch, and otherwise falls
        # back to the .codex/rules/ execpolicy deny (codex-onboarding) plus the
        # pre-commit boundary hook. See the wrapper for the runtime check.
        if openspec_readonly:
            inner += ["--readonly-root", str(Path(workdir) / "openspec")]
    else:  # pi: no per-session permissions file and no sandbox/approval/
           # network spec — the floor is the always-on guard extension
           # (`.pi/extensions/nogging-guard.ts`), which reads
           # `.nogging/locks/openspec.readonly` directly at tool-call time.
           # That means, unlike Codex, this branch passes nothing extra for
           # the openspec/ write boundary (openspec_readonly is not consulted
           # here) and never constructs a flag that would disable or bypass
           # the guard for either authority level. That floor file ships with
           # this same change (TASK-PIA-004); warn (do not fail) when it is
           # not present yet.
        floor_file = Path(workdir) / ".pi/extensions/nogging-guard.ts"
        if not floor_file.is_file():
            print(f"warning: {floor_file} is absent — the Nogging command floor for "
                  f"Pi is not in place for this session (it ships with this same "
                  f"pi-agent-support change). Continuing.", file=sys.stderr)
        effective_settings_path = None
        inner += ["--agent", "pi"]
        if "provider" in pi_spec:
            inner += ["--provider", pi_spec["provider"]]
        if "model" in pi_spec:
            inner += ["--model", pi_spec["model"]]
    if read_only: inner.append("--read-only")
    record = {
        "name": name, "bead_id": bead, "role": role_meta, "host": socket.gethostname(),
        "started_at": now(), "working_dir": workdir, "command": redact_argv(inner),
        "owner": owner_identity(owner), "state": "starting", "log_path": str(log_path),
        "read_only": bool(read_only), "ended_at": None, "exit_reason": None,
        "profile": profile_label, "effective_settings_path": effective_settings_path,
        "agent": agent, "openspec_readonly": bool(openspec_readonly),
        "floor_lifted": bool(floor_lifted), "claude_session_id": claude_session_id,
    }
    write_session(rec_path, record)                       # metadata before exec
    with log_path.open("a") as fh:                        # append-only log before exec
        fh.write(f"# nogg session {name} for {bead or 'no bead'} ({role_meta}) started {record['started_at']}\n")
    try:
        # -e NOGG_SESSION_NAME=<name> is agent-neutral session environment
        # (every process tmux starts in this session inherits it), the only
        # way a `session emit` hook invocation — a bare, argument-less
        # command line (design.md Decision 4) — can know its own session name.
        tmux("new-session", "-d", "-s", name, "-c", workdir,
             "-e", f"NOGG_SESSION_NAME={name}", "--", *inner)
        writer = str((ROOT / "scripts/session-log-writer").resolve())
        max_bytes = int(scfg("session_log_max_bytes", 1048576))
        depth = int(scfg("session_log_rotation_depth", 3))
        sink = "exec " + " ".join(shlex.quote(a) for a in
                                  (writer, str(log_path), str(max_bytes), str(depth)))
        tmux("pipe-pane", "-o", "-t", name, sink)
    except ToolError as exc:
        transition(rec_path, record, "failed", exit_reason=f"launch failed: {redact(str(exc))}")
        raise
    transition(rec_path, record, "running")
    print(f"launched {name}")
    print(f"  bead={bead or '-'} role={role_meta} cwd={workdir}")
    print(f"  log={log_path}")
    print(f"  attach: {tmux_bin()} -L {tmux_socket()} attach -t {name}  (or: nogg session attach {name})")
    if (role_meta == "lead" or role_meta.startswith("specialist:")) and not (
            profile or prompt or full_access):
        print(f"⚠ {name} launched in restricted/manual mode — it will not act "
              f"without a human attached to approve each step; pass "
              f"--full-access (or an explicit --profile/--prompt) for "
              f"unattended operation.")
    if kickoff:
        session_kickoff(name)
    else:
        print(f"  kickoff: this session will not act until you send it a first "
              f"message — run `nogg session kickoff {name}` or attach and type "
              f"one yourself.")

def reconciled_state(rec, live):
    """The state to report: an active record whose tmux session has vanished is
    `failed` (a crash), not the stale value on disk."""
    state = rec.get("state", "unknown")
    if state in SESSION_ACTIVE_STATES and rec.get("name") not in live:
        return "failed"
    return state
def session_list():
    """Read every metadata record and print it with live-state reconciliation.
    Read-only: it never attaches, never starts tmux, and never rewrites a
    record. Runs in a bare SSH shell (no TERM, no tmux client)."""
    recs = session_records()
    if not recs:
        print("no managed sessions"); return
    live = tmux_sessions()
    hdr = (f"{'NAME':<40}  {'BEAD':<10}  {'ROLE':<24}  {'STARTED':<20}  "
           f"{'STATE':<8}  {'OWNER':<16}  {'AGENT':<8}  {'PROFILE':<12}  WORKING_DIR")
    print(hdr)
    for _, rec in recs:
        print(f"{rec.get('name',''):<40}  {(rec.get('bead_id') or '-'):<10}  "
              f"{rec.get('role',''):<24}  {rec.get('started_at',''):<20}  "
              f"{reconciled_state(rec, live):<8}  {str(rec.get('owner','')):<16}  "
              f"{_agent_display(rec):<8}  "
              f"{_profile_display(rec):<12}  {rec.get('working_dir','')}")
def _profile_display(rec):
    """`session list` PROFILE cell: a session that actually ran with the command
    floor lifted shows as `FULL-ACCESS` (a distinct token, not a profile name);
    otherwise the restricted default (or an unset record from before this column
    existed) shows as `-`, and anything else shows its name or the basename of
    the supplied path."""
    if rec.get("floor_lifted"):
        return "FULL-ACCESS"
    p = rec.get("profile")
    return p if (p and p != "restricted") else "-"
def _agent_display(rec):
    """`session list` AGENT cell: a record written before this column existed
    has no `agent` key and shows `claude`, the historical default."""
    return rec.get("agent") or "claude"
def _archive_log(rec):
    lp = Path(rec.get("log_path") or "")
    if lp and lp.exists():
        stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S")
        archived = lp.with_name(lp.name + f".archived-{stamp}")
        lp.rename(archived)
        rec["archived_log_path"] = str(archived)
def _remove_effective_settings(rec):
    """Delete the per-session effective-settings file when the record retires.
    The source profile is never touched — only the merged copy this launch
    wrote under the session state directory."""
    esp = rec.get("effective_settings_path")
    if esp and Path(esp).exists():
        Path(esp).unlink()
        rec["effective_settings_removed_at"] = now()
def session_reap():
    """Move every session record in an active state (`starting`/`running`/`idle`)
    whose tmux session no longer exists to the terminal `failed` state, so a
    following `session cleanup` can retire it. A record whose tmux session is
    still live is left untouched. Never starts or kills a tmux session."""
    live = tmux_sessions()
    reaped = []
    for path, rec in session_records():
        if rec.get("state") in SESSION_ACTIVE_STATES and rec.get("name") not in live:
            transition(path, rec, "failed",
                       exit_reason="tmux session vanished during a reap")
            reaped.append(rec.get("name"))
    if reaped:
        print(f"reaped {len(reaped)} vanished session(s): {', '.join(reaped)}")
        print("run `session cleanup` to retire them")
    else:
        print("no vanished active sessions to reap")
    return reaped
def session_cleanup(name, reap=False):
    """Remove a lingering tmux session, archive-rotate its log, and retire the
    metadata record. Refuses any record still `starting`, `running` or `idle`
    - stop it first. With no name, acts only on already-terminal records.
    `--reap` first moves vanished active records to `failed` (see
    `session_reap`), so a single call retires a crashed session."""
    if reap:
        session_reap()
    if name:
        path, rec = load_session(name)
        if rec.get("state") in SESSION_ACTIVE_STATES:
            raise RuntimeError(f"{name} is {rec.get('state')}; run `session stop {name}` first")
        targets = [(path, rec)]
    else:
        targets = [(p, r) for p, r in session_records()
                   if r.get("state") in ("stopped", "failed")]
        if not targets:
            print("no terminal sessions to clean up"); return
    live = tmux_sessions()
    for path, rec in targets:
        nm = rec.get("name")
        if nm in live:
            tmux("kill-session", "-t", nm, check=False)
        _archive_log(rec)
        _remove_effective_settings(rec)
        transition(path, rec, "retired", retired_at=now())
        print(f"retired {nm}")
    if not [r for _, r in session_records() if r.get("state") != "retired"]:
        if tmux_sessions():
            tmux("kill-server", check=False)
            print("no active sessions remain; Nogging tmux server stopped")
def session_stop(name, reason):
    """Interrupt the Claude process, terminate the pane/session after a grace
    period, and record a terminal state. Idempotent: a second stop on an
    already-terminal record is a reported no-op."""
    path, rec = load_session(name)
    if rec.get("state") in SESSION_TERMINAL_STATES:
        print(f"{name} already {rec.get('state')} "
              f"(ended {rec.get('ended_at')}, reason: {rec.get('exit_reason')}); nothing to do")
        return
    grace = float(scfg("session_stop_grace_seconds", 10))
    if tmux_has_session(name):
        tmux("send-keys", "-t", name, "C-c", check=False)      # interrupt Claude
        deadline = time.monotonic() + grace
        while time.monotonic() < deadline and tmux_has_session(name):
            time.sleep(0.2)
        if tmux_has_session(name):
            tmux("kill-session", "-t", name, check=False)      # hard terminate
    transition(path, rec, "stopped", exit_reason=(reason or "stopped by operator"))
    print(f"stopped {name} (reason: {rec['exit_reason']})")
def session_attach(name, read_only):
    """Attach the operator's terminal to a managed tmux session. This is the
    only subcommand that attaches; it is never invoked as a side effect."""
    _, rec = load_session(name)
    if not tmux_has_session(name):
        raise RuntimeError(f"{name} has no live tmux session (state: {rec.get('state')})")
    argv = [tmux_bin(), "-L", tmux_socket(), "attach", "-t", name] + (["-r"] if read_only else [])
    os.execvp(tmux_bin(), argv)
def session_log(name, follow):
    """Print or follow the append-only log. Never attaches to tmux."""
    _, rec = load_session(name)
    lp = Path(rec.get("log_path") or (sessions_dir() / f"{name}.log"))
    if not lp.exists():
        print(f"(no log recorded yet at {lp})"); return
    if follow:
        os.execvp("tail", ["tail", "-n", "+1", "-F", str(lp)])
    sys.stdout.write(lp.read_text())
# --- session observability: watch -------------------------------------
# `watch` polls each tracked session's pane, classifies it per-agent
# (Decision 1), and emits one event per state transition plus `stalled`
# (Decision 3) — never a firehose, never a daemon; it is a foreground
# command run under whatever already supervises the operator.
_DURATION_RE = re.compile(r"^(\d+(?:\.\d+)?)\s*([smh]?)$")
_DURATION_UNITS = {"s": 1, "m": 60, "h": 3600, "": 1}
def parse_duration(spec):
    """Parse a bounded duration like `30`, `30s`, `15m`, `2h` to seconds."""
    m = _DURATION_RE.match(str(spec).strip())
    if not m:
        raise RuntimeError(f"not a duration: {spec!r} (expected e.g. 30, 30s, 15m, 2h)")
    return float(m.group(1)) * _DURATION_UNITS[m.group(2)]
_CLOCK_TIME_RE = re.compile(r"\b(\d{1,2}):(\d{2})\s*([AaPp][Mm])?\b")
def resolve_clock_time(text, now=None):
    """Resolve the first bare `HH:MM` / `H:MM AM/PM` token in `text` to an
    absolute ISO 8601 timestamp against `now`'s local date (design.md
    Decision 2), rolling to the next day when the parsed time precedes
    `now`. Returns None when no time-like token is found or it does not
    resolve to a valid time."""
    m = _CLOCK_TIME_RE.search(text or "")
    if not m:
        return None
    now = now or dt.datetime.now()
    hour, minute, ampm = int(m.group(1)), int(m.group(2)), m.group(3)
    if not (0 <= minute < 60):
        return None
    if ampm:
        if not (1 <= hour <= 12):
            return None
        hour = hour % 12
        if ampm.lower() == "pm":
            hour += 12
    elif not (0 <= hour < 24):
        return None
    candidate = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if candidate < now:
        candidate += dt.timedelta(days=1)
    return candidate.isoformat()
def session_pane_text(name):
    """The session's current visible pane (no scrollback), or '' if its tmux
    session does not exist."""
    res = tmux("capture-pane", "-p", "-t", name, check=False)
    return res.stdout if res.returncode == 0 else ""
def session_events_path(name):
    return sessions_dir() / f"{name}.events.jsonl"
def session_emit(event):
    """Append one structured JSON line to the calling session's own
    `<name>.events.jsonl` (design.md Decision 4). The session name is read
    from `NOGG_SESSION_NAME`, set as session environment by `session_launch`
    for exactly this purpose — a bare `Stop`/`Notification` hook command
    carries no arguments identifying which session it fired in."""
    name = os.environ.get("NOGG_SESSION_NAME")
    if not name:
        raise RuntimeError(
            "session emit: NOGG_SESSION_NAME is not set (not running inside "
            "a session `scripts/nogg session launch` started)")
    with session_events_path(name).open("a") as fh:
        fh.write(json.dumps({"timestamp": now(), "session": name, "event": event}) + "\n")
# A Layer-2 hook event maps onto one of classify()'s Layer-1 states: `Stop`
# fires once Claude finishes a turn (idle, awaiting the next input); the
# `Notification` hook this change wires fires on a permission prompt
# (needs_input). Any other event name (future hook) classifies as `unknown`
# rather than silently reusing a stale state.
EVENT_STATE_MAP = {"turn_end": "idle", "needs_input": "needs_input"}
def _layer2_state(name):
    """The most recent Layer-2 state for a Claude session's events file, or
    None when that file does not exist or has no lines yet — the signal
    `classify_session` uses to fall back to Layer-1 pane-scraping (Decision 4:
    Layer 2 is additive, never required)."""
    path = session_events_path(name)
    if not path.exists() or path.stat().st_size == 0:
        return None
    last_event = None
    with path.open() as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                last_event = json.loads(line).get("event")
            except ValueError:
                continue
    if last_event is None:
        return None
    return EVENT_STATE_MAP.get(last_event, "unknown")
def classify_session(rec, live=None):
    """One-shot state classification for a managed session record: Layer 2
    (the session's own `<name>.events.jsonl`) when present and non-empty for
    a Claude session, else Layer-1 pane-scraping. Returns `(state,
    pane_text)` — `pane_text` is still the real pane capture even on a
    Layer-2 hit, so callers needing it (e.g. a `limit` reset time) are
    unaffected; Layer 2 never reports `limit` so this never matters there."""
    name = rec.get("name")
    live = tmux_sessions() if live is None else live
    if name not in live:
        return "ended", ""
    agent = rec.get("agent") or "claude"
    pane = session_pane_text(name)
    if agent == "claude":
        layer2 = _layer2_state(name)
        if layer2 is not None:
            return layer2, pane
    adapter = ADAPTERS.get(agent)
    if adapter is None:
        return "unknown", ""
    return classify(pane, adapter), pane
def _watch_targets(names):
    if names:
        return list(names)
    live = tmux_sessions()
    return [rec["name"] for _, rec in session_records()
            if reconciled_state(rec, live) in SESSION_ACTIVE_STATES]
def _emit_watch_event(fmt, name, event, **fields):
    if fmt == "jsonl":
        print(json.dumps({"time": now(), "session": name, "event": event, **fields}))
    else:
        extra = " ".join(f"{k}={v}" for k, v in fields.items() if v is not None)
        line = f"{now()} {name} {event}"
        print(f"{line} {extra}" if extra else line)
    sys.stdout.flush()
def watch_poll_once(tracked, stall_secs, fmt):
    """One polling pass over every session in `tracked`, a mutable
    `{name: {"state": str|None, "stalled": bool}}` map the caller carries
    across polls. Emits an event only on a state change, plus one `stalled`
    event (not repeated) when a `working` session's pane and log are both
    unchanged for `stall_secs`. Factored out of `session_watch`'s loop so it
    is testable without a real `sleep`."""
    live = tmux_sessions()
    for name, st in tracked.items():
        try:
            _, rec = load_session(name)
        except RuntimeError:
            continue
        state, pane = classify_session(rec, live)
        prev = st.get("state")
        if state != prev:
            fields = {}
            if state == "limit":
                until = resolve_clock_time(pane)
                if until:
                    fields["until"] = until
            _emit_watch_event(fmt, name, state, **fields)
            st["state"], st["stalled"] = state, False
        elif state == "working" and not st.get("stalled"):
            log_path = Path(rec.get("log_path") or "")
            if log_path.exists() and (time.time() - log_path.stat().st_mtime) >= stall_secs:
                _emit_watch_event(fmt, name, "stalled")
                st["stalled"] = True
def session_watch(names, interval, stall_after, fmt, once=False):
    stall_secs = parse_duration(stall_after)
    tracked = {name: {"state": None, "stalled": False} for name in _watch_targets(names)}
    if not tracked:
        print("no sessions to watch"); return
    try:
        while True:
            if not names:   # re-resolve "every live session" each pass
                for nm in _watch_targets(names):
                    tracked.setdefault(nm, {"state": None, "stalled": False})
            watch_poll_once(tracked, stall_secs, fmt)
            if once:
                return
            time.sleep(interval)
    except KeyboardInterrupt:
        return
# --- session observability: send --------------------------------------
def _submit_pane_input(name, agent):
    tmux("send-keys", "-t", name, "Enter")
    if agent == "claude":
        # Known quirk: Claude Code requires a second bare Enter to actually
        # submit a multi-line paste.
        tmux("send-keys", "-t", name, "Enter")
def pending_input_text(name, agent):
    """The text currently sitting unsubmitted at a session's pane prompt, or
    '' if there is none. Captures the pane (`session_pane_text`, the same
    helper `watch`/`classify` use) and takes its last non-empty line; for a
    Claude session, strips a leading `❯` prompt marker plus any following
    whitespace before treating the remainder as pending text (a bare `❯` or
    blank line yields ''). Shared by `session nudge`, `_pane_input_pending`'s
    Claude branch, and `session sweep`'s `has-unsent-input` check."""
    lines = [ln for ln in session_pane_text(name).splitlines() if ln.strip()]
    if not lines:
        return ""
    last = lines[-1]
    if agent == "claude":
        last = re.sub(r"^❯\s*", "", last)
    return last.strip()
def _pane_input_pending(name, agent):
    """Whether a just-sent message is still sitting unsubmitted. For codex
    this is exactly the adapter's `needs_input` (`undelivered_input`) signal
    (design.md); for claude this is `pending_input_text` returning non-empty
    — a real structural signal, not the previous hardcoded False."""
    if agent == "codex":
        return classify(session_pane_text(name), CODEX_ADAPTER) == "needs_input"
    return bool(pending_input_text(name, agent))
def _require_running(name):
    """Return `(path, rec)` for `name`, refusing with no tmux key-sending
    unless its reconciled state is `running`. Shared by `nudge` and
    `kickoff`, which both must never touch a non-running session's pane."""
    path, rec = load_session(name)
    state = reconciled_state(rec, tmux_sessions())
    if state != "running":
        raise RuntimeError(f"{name} is not running (state: {state}); refusing")
    return path, rec
def _codex_rollout_files():
    """Every rollout file Codex has written under `<codex_home>/sessions/`.
    Each file's first line is a `session_meta` record carrying the thread's
    own id, cwd, and creation timestamp — the only place that mapping
    exists, since a plain `codex` launch has no flag to pin a known thread
    id up front (TASK-SOB-006)."""
    root = codex_home() / "sessions"
    return sorted(root.glob("*/*/*/rollout-*.jsonl")) if root.is_dir() else []
def _codex_rollout_session_meta(path):
    try:
        with path.open() as fh:
            line = json.loads(fh.readline())
    except (OSError, ValueError):
        return None
    if line.get("type") != "session_meta":
        return None
    payload = line.get("payload") or {}
    thread_id, cwd, ts = payload.get("id"), payload.get("cwd"), payload.get("timestamp")
    return (thread_id, cwd, ts) if (thread_id and cwd and ts) else None
def resolve_codex_thread_id(rec):
    """Discover and cache the Codex-internal thread UUID for a codex session
    `scripts/nogg` launched, by matching the session's `working_dir` against
    the `session_meta` header Codex writes at the top of its own rollout file
    (`<codex_home>/sessions/<Y>/<M>/<D>/rollout-*-<uuid>.jsonl`). Codex
    assigns this id itself, lazily, once its own session actually starts
    (there is no cold-start flag to pin it, unlike Claude's `--session-id`),
    so this is a discover-after-the-fact lookup, not something
    `session_launch` can record up front. Among unclaimed same-cwd rollouts
    no older than this session's own `started_at`, picks the earliest — the
    one this launch itself produced. Caches the result on the session record
    once found. Returns None (never raises) when no match exists yet — the
    thread may simply not have started (e.g. still sitting at Codex's
    hook-trust prompt)."""
    if rec.get("codex_thread_id"):
        return rec["codex_thread_id"]
    try:
        started = parse_iso(rec["started_at"]) - dt.timedelta(seconds=5)
    except (KeyError, ValueError):
        return None
    claimed = {r.get("codex_thread_id") for _, r in session_records() if r.get("codex_thread_id")}
    candidates = []
    for path in _codex_rollout_files():
        meta = _codex_rollout_session_meta(path)
        if not meta:
            continue
        thread_id, cwd, ts = meta
        if thread_id in claimed or cwd != rec.get("working_dir"):
            continue
        try:
            ts_dt = parse_iso(ts)
        except ValueError:
            continue
        if ts_dt < started:
            continue
        candidates.append((ts_dt, thread_id))
    if not candidates:
        return None
    candidates.sort()
    thread_id = candidates[0][1]
    rec["codex_thread_id"] = thread_id
    write_session(sessions_dir() / f"{rec['name']}.json", rec)
    return thread_id
def codex_queue_send(rec, message):
    """Primary send path for a codex session: `codex queue --thread <THREAD>
    --message <TEXT>`, against the thread id `resolve_codex_thread_id` finds.
    TASK-SOB-006 confirmed live that this delivers straight into the
    session's pane and submits immediately — no `_submit_pane_input` quirk
    to apply, unlike the Layer-1 path. Returns True if it delivered (the
    caller then skips the Layer-1 pane-based send entirely), False to fall
    back — a thread id not yet resolvable, or the `codex` binary itself
    rejecting it. Never raises."""
    thread_id = resolve_codex_thread_id(rec)
    if not thread_id:
        return False
    result = run("codex", "queue", "--thread", thread_id, "--message", message, check=False)
    return result.returncode == 0
def session_send(name, message, verify=False):
    """Send `message` to a managed session via the agent-appropriate
    key-injection sequence. With `verify`, confirm it was actually submitted
    (not left sitting in the input box) and retry the submit step once if
    not (design.md's `send --verify` requirement)."""
    _, rec = load_session(name)
    if not tmux_has_session(name):
        raise RuntimeError(f"{name} has no live tmux session; cannot send")
    agent = rec.get("agent") or "claude"
    if agent == "codex" and codex_queue_send(rec, message):
        print(f"sent to {name} (codex queue)")
        return
    tmux("send-keys", "-t", name, "-l", message)
    _submit_pane_input(name, agent)
    if verify and _pane_input_pending(name, agent):
        _submit_pane_input(name, agent)             # retry the submit step once
        if _pane_input_pending(name, agent):
            raise RuntimeError(f"{name}: message still unsubmitted after a retry")
    print(f"sent to {name}")
def session_nudge(name, message=None):
    """Reliably submit a session's pane regardless of what was already
    sitting there: clear the input line, then resend. With `message`, always
    clears first and sends that text, overriding whatever the pane showed.
    With no `message`, reads back the pane's pending text *before* clearing
    it and resends exactly that; if there was none, the `C-u` still runs but
    nothing further is sent, and that is reported rather than left silent."""
    _, rec = _require_running(name)
    agent = rec.get("agent") or "claude"
    pending = None if message else pending_input_text(name, agent)
    tmux("send-keys", "-t", name, "C-u")
    text = message or pending
    if not text:
        print(f"{name}: nothing to nudge (pane input was empty)")
        return
    tmux("send-keys", "-t", name, "-l", text)
    _submit_pane_input(name, agent)
    print(f"nudged {name}")
def _compose_kickoff_message(bead_id, change):
    return (f"Claim Bead {bead_id} and work change {change} end to end: "
            f"claim {bead_id}, then work every Bead the {change} change "
            f"scopes in tasks.md order.")
def session_kickoff(name, message=None):
    """Deliver a session's first turn. Refuses, sending nothing, unless the
    session is `running`. With `message`, sends it verbatim via
    `session_send`. With no `message`, composes one from the session's own
    `bead_id` and that Bead's `openspec:change:` label — refusing (sending
    nothing) when either is missing, which excludes `orchestrator` sessions:
    they carry no `bead_id` and are never kicked off this way."""
    _, rec = _require_running(name)
    if message:
        session_send(name, message)
        return
    bead_id = rec.get("bead_id")
    if not bead_id:
        raise RuntimeError(
            f"kickoff: {name} carries no bead_id; pass --message to kick it "
            f"off explicitly (an orchestrator session always needs one)")
    change = bead_change(bead_id)
    if not change:
        raise RuntimeError(
            f"kickoff: Bead {bead_id} carries no openspec:change: label; "
            f"pass --message to kick off {name} explicitly")
    session_send(name, _compose_kickoff_message(bead_id, change))
# --- session observability: resume-when-ready -------------------------
DEFAULT_RESUME_MESSAGE = ("the usage limit has reset, continue exactly where "
                          "you left off per your original instructions")
_SWITCH_MODEL_RE = re.compile(r"switch.*model", re.I)
def session_resume_when_ready(name, message=None, poll_interval=60):
    """Wait out a `limit` state using its resolved reset timestamp (never a
    tight spin-loop — falls back to a bounded `poll_interval` cadence when
    the timestamp could not be parsed), dismiss a residual model-switch
    prompt by keeping the current model (design.md Decision 2: switching
    models never clears a genuine account-wide limit), then send the resume
    instruction via `session_send`."""
    message = message or DEFAULT_RESUME_MESSAGE
    while True:
        _, rec = load_session(name)
        state, pane = classify_session(rec)
        if state != "limit":
            break
        until_iso = resolve_clock_time(pane)
        if until_iso:
            wait = (dt.datetime.fromisoformat(until_iso) - dt.datetime.now()).total_seconds()
            time.sleep(max(0.0, min(wait, poll_interval)) if wait > poll_interval else max(0.0, wait))
        else:
            time.sleep(poll_interval)
    pane = session_pane_text(name)
    if _SWITCH_MODEL_RE.search(pane):
        # Dismiss the residual "switch model?" prompt without acting on it —
        # Escape cancels the prompt and leaves the current model selected.
        tmux("send-keys", "-t", name, "Escape")
    session_send(name, message, verify=True)
    print(f"resumed {name}")
# --- orchestrator: the always-on supervisor ------------------------------
# `orchestrator run` is the idempotent process the systemd user service starts.
# The thing kept alive is a normal supervised Claude session (a durable record,
# an append-only log, listed by `session list`) — not a bespoke daemon. `status`
# / `stop` / `restart` drive the service so the operator does not fight the
# generic `session` commands.
def orchestrator_slug(): return repo_slug()
def orchestrator_session_name(): return f"nogg-orchestrator-{orchestrator_slug()}"
def claude_conversation_transcript_exists(workdir, session_id):
    """True when Claude Code has a stored transcript for this exact
    `session_id` under `workdir`'s project directory — the precise,
    session-scoped check `orchestrator run` uses before trusting a recorded
    `claude_session_id` enough to `--resume` it. A record can carry a
    `claude_session_id` for a conversation that never actually started (e.g.
    the process was killed before Claude wrote anything); resuming a
    nonexistent ID makes `claude` exit immediately, which would crash-loop
    under the systemd unit's `Restart=always`. (SPEC-nfz8: the prior check
    here looked for *any* transcript in the directory, which could resume an
    unrelated conversation instead of catching this.)"""
    d = Path.home() / ".claude" / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(workdir))
    return (d / f"{session_id}.jsonl").is_file()
def orchestrator_unit(): return f"nogg-orchestrator-{orchestrator_slug()}.service"
def claude_project_trusted(workdir):
    """Whether `~/.claude.json` records `hasTrustDialogAccepted` for `workdir`.
    The orchestrator tmux pane is an interactive Claude session, which blocks on
    the workspace-trust dialog for an untrusted directory, so the supervisor
    refuses rather than hang. None when the file is missing or unreadable
    (treated as unknown, not a hard failure)."""
    p = Path.home() / ".claude.json"
    if not p.is_file():
        return None
    try:
        data = json.loads(p.read_text())
    except (ValueError, OSError):
        return None
    entry = (data.get("projects") or {}).get(str(Path(workdir).resolve()))
    return bool(entry.get("hasTrustDialogAccepted")) if isinstance(entry, dict) else None
def _systemctl(*args):
    return run("systemctl", "--user", *args, check=False)
def _linger_on():
    res = run("loginctl", "show-user", getpass.getuser(), "--property=Linger", check=False)
    return res.returncode == 0 and res.stdout.strip().endswith("=yes")
def orchestrator_live_session():
    """`(path, record)` of a live orchestrator session, or None. Live = the
    record's role is `orchestrator`, its tmux session exists, and its
    reconciled state is active."""
    live = tmux_sessions()
    for path, rec in session_records():
        if (rec.get("role") == "orchestrator" and rec.get("name") in live
                and reconciled_state(rec, live) in SESSION_ACTIVE_STATES):
            return path, rec
    return None
def orchestrator_run(force=False):
    """Acquire the lock; adopt a live orchestrator tmux session or start one
    (`claude --resume <id>` of this orchestrator's own last recorded
    conversation when one exists, else a cold start with the persona prompt
    and the floor-lifted settings); refresh the record;
    block until the tmux session exits; release the lock; exit non-zero so
    `Restart=always` brings it back unless `orchestrator stop` disabled the
    unit."""
    def _term(_signum, _frame): raise SystemExit(1)
    signal.signal(signal.SIGTERM, _term)
    name = orchestrator_session_name()
    workdir = str(ROOT)
    set_persona_identity(ROOT, "orchestrator")
    acquire_orchestrator_lock(force)
    try:
        if tmux_has_session(name):
            print(f"orchestrator: adopting the live session {name}")
            rec_path = sessions_dir() / f"{name}.json"
            log_path = sessions_dir() / f"{name}.log"
            if rec_path.exists():
                rec = json.loads(rec_path.read_text())
            else:
                rec = {"name": name, "bead_id": None, "role": "orchestrator",
                       "host": socket.gethostname(), "started_at": now(),
                       "working_dir": workdir, "log_path": str(log_path),
                       "command": [], "profile": "orchestrator", "agent": "claude",
                       "floor_lifted": True, "openspec_readonly": False,
                       "read_only": False, "effective_settings_path": None,
                       "owner": owner_identity(None)}
            rec["ended_at"] = None; rec["exit_reason"] = None
            transition(rec_path, rec, "running", adopted_at=now())
            writer = str((ROOT / "scripts/session-log-writer").resolve())
            sink = "exec " + " ".join(shlex.quote(a) for a in (
                writer, str(log_path), str(int(scfg("session_log_max_bytes", 1048576))),
                str(int(scfg("session_log_rotation_depth", 3)))))
            tmux("pipe-pane", "-o", "-t", name, sink, check=False)
        else:
            session_reap()
            if claude_project_trusted(workdir) is False:
                raise RuntimeError(
                    f"{workdir} is not a trusted Claude workspace — an interactive "
                    f"orchestrator session would hang on the trust dialog. Run `claude` "
                    f"once here and accept the prompt (or set "
                    f"projects['{workdir}'].hasTrustDialogAccepted in ~/.claude.json), "
                    f"then retry.")
            prior_rec_path = sessions_dir() / f"{name}.json"
            prior_session_id = None
            if prior_rec_path.exists():
                try:
                    prior_session_id = json.loads(prior_rec_path.read_text()).get("claude_session_id")
                except (json.JSONDecodeError, OSError):
                    prior_session_id = None
                if prior_session_id and not claude_conversation_transcript_exists(
                        workdir, prior_session_id):
                    prior_session_id = None
            session_launch("orchestrator", None, workdir, False, None,
                           profile="orchestrator", prompt="orchestrator",
                           resume=prior_session_id)
        poll = float(scfg("orchestrator_poll_seconds", 5))
        while tmux_has_session(name):
            time.sleep(poll)
        rec_path = sessions_dir() / f"{name}.json"
        if rec_path.exists():
            rec = json.loads(rec_path.read_text())
            if rec.get("state") in SESSION_ACTIVE_STATES:
                transition(rec_path, rec, "stopped",
                           exit_reason="orchestrator tmux session exited")
        print("orchestrator: session exited")
    finally:
        release_orchestrator_lock()
    sys.exit(1)
def orchestrator_status():
    unit = orchestrator_unit()
    enabled = _systemctl("is-enabled", unit).stdout.strip() or "not-installed"
    active = _systemctl("is-active", unit).stdout.strip() or "unknown"
    print(f"orchestrator unit: {unit}")
    print(f"  enabled: {enabled}")
    print(f"  active:  {active}")
    print(f"  linger:  {'on' if _linger_on() else 'off'}")
    lk = fresh_lock("orchestrator", orchestrator_lock_ttl())
    print(f"  lock:    held by {lk.get('host')} pid {lk.get('pid')} "
          f"(created {lk.get('created_at')})" if lk else "  lock:    free")
    live = orchestrator_live_session()
    if not live:
        print("  session: no live orchestrator session"); return
    _, rec = live
    print(f"  session: {rec.get('name')} FULL-ACCESS "
          f"{reconciled_state(rec, tmux_sessions())} (started {rec.get('started_at')})")
    lp = Path(rec.get("log_path") or "")
    if lp.exists():
        print("  last log lines:")
        for ln in lp.read_text().splitlines()[-15:]:
            print(f"    {ln}")
def orchestrator_stop():
    unit = orchestrator_unit()
    _systemctl("stop", unit)
    _systemctl("disable", unit)
    name = orchestrator_session_name()
    if tmux_has_session(name):
        tmux("send-keys", "-t", name, "C-c", check=False)
        deadline = time.monotonic() + float(scfg("session_stop_grace_seconds", 10))
        while time.monotonic() < deadline and tmux_has_session(name):
            time.sleep(0.2)
        if tmux_has_session(name):
            tmux("kill-session", "-t", name, check=False)
    rec_path = sessions_dir() / f"{name}.json"
    if rec_path.exists():
        rec = json.loads(rec_path.read_text())
        if rec.get("state") in SESSION_ACTIVE_STATES:
            transition(rec_path, rec, "stopped", exit_reason="stopped by operator")
    release_orchestrator_lock()
    print(f"orchestrator: stopped and disabled ({unit})")
def orchestrator_restart():
    unit = orchestrator_unit()
    res = _systemctl("restart", unit)
    if res.returncode:
        raise RuntimeError(f"systemctl --user restart {unit} failed: "
                           f"{res.stderr.strip() or res.stdout.strip()}")
    print(f"orchestrator: restarted ({unit})")
def orchestrator_cmd(args):
    if args.orchestrator_command == "run": orchestrator_run(args.force)
    elif args.orchestrator_command == "status": orchestrator_status()
    elif args.orchestrator_command == "stop": orchestrator_stop()
    elif args.orchestrator_command == "restart": orchestrator_restart()
def recover_base_branch():
    """The branch a run's LIMBO / commits-since-fork scan is measured against.
    `recover_base_branch` config key wins; otherwise the first protected branch
    (`sync_protected_branches[0]`, i.e. `main`), never a hardcoded `develop`."""
    key = CFG.get("recover_base_branch")
    if key:
        return key
    protected = CFG.get("sync_protected_branches") or []
    return protected[0] if protected else "main"
def resolve_ref(name):
    """`name` if it resolves in this repo, else `origin/<name>` if that does,
    else None (a detached-HEAD / no-base checkout must not crash `recover`)."""
    if not name:
        return None
    for cand in (name, f"origin/{name}"):
        if run("git", "rev-parse", "--verify", "--quiet", f"{cand}^{{commit}}",
               check=False).returncode == 0:
            return cand
    return None
def commit_tokens_with_subject(rev_range=None):
    """`[<id>]` token -> (newest sha, subject) over non-merge commits, optionally
    restricted to a `<base>..HEAD` range. Empty when this is not a git repo or
    the range will not resolve."""
    args = ["git", "log", "--no-merges", "--format=%H%x1f%s"]
    if rev_range:
        args.append(rev_range)
    res = run(*args, check=False)
    if res.returncode:
        return {}
    out = {}
    for line in res.stdout.splitlines():
        h, _, subject = line.partition("\x1f")
        for token in LIMBO_TOKEN_RE.findall(subject):
            out.setdefault(token, (h, subject))
    return out
MATERIALIZE_JOURNAL_RE = re.compile(r"^materialize-(.+)\.json$")
def materialize_journals():
    """Every leftover `.nogging/state/materialize-<change>.json` journal
    (written by `materialize()`, deleted on clean completion) as
    `{change: parsed-json}`. A crash between `bd create` calls leaves one; its
    `tasks_planned` minus `tasks_created` is exactly what still needs a Bead."""
    out = {}
    if not STATE.is_dir():
        return out
    for p in sorted(STATE.glob("materialize-*.json")):
        m = MATERIALIZE_JOURNAL_RE.match(p.name)
        if not m:
            continue
        try:
            out[m.group(1)] = json.loads(p.read_text())
        except (ValueError, OSError):
            out[m.group(1)] = {}
    return out
def recover_scan():
    """Run the interrupted-run checks (handoff §5.1) and return
    `(sections, attention)` — `sections` a list of `(title, [lines])` with the
    empty ones dropped, `attention` the human-readable reasons a resume needs a
    decision. Strictly read-only: mutates no Bead and writes no file. Shared by
    `recover` (full report + exit code) and `doctor` (summary line)."""
    attention = []          # human-readable reasons for a non-zero exit
    sections = []
    def section(title, body_lines):
        if body_lines:
            sections.append((title, list(body_lines)))

    host = socket.gethostname()
    now_dt = dt.datetime.now(dt.timezone.utc)

    # --- Locks ------------------------------------------------------------
    lock_lines = []
    for name, ttl in (("planning", CFG.get("planning_lock_ttl_seconds", 7200)),
                      ("sync", CFG.get("sync_lock_ttl_seconds", 120)),
                      ("orchestrator", orchestrator_lock_ttl())):
        path = LOCKS / f"{name}.lock"
        if not path.exists():
            continue
        try:
            info = json.loads(path.read_text())
            then = dt.datetime.fromisoformat(info["created_at"])
        except (ValueError, OSError, KeyError):
            lock_lines.append(f"{name}.lock: present but unreadable")
            attention.append(f"{name}.lock unreadable")
            continue
        age = int((now_dt - then).total_seconds())
        fresh = age < ttl
        pid, lhost = info.get("pid"), info.get("host")
        if lhost != host:
            liveness = f"pid {pid} on {lhost} (not this host)"
        elif isinstance(pid, int) and pid_alive(pid):
            liveness = f"pid {pid} alive"
        else:
            liveness = f"pid {pid} dead"
        state = "held (fresh)" if fresh else "STALE"
        lock_lines.append(f"{name}.lock: {state}, age {age}s / ttl {ttl}s, {liveness}")
        if not fresh:
            attention.append(f"stale {name}.lock")
    section("Locks", lock_lines)

    issues = beads()
    by_id = {str(issue_id(i)): i for i in issues}

    # --- LIMBO: committed but not closed --------------------------------
    base_name = recover_base_branch()
    base_ref = resolve_ref(base_name)
    rng = f"{base_ref}..HEAD" if base_ref else None
    limbo_lines = []
    if base_ref is None:
        limbo_lines.append(f"(base {base_name!r} does not resolve — scanning full HEAD history)")
    for token, (sha, subject) in sorted(commit_tokens_with_subject(rng).items()):
        iss = by_id.get(token)
        if iss is None:
            continue
        status = iss.get("status") or "unknown"
        if status != "closed":
            limbo_lines.append(f'LIMBO: {token} committed in {sha[:12]} "{subject}" but status={status}')
            attention.append(f"LIMBO {token}")
    section("Committed but not closed", limbo_lines)

    # --- in_progress Beads --------------------------------------------
    head_tokens = branch_commit_tokens()
    stale_secs = int(CFG.get("claim_stale_seconds", 14400))
    ip_lines = []
    for iss in issues:
        if iss.get("status") != "in_progress":
            continue
        bid = str(issue_id(iss) or "")
        _, task = mapping(iss)
        updated = iss.get("updated_at")
        try:
            age_s = int((now_dt - parse_iso(updated)).total_seconds())
        except (ValueError, TypeError, AttributeError):
            age_s = None
        if bid in head_tokens:
            # A commit carries its token but the Bead is not closed — the same
            # committed-but-open case as LIMBO, so it needs a decision.
            cls = "resumable"
            attention.append(f"resumable {bid}")
        elif age_s is not None and age_s >= stale_secs:
            # Claimed long ago (`claim_stale_seconds`) with no commit — reported
            # for a human's attention but not an exit-code trigger on its own.
            cls = "stale"
        else:
            cls = "active"
        age_str = humanize_age(updated) if updated else "age unknown"
        ip_lines.append(f"{bid} [{cls}] task={task or '-'} "
                        f"assignee={iss.get('assignee') or '-'} updated {age_str} ago")
    section("Claimed (in_progress) Beads", ip_lines)

    # --- Materialized but uncommitted --------------------------------
    mu_lines = []
    journals = materialize_journals()
    live_change_names = {c.name for c in changes()}
    mapped_by_change = {}
    for iss in issues:
        ch, _ = mapping(iss)
        if ch:
            mapped_by_change.setdefault(ch, []).append(str(issue_id(iss)))
    for change in changes():
        name = change.name
        mapped = mapped_by_change.get(name) or []
        if not mapped:
            continue
        rel = f"openspec/changes/{name}"
        dirty = bool(run("git", "status", "--porcelain", "--", f"{rel}/tasks.md",
                         check=False).stdout.strip())
        in_log = bool(run("git", "log", "-1", "--format=%H", "--", rel,
                          check=False).stdout.strip())
        if dirty or not in_log:
            why = "tasks.md has uncommitted changes" if dirty else "change dir absent from git log"
            mu_lines.append(f"{name}: {why} but has {len(mapped)} mapped Bead(s)")
            attention.append(f"materialized-but-uncommitted {name}")
    for change, journal in journals.items():
        planned = list(journal.get("tasks_planned") or [])
        created = set(journal.get("tasks_created") or [])
        missing = [t for t in planned if t not in created]
        note = f"journal materialize-{change}.json present"
        if missing:
            note += f" — still needs a Bead: {', '.join(missing)}"
        elif planned:
            note += " — every planned task has a Bead (journal not cleaned up)"
        mu_lines.append(note)
        attention.append(f"materialize journal for {change}")
    section("Materialized but uncommitted", mu_lines)

    # --- Orphan Beads ------------------------------------------------
    orphan_lines = []
    try:
        _, _, problems, _ = validate(fallback_ref=resolve_ref("develop"))
    except Exception as exc:
        problems = [f"validate() failed: {exc}"]
    for p in problems:
        if "maps missing task" in p or "change label disagrees" in p or "incomplete OpenSpec labels" in p:
            orphan_lines.append(p)
            attention.append("orphan Bead")
    section("Orphan Beads", orphan_lines)

    # --- Durable worktree records -------------------------------------
    worktree_lines, worktree_attention = recorded_worktree_lines()
    attention.extend(worktree_attention)
    section("Worktrees", worktree_lines)

    # --- Crashed sessions -----------------------------------------
    crashed_lines = []
    sdir = ROOT / scfg("session_state_dir", ".nogging/state/sessions")
    if sdir.is_dir():
        live = tmux_sessions()
        for _, rec in session_records():
            if rec.get("state") in SESSION_ACTIVE_STATES and rec.get("name") not in live:
                crashed_lines.append(f"{rec.get('name')} (bead {rec.get('bead_id')}, "
                                     f"role {rec.get('role')}): record {rec.get('state')} "
                                     f"but tmux session gone")
                attention.append("crashed session")
    section("Crashed sessions", crashed_lines)

    # --- Working tree / mid-operation -----------------------------
    wt_lines = []
    porcelain = run("git", "status", "--porcelain", check=False).stdout.strip().splitlines()
    if porcelain:
        wt_lines.append(f"{len(porcelain)} path(s) with uncommitted changes")
    gd = git_dir()
    if gd is not None:
        for marker, reason in MIDOP_MARKERS:
            if (gd / marker).exists():
                wt_lines.append(f"{reason} — finish or abort it before resuming")
    section("Working tree", wt_lines)

    # --- Last sync ----------------------------------------------
    ls_lines = []
    last = read_last_success()
    if last.get("at"):
        ls_lines.append(f"last successful sync {humanize_age(last['at'])} ago"
                        + (f" on {last['branch']}" if last.get("branch") else ""))
    if FAILURE_RECORD.exists():
        try:
            frec = json.loads(FAILURE_RECORD.read_text())
        except (ValueError, OSError):
            frec = {}
        if frec:
            ls_lines.append(f"active sync failure ({frec.get('classification')}): "
                            f"attempt {frec.get('attempts')}/{frec.get('max_attempts')}")
    if SKIP_RECORD.exists():
        try:
            srec = json.loads(SKIP_RECORD.read_text())
        except (ValueError, OSError):
            srec = {}
        if srec.get("reason"):
            ls_lines.append(f"last tick skipped: {srec['reason']} ({humanize_age(srec.get('at'))})")
    section("Last sync", ls_lines)

    return sections, attention
def recover():
    """The interrupted-run diagnostic. Prints every non-empty section and exits
    non-zero when any committed-but-open Bead, stale lock, orphan Bead,
    materialized-but-uncommitted change, or crashed session record is present."""
    sections, attention = recover_scan()
    for title, lines in sections:
        print(f"== {title} ==")
        for ln in lines:
            print(f"  {ln}")
        print()
    if attention:
        print(f"recover: {len(attention)} item(s) need attention: {', '.join(attention)}")
        sys.exit(1)
    print("recover: nothing in flight — clear to select work with bd ready")
def tool_on_path(name):
    return shutil.which(name) is not None
def doctor(audit=False, with_recover=False):
    # A fresh install starts with the OpenSpec write boundary closed. Bootstrap
    # the sentinel once, only when nothing has toggled the boundary yet (no
    # sentinel and no planning lock). An install whose repo has core.hooksPath
    # set skips scripts/install-hooks, so doctor is the other creation point the
    # spec names. Idempotent; never disturbs a live planning session.
    if not SENTINEL.exists() and not (LOCKS / "planning.lock").exists():
        write_sentinel(by="doctor")
    checks = []
    for cmd in ("git", "python3", CFG["beads_command"], "dolt"):
        checks.append((cmd, tool_on_path(cmd)))
    warnings = []
    tasks, issues = {}, []
    try: tasks, issues, problems, warnings = validate()
    except Exception as exc: problems = [str(exc)]
    checks.extend((p, False) for p in problems)
    if FAILURE_RECORD.exists():
        try: rec = json.loads(FAILURE_RECORD.read_text())
        except (ValueError, OSError): rec = {}
        if rec:
            retry = rec.get("next_retry_after") or "none (not retried automatically)"
            checks.append((f"last sync failed ({rec.get('classification')}): "
                           f"attempt {rec.get('attempts')}/{rec.get('max_attempts')}, "
                           f"next retry {retry} — {str(rec.get('error', '')).splitlines()[0]}", False))
    for name, ok in checks: print(f"{'OK' if ok else 'FAIL'}  {name}")
    # Warnings are advisory (a committed-but-open Bead and the like): shown
    # distinctly from FAIL, and they never change doctor's exit code.
    for w in warnings: print(f"WARN  {w}")
    # Optional tools: reported as a note, never a checked failure — a missing
    # one does not redden `doctor` or change its exit code.
    notes = [boundary_state_line(),
             "compatibility baseline: Node 18/20/22, Python 3.9-3.13, "
             "Git 2.30+, Bash 4.4+, OpenSpec 1.11.x, Beads 1.2.x, Dolt 2.3.x "
             "(docs/nogging/compatibility.md)"]
    # Advisory only, like every other NOTE here: never a FAIL, never changes
    # doctor's exit code. `/plan`'s archive step (TASK-TCC-004) is what
    # actually archives a change; doctor only surfaces readiness.
    for change in archive_ready_changes(tasks, issues):
        notes.append(f"change ready to archive: {change} (every mapped Bead is closed)")
    if SKIP_RECORD.exists():
        try: srec = json.loads(SKIP_RECORD.read_text())
        except (ValueError, OSError): srec = {}
        if srec.get("reason"):
            notes.append(f"last sync skipped: {srec['reason']} "
                         f"({humanize_age(srec.get('at'))})")
    # multi_machine is opt-in (default false): never checked, never a FAIL,
    # never changes the exit code — just visibility into an unpushed local
    # Dolt history per design.md Decision 2.
    if multi_machine_enabled():
        ahead = dolt_ahead_of_remote()
        if ahead:
            notes.append(f"multi-machine: local Dolt is {ahead} commit(s) "
                         f"ahead of its remote — run `bd dolt push` before ending this session")
    codex_present = tool_on_path("codex")
    notes.append("codex available" if codex_present
                 else "codex not installed; only needed for the Codex agent path")
    # Informational nudge (never a failure): the repo ships Codex prompts but at
    # least one is not linked into the dir Codex 0.148 actually reads.
    if codex_present:
        prompt_plan = codex_prompt_link_plan()
        if prompt_plan and any(state != "linked" for _, _, state in prompt_plan):
            notes.append(f"codex prompts present in .codex/prompts/ but not linked into "
                         f"{codex_home() / 'prompts'}/ "
                         f"(run: ./scripts/nogg codex-prompts-link)")
    pi_present = tool_on_path("pi")
    notes.append("pi available" if pi_present
                 else "pi not installed; only needed for the Pi agent path")
    # Informational nudge (never a failure): the repo ships a Pi guard
    # extension, but Pi won't load it until the project has standing trust.
    if pi_present:
        guard_file = ROOT / ".pi/extensions/nogging-guard.ts"
        if guard_file.is_file() and pi_project_trusted(ROOT) is not True:
            notes.append(
                "pi is present but this project is not yet trusted for .pi/extensions/ "
                "(the Nogging guard extension won't load) - run once with `pi --approve` "
                "or use pi's `/trust` command to grant standing trust")
    # The always-on Orchestration Agent: report the service state, linger, and
    # whether a FULL-ACCESS orchestrator session is live. Its absence or
    # inactivity is never a failure (it is opt-in, like the Codex/Pi paths);
    # only a service that is enabled while user lingering is off rates a NOTE.
    orch_unit = orchestrator_unit()
    if tool_on_path("systemctl"):
        enabled = _systemctl("is-enabled", orch_unit).stdout.strip()
        active = _systemctl("is-active", orch_unit).stdout.strip() or "inactive"
        linger = _linger_on()
        live = orchestrator_live_session() is not None
        if enabled in ("", "not-found"):
            notes.append(f"orchestrator service {orch_unit} not installed "
                         f"(optional — run the printed `systemctl --user enable --now` line to use it)")
        else:
            notes.append(f"orchestrator service {orch_unit}: {enabled}, {active}; "
                         f"linger {'on' if linger else 'off'}; "
                         f"{'a FULL-ACCESS session is live' if live else 'no live session'}")
            if enabled == "enabled" and not linger:
                notes.append("orchestrator service is enabled but user lingering is off — "
                             "it will not start at boot without a login; run "
                             f"`loginctl enable-linger {getpass.getuser()}`")
    else:
        notes.append("systemctl not available; orchestrator service state not checked")
    # Cloud session visibility: informational only, like every other
    # environment-presence check above — never a FAIL, never changes the exit
    # code, and silent outside a cloud session (CLAUDE_CODE_REMOTE unset).
    if os.environ.get("CLAUDE_CODE_REMOTE") == "true":
        hooks_path = run("git", "config", "--get", "core.hooksPath", check=False).stdout.strip()
        notes.append(f"cloud session: core.hooksPath is {hooks_path!r}" if hooks_path
                     else "cloud session: core.hooksPath is not set")
        notes.append("cloud session: bd is on PATH" if tool_on_path(CFG["beads_command"])
                     else "cloud session: bd is not on PATH")
    # The interrupted-run checks: doctor always prints a one-line summary
    # (`recover` folds the full report). Read-only, like the rest of doctor.
    try:
        rsections, rattention = recover_scan()
    except Exception as exc:
        rsections, rattention = [], []
        notes.append(f"recover checks could not run: {exc}")
    notes.append(f"recover: {len(rattention)} item(s) need attention"
                 + (f" — {', '.join(rattention)}" if rattention else " (nothing in flight)"))
    notes.extend(persona_mismatch_notes())
    notes.extend(launch_profile_notes())
    for note in notes: print(f"NOTE  {note}")
    recover_lines = []
    if with_recover:
        for title, lines in rsections:
            recover_lines.append(f"RECOVER  {title}")
            recover_lines.extend(f"RECOVER    {ln}" for ln in lines)
        for ln in recover_lines: print(ln)
    # Informational only: never a checked failure, never changes the exit code.
    infos = stale_codex_rule_lines()
    for info in infos: print(f"INFO  {info}")
    if audit:
        report = data_dir(REPORTS) / f"audit-{dt.datetime.now():%Y%m%dT%H%M%S}.txt"
        report.write_text("\n".join(
            [f"{'OK' if ok else 'FAIL'}  {name}" for name, ok in checks]
            + [f"WARN  {w}" for w in warnings]
            + [f"NOTE  {note}" for note in notes]
            + recover_lines
            + [f"INFO  {info}" for info in infos]) + "\n")
        print(f"report: {report.relative_to(ROOT)}")
    # `doctor` keeps its tool-availability exit semantics; `doctor --recover`
    # additionally fails when the interrupted-run checks flag anything.
    if any(not ok for _, ok in checks) or (with_recover and rattention): sys.exit(1)
def main():
    p = argparse.ArgumentParser(); sub = p.add_subparsers(dest="command", required=True)
    sub.add_parser("validate")
    dp = sub.add_parser("doctor")
    dp.add_argument("--recover", action="store_true",
                    help="also run the interrupted-run checks and fail if any need attention")
    sub.add_parser("audit"); sub.add_parser("recover")
    sy = sub.add_parser("sync"); sy.add_argument("--now", action="store_true",
        help="on-demand: signal a running sync daemon, else run one pass; report sync-lock contention without retrying")
    d = sub.add_parser("discoveries"); d.add_argument("--ack", nargs="+", metavar="BEAD_ID",
        help="record a planning-session acknowledgement for the given discovery Beads")
    b = sub.add_parser("plan-begin"); b.add_argument("--force", action="store_true")
    e = sub.add_parser("plan-end"); e.add_argument("--force", action="store_true")
    m = sub.add_parser("materialize"); m.add_argument("change")
    td = sub.add_parser("task-done",
        help="tick the closed Bead's mapped tasks.md line (Lead close protocol)")
    td.add_argument("bead_id")
    cpl = sub.add_parser("codex-prompts-link",
        help="symlink .codex/prompts/*.md into <CODEX_HOME>/prompts/ as nogging-<name>.md")
    cpl.add_argument("--unlink", action="store_true",
        help="remove only the nogging-* prompt symlinks this command created")
    wt = sub.add_parser("worktree", help="allocate and safely manage isolated agent worktrees")
    wtsub = wt.add_subparsers(dest="worktree_command", required=True)
    wtp = wtsub.add_parser("plan", help="allocate a planning worktree from updated origin/develop")
    wtp.add_argument("planning_id")
    wtp.add_argument("description")
    wtp.add_argument("--path", help="explicit empty destination path (defaults beside the shared checkout)")
    wti = wtsub.add_parser("implement", help="allocate an implementation worktree for an already claimed Bead")
    wti.add_argument("bead_id")
    wti.add_argument("branch")
    wti.add_argument("--path", help="explicit empty destination path (defaults beside the shared checkout)")
    wtc = wtsub.add_parser("cleanup", help="retire one clean, develop-integrated recorded worktree")
    wtc.add_argument("record", help="record filename under .nogging/state/worktrees/")
    pr = sub.add_parser("pr", help="create or locate an implementation pull request")
    prsub = pr.add_subparsers(dest="pr_command", required=True)
    pro = prsub.add_parser("open", help="create or locate an open PR targeting develop")
    pro.add_argument("--plan", required=True); pro.add_argument("--task", action="append", default=[])
    pro.add_argument("--decision", action="append", default=[]); pro.add_argument("--validation", action="append", default=[])
    pro.add_argument("--limitation", action="append", default=[])
    prsub.add_parser("ci", help="inspect required PR checks after the durable initial wait")
    orc = sub.add_parser("orchestrator")
    orcsub = orc.add_subparsers(dest="orchestrator_command", required=True)
    orun = orcsub.add_parser("run")
    orun.add_argument("--force", action="store_true",
                      help="reclaim a stale orchestrator lock (verify it is stale first)")
    orcsub.add_parser("status")
    orcsub.add_parser("stop")
    orcsub.add_parser("restart")
    s = sub.add_parser("session"); ssub = s.add_subparsers(dest="session_command", required=True)
    sl = ssub.add_parser("launch")
    sl.add_argument("--role", required=True)
    sl.add_argument("--bead", help="mapped Bead ID; required for every role except 'orchestrator'")
    sl.add_argument("--cwd"); sl.add_argument("--read-only", action="store_true")
    sl.add_argument("--owner")
    sl.add_argument("--agent", choices=("claude", "codex", "pi"),
                    help="agent binary to launch; defaults to the session_agent config key, "
                         "then 'claude'")
    sl.add_argument("--profile", help="named launch profile or a path to a settings JSON file")
    sl.add_argument("--prompt", help="named launch prompt or a path to a system-prompt file")
    sl.add_argument("--full-access", action="store_true",
                    help="shorthand for --profile trusted --prompt autonomous")
    sl.add_argument("--kickoff", action="store_true",
                    help="send the session its first message immediately after launch")
    ssub.add_parser("list")
    sa = ssub.add_parser("attach"); sa.add_argument("name"); sa.add_argument("--read-only", action="store_true")
    slg = ssub.add_parser("log"); slg.add_argument("name"); slg.add_argument("--follow", action="store_true")
    sst = ssub.add_parser("stop"); sst.add_argument("name"); sst.add_argument("--reason")
    ssub.add_parser("reap")
    scl = ssub.add_parser("cleanup"); scl.add_argument("name", nargs="?")
    scl.add_argument("--reap", action="store_true",
                     help="first move vanished active sessions to failed, then clean up")
    sw = ssub.add_parser("watch")
    sw.add_argument("names", nargs="*", default=[])
    sw.add_argument("--all-running", action="store_true",
                    help="watch every live session (the default when no names are given)")
    sw.add_argument("--interval", type=float, default=30)
    sw.add_argument("--stall-after", default="15m")
    sw.add_argument("--format", choices=("lines", "jsonl"), default="lines")
    sw.add_argument("--once", action="store_true",
                    help="run exactly one polling pass then exit (scripting/testing)")
    ssend = ssub.add_parser("send")
    ssend.add_argument("name"); ssend.add_argument("message")
    ssend.add_argument("--verify", action="store_true")
    snud = ssub.add_parser("nudge")
    snud.add_argument("name"); snud.add_argument("--message")
    skick = ssub.add_parser("kickoff")
    skick.add_argument("name"); skick.add_argument("--message")
    srw = ssub.add_parser("resume-when-ready")
    srw.add_argument("name"); srw.add_argument("--message")
    semit = ssub.add_parser("emit")
    semit.add_argument("event")
    args = p.parse_args()
    if args.command == "plan-begin":
        lock("planning", CFG["planning_lock_ttl_seconds"], args.force)
        remove_sentinel()
        print("planning session lock acquired")
        print("openspec write boundary open")
    elif args.command == "plan-end":
        path = LOCKS / "planning.lock"
        if path.exists():
            path.unlink(); print("planning session lock released")
        elif not args.force:
            raise RuntimeError("no planning lock (use --force to close the boundary anyway)")
        else:
            print("no planning lock (--force): closing the boundary anyway")
        write_sentinel()
        print("openspec write boundary closed")
    elif args.command == "materialize": materialize(args.change)
    elif args.command == "task-done": task_done(args.bead_id)
    elif args.command == "codex-prompts-link": codex_prompts_link(args.unlink)
    elif args.command == "worktree":
        if args.worktree_command == "plan": planning_worktree(args.planning_id, args.description, args.path)
        elif args.worktree_command == "implement": implementation_worktree(args.bead_id, args.branch, args.path)
        elif args.worktree_command == "cleanup": cleanup_worktree(args.record)
    elif args.command == "pr":
        if args.pr_command == "open": pull_request(args.plan, args.task, args.decision, args.validation, args.limitation)
        elif args.pr_command == "ci": pull_request_ci()
    elif args.command == "recover": recover()
    elif args.command == "sync": sync_now() if args.now else sync()
    elif args.command == "discoveries": ack_discoveries(args.ack) if args.ack else discoveries()
    elif args.command == "session": session_cmd(args)
    elif args.command == "orchestrator": orchestrator_cmd(args)
    else: doctor(args.command == "audit", getattr(args, "recover", False))
def session_cmd(args):
    if args.session_command == "launch":
        session_launch(args.role, args.bead, args.cwd, args.read_only, args.owner,
                       args.profile, args.prompt, args.full_access, args.agent,
                       kickoff=args.kickoff)
    elif args.session_command == "list":
        session_list()
    elif args.session_command == "attach":
        session_attach(args.name, args.read_only)
    elif args.session_command == "log":
        session_log(args.name, args.follow)
    elif args.session_command == "stop":
        session_stop(args.name, args.reason)
    elif args.session_command == "reap":
        session_reap()
    elif args.session_command == "cleanup":
        session_cleanup(args.name, args.reap)
    elif args.session_command == "watch":
        if args.names and args.all_running:
            raise RuntimeError("session watch: pass session names or --all-running, not both")
        session_watch(args.names, args.interval, args.stall_after, args.format, args.once)
    elif args.session_command == "send":
        session_send(args.name, args.message, args.verify)
    elif args.session_command == "nudge":
        session_nudge(args.name, args.message)
    elif args.session_command == "kickoff":
        session_kickoff(args.name, args.message)
    elif args.session_command == "resume-when-ready":
        session_resume_when_ready(args.name, args.message)
    elif args.session_command == "emit":
        session_emit(args.event)
if __name__ == "__main__":
    try: main()
    except Exception as exc: print(f"nogg: {exc}", file=sys.stderr); sys.exit(1)
