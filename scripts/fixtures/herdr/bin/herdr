#!/usr/bin/env python3
"""Stateful fake herdr CLI for Nogging test suites ($HERDR_STUB_DIR).

Reproduces spike-verified CLI forms and JSON for:
- pane create / list / get / process_info / send / read / close / rename
- workspace create / list / close
- agent get / list / explain
- version and reachability (status running/not running, ping)
- simulated server restart
- injectable failures
- call log ($HERDR_STUB_DIR/calls.log)
"""

import json
import os
import sys

SPIKE_DIR = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "spike"))


def get_stub_dir():
    d = os.environ.get("HERDR_STUB_DIR")
    if not d:
        d = f"/tmp/herdr-stub-{os.getuid()}"
    os.makedirs(d, exist_ok=True)
    return d


def log_call(stub_dir, argv):
    call_log = os.path.join(stub_dir, "calls.log")
    try:
        with open(call_log, "a", encoding="utf-8") as f:
            f.write(" ".join(argv) + "\n")
    except OSError:
        pass


def check_injected_failures(stub_dir, cmd_key=""):
    # 1. fail_once
    fail_once = os.path.join(stub_dir, "fail_once")
    if os.path.exists(fail_once):
        try:
            with open(fail_once, "r", encoding="utf-8") as f:
                content = f.read().strip()
            os.remove(fail_once)
        except OSError:
            content = ""
        emit_failure_and_exit(content)

    # 2. General fail
    fail_file = os.path.join(stub_dir, "fail")
    if os.path.exists(fail_file):
        try:
            with open(fail_file, "r", encoding="utf-8") as f:
                content = f.read().strip()
        except OSError:
            content = ""
        emit_failure_and_exit(content)

    # 3. Subcommand fail
    if cmd_key:
        cmd_fail_file = os.path.join(stub_dir, f"fail_{cmd_key}")
        if os.path.exists(cmd_fail_file):
            try:
                with open(cmd_fail_file, "r", encoding="utf-8") as f:
                    content = f.read().strip()
            except OSError:
                content = ""
            emit_failure_and_exit(content)


def emit_failure_and_exit(content):
    code = 1
    msg = None
    if content:
        lines = content.splitlines()
        first_line = lines[0].strip()
        if first_line.isdigit():
            code = int(first_line)
            msg = "\n".join(lines[1:]) if len(lines) > 1 else None
        elif first_line.startswith("{") and first_line.endswith("}"):
            msg = content
        else:
            msg = content
    if not msg:
        msg = json.dumps({"id": "cli", "error": {"code": "injected_failure", "message": "injected failure"}})
    sys.stderr.write(msg + "\n")
    sys.exit(code)


def load_state(stub_dir):
    state_file = os.path.join(stub_dir, "state.json")
    should_seed = (
        os.environ.get("HERDR_STUB_SEED") == "spike"
        or os.path.exists(os.path.join(stub_dir, "seed_spike"))
    )

    if os.path.exists(state_file):
        try:
            with open(state_file, "r", encoding="utf-8") as f:
                return json.load(f)
        except (OSError, json.JSONDecodeError):
            pass

    # Fresh state
    if should_seed:
        return get_spike_seed_state()
    return get_default_empty_state()


def get_default_empty_state():
    return {
        "server": {
            "status": "running",
            "version": "0.9.5",
            "restarts": 0
        },
        "sessions": {
            "default": {
                "default": True,
                "name": "default",
                "running": False,
                "session_dir": "/home/user/.config/herdr",
                "socket_path": "/home/user/.config/herdr/herdr.sock"
            },
            "nogging": {
                "default": False,
                "name": "nogging",
                "running": True,
                "session_dir": "/home/user/.config/herdr/sessions/nogging",
                "socket_path": "/home/user/.config/herdr/sessions/nogging/herdr.sock"
            }
        },
        "workspaces": {},
        "panes": {},
        "next_pane_idx": 1
    }


def get_spike_seed_state():
    return {
        "server": {
            "status": "running",
            "version": "0.9.5",
            "restarts": 0
        },
        "sessions": {
            "default": {
                "default": True,
                "name": "default",
                "running": False,
                "session_dir": "/home/user/.config/herdr",
                "socket_path": "/home/user/.config/herdr/herdr.sock"
            },
            "nogg-spike": {
                "default": False,
                "name": "nogg-spike",
                "running": True,
                "session_dir": "/home/user/.config/herdr/sessions/nogg-spike",
                "socket_path": "/home/user/.config/herdr/sessions/nogg-spike/herdr.sock"
            }
        },
        "workspaces": {
            "w1": {
                "active_tab_id": "w1:t1",
                "agent_status": "done",
                "focused": True,
                "label": "nogging",
                "number": 1,
                "pane_count": 2,
                "tab_count": 2,
                "workspace_id": "w1"
            },
            "w2": {
