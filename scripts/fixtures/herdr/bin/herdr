                "scroll": {"max_offset_from_bottom": 0, "offset_from_bottom": 0, "viewport_rows": 40},
                "tab_id": "w2:t1",
                "terminal_id": "term_65de3f171d1a25",
                "terminal_title": "user@host: /tmp",
                "terminal_title_stripped": "user@host: /tmp",
                "workspace_id": "w2",
                "shell_pid": 17260,
                "foreground_process_group_id": 17260,
                "foreground_processes": [{"argv": ["/bin/bash"], "cmdline": "/bin/bash", "cwd": "/tmp", "name": "bash", "pid": 17260}]
            },
            "w2:p2": {
                "agent_status": "unknown",
                "cwd": "/tmp",
                "focused": False,
                "foreground_cwd": "/tmp",
                "label": "sf-fixture-1",
                "pane_id": "w2:p2",
                "revision": 0,
                "scroll": {"max_offset_from_bottom": 0, "offset_from_bottom": 0, "viewport_rows": 40},
                "tab_id": "w2:t2",
                "terminal_id": "term_65de3f1736e456",
                "workspace_id": "w2",
