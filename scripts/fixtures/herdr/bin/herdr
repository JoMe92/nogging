#!/usr/bin/env python3
"""Stateful fake herdr CLI and Unix socket server for Nogging test suites ($HERDR_STUB_DIR).

Complies with design Decision 14 (TASK-HDR-014):
- Real CLI parity: accepts only real herdr 0.9.5 CLI forms. Synthetic forms
  (layout apply, pane create, pane split --command, ping, api ping,
  server start/run/restart, --seed-spike, --simulate-restart) fail with usage, exit 2.
- Real 0600 Unix domain socket server running foreground on `herdr server`,
  serving `layout.apply` with shape of json/layout-apply.json on shared state.
- Opt-in real process for pane commands via $HERDR_STUB_DIR/real_process or HERDR_STUB_REAL_PROCESS=1.
- Terminates real pane child on `pane close`.
- Socket faults: no server, dropped reply, workspace_not_found, permissions, symlink, non-socket.
- Short path enforcement: socket paths >= 108 bytes fail to bind.
- Redacted env in socket call log.
- Test controls off the CLI via control files or herdr-stub-control.
"""

import copy
import json
import os
import select
import signal
import socket
import subprocess
import sys
import time

SPIKE_DIR = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "spike"))


def get_stub_dir():
    d = os.environ.get("HERDR_STUB_DIR")
    if not d:
        d = f"/tmp/herdr-stub-{os.getuid()}"
    os.makedirs(d, exist_ok=True)
    return d


def get_session_dir(stub_dir, session_name):
    custom_dir_file = os.path.join(stub_dir, "session_dir")
    if os.path.exists(custom_dir_file):
        try:
            with open(custom_dir_file, "r", encoding="utf-8") as f:
                d = f.read().strip()
                if d:
                    return d
        except OSError:
            pass
    if "HERDR_SESSION_DIR" in os.environ:
        return os.environ["HERDR_SESSION_DIR"]
    return os.path.join(stub_dir, "sessions", session_name)


def get_socket_path(stub_dir, session_name):
    custom_sock_file = os.path.join(stub_dir, "socket_path")
    if os.path.exists(custom_sock_file):
        try:
            with open(custom_sock_file, "r", encoding="utf-8") as f:
                p = f.read().strip()
                if p:
                    return p
        except OSError:
            pass
    if "HERDR_SOCKET_PATH_OVERRIDE" in os.environ:
        return os.environ["HERDR_SOCKET_PATH_OVERRIDE"]
    sdir = get_session_dir(stub_dir, session_name)
    return os.path.join(sdir, "herdr.sock")


def log_call(stub_dir, argv):
    call_log = os.path.join(stub_dir, "calls.log")
    try:
        with open(call_log, "a", encoding="utf-8") as f:
            f.write(" ".join(argv) + "\n")
    except OSError:
        pass


def sanitize_params_for_log(obj):
    if isinstance(obj, dict):
        res = {}
        for k, v in obj.items():
            if k == "env" and isinstance(v, dict):
                res[k] = {ek: "[redacted]" for ek in v}
            else:
                res[k] = sanitize_params_for_log(v)
        return res
    elif isinstance(obj, list):
        return [sanitize_params_for_log(item) for item in obj]
    else:
        return obj


def log_socket_call(stub_dir, method, params):
    call_log = os.path.join(stub_dir, "calls.log")
    try:
        sanitized = sanitize_params_for_log(params)
        with open(call_log, "a", encoding="utf-8") as f:
            f.write(f"socket {method} {json.dumps(sanitized, sort_keys=True)}\n")
    except OSError:
        pass


def check_injected_failures(stub_dir, cmd_key=""):
    # 1. fail_once
    fail_once = os.path.join(stub_dir, "fail_once")
    if os.path.exists(fail_once):
        try:
            with open(fail_once, "r", encoding="utf-8") as f:
                content = f.read().strip()
            os.remove(fail_once)
        except OSError:
            content = ""
        emit_failure_and_exit(content)

    # 2. General fail
    fail_file = os.path.join(stub_dir, "fail")
    if os.path.exists(fail_file):
        try:
            with open(fail_file, "r", encoding="utf-8") as f:
                content = f.read().strip()
        except OSError:
            content = ""
        emit_failure_and_exit(content)

    # 3. Subcommand fail
    if cmd_key:
        cmd_fail_file = os.path.join(stub_dir, f"fail_{cmd_key}")
        if os.path.exists(cmd_fail_file):
            try:
                with open(cmd_fail_file, "r", encoding="utf-8") as f:
                    content = f.read().strip()
            except OSError:
                content = ""
            emit_failure_and_exit(content)


def emit_failure_and_exit(content):
    code = 1
    msg = None
    if content:
        lines = content.splitlines()
        first_line = lines[0].strip()
        if first_line.isdigit():
            code = int(first_line)
            msg = "\n".join(lines[1:]) if len(lines) > 1 else None
        elif first_line.startswith("{") and first_line.endswith("}"):
            msg = content
        else:
            msg = content
    if not msg:
        msg = json.dumps({"id": "cli", "error": {"code": "injected_failure", "message": "injected failure"}})
    sys.stderr.write(msg + "\n")
    sys.exit(code)


def load_state(stub_dir):
    state_file = os.path.join(stub_dir, "state.json")
    seed_file = os.path.join(stub_dir, "seed_spike")

    if os.path.exists(seed_file):
        try:
            os.remove(seed_file)
        except OSError:
            pass
        state = get_spike_seed_state(stub_dir)
        save_state(stub_dir, state)
        return state

    should_seed = (os.environ.get("HERDR_STUB_SEED") == "spike")

    if os.path.exists(state_file):
        try:
            with open(state_file, "r", encoding="utf-8") as f:
                return json.load(f)
        except (OSError, json.JSONDecodeError):
            pass

    if should_seed:
        return get_spike_seed_state(stub_dir)
    return get_default_empty_state(stub_dir)


def get_default_empty_state(stub_dir=None):
    if not stub_dir:
        stub_dir = get_stub_dir()
    default_sdir = get_session_dir(stub_dir, "default")
    nogging_sdir = get_session_dir(stub_dir, "nogging")
    return {
        "server": {
            "status": "running",
            "version": "0.9.5",
            "restarts": 0
        },
        "sessions": {
            "default": {
                "default": True,
                "name": "default",
                "running": False,
                "session_dir": default_sdir,
                "socket_path": os.path.join(default_sdir, "herdr.sock")
            },
            "nogging": {
                "default": False,
                "name": "nogging",
                "running": True,
                "session_dir": nogging_sdir,
                "socket_path": os.path.join(nogging_sdir, "herdr.sock")
            }
        },
        "workspaces": {},
        "panes": {},
        "next_pane_idx": 1
    }


