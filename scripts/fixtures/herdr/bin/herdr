def save_state(stub_dir, state):
    state_file = os.path.join(stub_dir, "state.json")
    tmp = state_file + f".tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, state_file)


def simulate_restart(state):
    state.setdefault("server", {})["restarts"] = state.get("server", {}).get("restarts", 0) + 1
    restarts = state["server"]["restarts"]
    for pid_key, pane in state.get("panes", {}).items():
        old_pid = pane.get("shell_pid", 10000)
        new_pid = 20000 + restarts * 1000 + (old_pid % 1000)
        pane["shell_pid"] = new_pid
        pane["foreground_process_group_id"] = new_pid
        pane["foreground_processes"] = [{
            "argv": ["/bin/bash"],
            "cmdline": "/bin/bash",
            "cwd": pane.get("cwd", "/tmp"),
            "name": "bash",
            "pid": new_pid
        }]
        pane["terminal_id"] = f"term_restarted_{new_pid}"
        pane["agent_status"] = "unknown"
        pane.pop("agent", None)


def find_pane(state, target):
    panes = state.get("panes", {})
    if target in panes:
        return panes[target]
    for p in panes.values():
        if p.get("label") == target:
            return p
    return None


def run_server(stub_dir, session_name):
    # Auto-reap child zombies on exit
    try:
        signal.signal(signal.SIGCHLD, signal.SIG_IGN)
    except Exception:
        pass

    session_dir = get_session_dir(stub_dir, session_name)
    socket_path = get_socket_path(stub_dir, session_name)

    # 1. Path length limit (sun_path: 108 bytes including NUL terminator)
    if len(socket_path.encode("utf-8")) >= 108:
        sys.stderr.write(f"herdr: failed to bind socket: path length ({len(socket_path.encode('utf-8'))} bytes) exceeds sun_path limit of 107 bytes: {socket_path}\n")
        sys.exit(1)

    os.makedirs(session_dir, exist_ok=True)
    pid_file = os.path.join(session_dir, "herdr-server.pid")

    # 2. Check if already running
    if os.path.exists(socket_path) and not os.path.islink(socket_path):
        test_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            test_sock.connect(socket_path)
            test_sock.close()
            sys.stderr.write("herdr server is already running\n")
            sys.exit(1)
        except OSError:
            try:
                os.remove(socket_path)
            except OSError:
                pass

    # 3. Handle socket faults at startup
    if os.path.exists(os.path.join(stub_dir, "fault_socket_non_socket")):
        if os.path.exists(socket_path) or os.path.islink(socket_path):
            try:
                os.remove(socket_path)
            except OSError:
                pass
        with open(socket_path, "w", encoding="utf-8") as f:
            f.write("not a socket\n")
        with open(pid_file, "w", encoding="utf-8") as pf:
            pf.write(str(os.getpid()))
        try:
            while not os.path.exists(os.path.join(stub_dir, "server_stopped")):
                time.sleep(0.2)
        finally:
            if os.path.exists(socket_path):
                try: os.remove(socket_path)
                except OSError: pass
            if os.path.exists(pid_file):
                try: os.remove(pid_file)
                except OSError: pass
        sys.exit(0)

    if os.path.exists(os.path.join(stub_dir, "fault_socket_symlink")):
        real_target = socket_path + ".real"
        if os.path.exists(real_target):
            try: os.remove(real_target)
            except OSError: pass
        actual_bind_path = real_target
    else:
        actual_bind_path = socket_path

    if os.path.exists(actual_bind_path):
        try: os.remove(actual_bind_path)
        except OSError: pass

    server_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    old_umask = os.umask(0o177)
    try:
        server_sock.bind(actual_bind_path)
    finally:
        os.umask(old_umask)

    if os.path.exists(os.path.join(stub_dir, "fault_socket_permissions")):
        try:
            with open(os.path.join(stub_dir, "fault_socket_permissions"), "r") as pf:
                mode_str = pf.read().strip()
            mode = int(mode_str, 8) if mode_str else 0o666
        except Exception:
            mode = 0o666
        os.chmod(actual_bind_path, mode)
    else:
        os.chmod(actual_bind_path, 0o600)

    if os.path.exists(os.path.join(stub_dir, "fault_socket_symlink")):
        if os.path.exists(socket_path) or os.path.islink(socket_path):
            try: os.remove(socket_path)
            except OSError: pass
        os.symlink(actual_bind_path, socket_path)

    server_sock.listen(16)
    server_sock.setblocking(False)

    with open(pid_file, "w", encoding="utf-8") as pf:
        pf.write(str(os.getpid()))

    state = load_state(stub_dir)
    state.setdefault("server", {})["status"] = "running"
    state.setdefault("sessions", {}).setdefault(session_name, {})["running"] = True
    state["sessions"][session_name]["session_dir"] = session_dir
    state["sessions"][session_name]["socket_path"] = socket_path
    save_state(stub_dir, state)

    stop_requested = False
    def sig_handler(signum, frame):
        nonlocal stop_requested
        stop_requested = True

    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGINT, sig_handler)

    try:
        while not stop_requested:
            if os.path.exists(os.path.join(stub_dir, "server_stopped")):
                break
            r, _, _ = select.select([server_sock], [], [], 0.2)
            if not r:
                continue
            client_sock, _ = server_sock.accept()
            client_sock.setblocking(True)
            handle_socket_client(stub_dir, session_name, client_sock)
    finally:
        server_sock.close()
        for p in (socket_path, actual_bind_path, pid_file):
            if os.path.exists(p) or os.path.islink(p):
                try: os.remove(p)
                except OSError: pass
        state = load_state(stub_dir)
        if "server" in state:
            state["server"]["status"] = "not_running"
        if session_name in state.get("sessions", {}):
            state["sessions"][session_name]["running"] = False
        save_state(stub_dir, state)
        sys.exit(0)


def handle_socket_client(stub_dir, session_name, client_sock):
    try:
        f = client_sock.makefile("r", encoding="utf-8")
        line = f.readline()
        if not line:
            return
        try:
            req = json.loads(line)
        except Exception:
            return

        req_id = req.get("id")
        method = req.get("method")
        params = req.get("params", {})

        log_socket_call(stub_dir, method, params)

        # Fault: drop reply
        if os.path.exists(os.path.join(stub_dir, "fault_drop_reply")):
            return

        if method == "layout.apply":
            state = load_state(stub_dir)
            w_id = params.get("workspace_id", "w1")
            if os.path.exists(os.path.join(stub_dir, "fault_workspace_not_found")) or w_id not in state.get("workspaces", {}):
                err_resp = {
                    "id": req_id,
                    "error": {
                        "code": "workspace_not_found",
                        "message": f"workspace {w_id} not found"
                    }
                }
                client_sock.sendall((json.dumps(err_resp) + "\n").encode("utf-8"))
                return

            tab_label = params.get("tab_label", "2")
            root = params.get("root", {})
            label = root.get("label", "pane")
            cwd = root.get("cwd", "/tmp")
            command = root.get("command", ["/bin/bash"])
            env_vars = root.get("env", {})

            idx = state.get("next_pane_idx", 1) + 1
            state["next_pane_idx"] = idx
            p_id = f"{w_id}:p{idx}"
            t_id = f"{w_id}:t{idx}"
            term_id = f"term_65de3f17{idx}6e456"

            is_real_process = (
                os.path.exists(os.path.join(stub_dir, "real_process"))
                or os.environ.get("HERDR_STUB_REAL_PROCESS") == "1"
            )
            if is_real_process:
                proc_env = dict(os.environ)
                proc_env.update(env_vars)
                cmd_list = command if isinstance(command, list) else [command]
                proc = subprocess.Popen(
                    cmd_list,
                    cwd=cwd,
                    env=proc_env,
                    start_new_session=True,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
                pid = proc.pid
            else:
                pid = 17260 + idx

            agent_val = env_vars.get("HERDR_AGENT")

            pane_obj = {
                "agent_status": "unknown",
                "cwd": cwd,
                "focused": False,
                "foreground_cwd": cwd,
                "label": label,
                "pane_id": p_id,
                "revision": 0,
                "scroll": {"max_offset_from_bottom": 0, "offset_from_bottom": 0, "viewport_rows": 40},
                "tab_id": t_id,
                "terminal_id": term_id,
                "workspace_id": w_id,
                "shell_pid": pid,
                "foreground_process_group_id": pid,
                "foreground_processes": [{"argv": command if isinstance(command, list) else [command], "cmdline": " ".join(command) if isinstance(command, list) else str(command), "cwd": cwd, "name": os.path.basename(command[0]) if (isinstance(command, list) and command) else "bash", "pid": pid}]
            }
            if agent_val:
                pane_obj["agent"] = agent_val

            state.setdefault("panes", {})[p_id] = pane_obj
            save_state(stub_dir, state)

            reply = {
                "id": req_id,
                "result": {
                    "type": "layout_apply",
                    "layout": {
                        "workspace_id": w_id,
                        "tab_id": t_id,
                        "zoomed": False,
                        "focused_pane_id": p_id,
                        "root": {
                            "type": "pane",
                            "pane_id": p_id,
                            "label": label,
                            "cwd": cwd,
                            "command": command
                        }
                    }
                }
            }
            client_sock.sendall((json.dumps(reply) + "\n").encode("utf-8"))
        else:
            err_resp = {
                "id": req_id,
                "error": {
                    "code": "unknown_method",
                    "message": f"unknown method {method}"
                }
            }
            client_sock.sendall((json.dumps(err_resp) + "\n").encode("utf-8"))
    finally:
        try:
            client_sock.close()
        except OSError:
            pass


def main():
    stub_dir = get_stub_dir()
    argv = sys.argv[1:]
    log_call(stub_dir, argv)

    # Check for simulate_restart flag file
    restart_trigger = os.path.join(stub_dir, "simulate_restart")
    restart_triggered = False
    if os.path.exists(restart_trigger):
        try:
            os.remove(restart_trigger)
            restart_triggered = True
        except OSError:
            pass

    state = load_state(stub_dir)
    if restart_triggered:
        simulate_restart(state)
        save_state(stub_dir, state)

    # Parse global flags
    idx = 0
    session_name = "nogging"
    json_mode = False

    while idx < len(argv):
        arg = argv[idx]
        if arg == "--version" or arg == "-V":
            sys.stdout.write("herdr 0.9.5\n")
            sys.exit(0)
        elif arg == "--session":
            if idx + 1 < len(argv):
                session_name = argv[idx + 1]
                idx += 2
                continue
            else:
                sys.stderr.write("error: --session requires an argument\n")
                sys.exit(2)
        elif arg.startswith("--session="):
            session_name = arg.split("=", 1)[1]
            idx += 1
            continue
        elif arg == "--json":
            json_mode = True
            idx += 1
            continue
        elif arg == "--help" or arg == "-h":
            help_file = os.path.join(SPIKE_DIR, "help", "herdr.txt")
            if os.path.exists(help_file):
                with open(help_file, "r", encoding="utf-8") as f:
                    sys.stdout.write(f.read())
            else:
                sys.stdout.write("herdr — terminal workspace manager for AI coding agents\n")
            sys.exit(0)
        elif arg.startswith("-"):
            # Real CLI syntax error for synthetic or unknown options (--seed-spike, --simulate-restart, etc.)
            sys.stderr.write(f"usage: herdr [options] <command>\nunknown option: {arg}\n")
            sys.exit(2)
        else:
            break

    remaining = argv[idx:]
    if not remaining:
        sys.stdout.write("herdr 0.9.5\n")
        sys.exit(0)

    cmd = remaining[0]
    subcmd = remaining[1] if len(remaining) > 1 else ""

    cmd_key = f"{cmd}_{subcmd}".strip("_").replace("-", "_")
    check_injected_failures(stub_dir, cmd_key)

    # Synthetic CLI forms check per Decision 14:
    # 1. layout apply
    if cmd == "layout":
        sys.stderr.write("usage: herdr [options] <command>\nunknown command: layout\n")
        sys.exit(2)

    # 2. ping and api ping
    if cmd == "ping":
        sys.stderr.write("usage: herdr [options] <command>\nunknown command: ping\n")
        sys.exit(2)

    if cmd == "api" and subcmd == "ping":
        sys.stderr.write("usage: herdr api snapshot | herdr api schema\nunknown subcommand: ping\n")
        sys.exit(2)

    # 3. server start, server run, server restart
    if cmd == "server" and subcmd in ("start", "run", "restart"):
        sys.stderr.write(f"usage: herdr server [stop|reload-config] | herdr server\nunknown subcommand: {subcmd}\n")
        sys.exit(2)

    # 4. pane create
    if cmd == "pane" and subcmd == "create":
        sys.stderr.write("usage: herdr pane <subcommand>\nunknown subcommand: create\n")
        sys.exit(2)

    # 5. pane split --command
    if cmd == "pane" and subcmd == "split" and "--command" in remaining:
        sys.stderr.write("usage: herdr pane split [<pane_id>|--pane ID|--current] --direction right|down [--ratio FLOAT] [--cwd PATH] [--env KEY=VALUE] [--right-click herdr|pane] [--focus] [--no-focus]\nunrecognized option: --command\n")
        sys.exit(2)

    # 6. pane read missing arguments
    if cmd == "pane" and subcmd == "read" and len(remaining) < 3:
        sys.stderr.write("usage: herdr pane read <pane_id> [--source visible|recent|recent-unwrapped|detection] [--lines N] [--format text|ansi] [--ansi] [--raw]\n")
        sys.exit(2)

    server_down = (
        os.path.exists(os.path.join(stub_dir, "server_down"))
        or os.path.exists(os.path.join(stub_dir, "server_stopped"))
        or state.get("server", {}).get("status") == "not_running"
    )

    # Reachability: status
    if cmd == "status":
        session_info = state.get("sessions", {}).get(session_name, {})
        socket_path = session_info.get("socket_path") or get_socket_path(stub_dir, session_name)
        if server_down:
            status_txt = f"""client:
  version: 0.9.5
  channel: stable
  protocol: 22
  endpoint_protocol_generation: 1

server:
  status: not running
  socket: {socket_path}

update:
  restart_needed: no
  server_binary_stale: no
"""
        else:
            status_txt = f"""client:
  version: 0.9.5
  channel: stable
  protocol: 22
  endpoint_protocol_generation: 1

server:
  status: running
  version: 0.9.5
  endpoint_compatible: yes
  private_protocol: 22
  private_protocol_compatible: yes
  socket: {socket_path}

update:
  restart_needed: no
  server_binary_stale: no
"""
        sys.stdout.write(status_txt)
        sys.exit(0)

    # Version subcommand
    if cmd == "version":
        sys.stdout.write("herdr 0.9.5\n")
        sys.exit(0)

    # Server control commands
    if cmd == "server":
        if subcmd == "stop":
            pid_file = os.path.join(get_session_dir(stub_dir, session_name), "herdr-server.pid")
            if os.path.exists(pid_file):
                try:
                    with open(pid_file, "r") as pf:
                        spid = int(pf.read().strip())
                    os.kill(spid, signal.SIGTERM)
                except Exception:
                    pass
            state["server"]["status"] = "not_running"
            if session_name in state.get("sessions", {}):
                state["sessions"][session_name]["running"] = False
            save_state(stub_dir, state)
            sys.exit(0)
        elif subcmd == "reload-config":
            sys.exit(0)
        elif subcmd == "":
            run_server(stub_dir, session_name)
        else:
            sys.stderr.write(f"usage: herdr server [stop|reload-config] | herdr server\nunknown subcommand: {subcmd}\n")
            sys.exit(2)

    # Session commands
    if cmd == "session":
        if subcmd == "list":
            sess_list = []
            for sname, sdata in state.get("sessions", {}).items():
                sdir = sdata.get("session_dir") or get_session_dir(stub_dir, sname)
                spath = sdata.get("socket_path") or os.path.join(sdir, "herdr.sock")
                sess_list.append({
                    "default": sdata.get("default", False),
                    "name": sname,
                    "running": False if server_down else sdata.get("running", True),
                    "session_dir": sdir,
                    "socket_path": spath
                })
            out = {"sessions": sess_list}
            sys.stdout.write(json.dumps(out) + "\n")
            sys.exit(0)
        elif subcmd == "stop":
            target_name = remaining[2] if len(remaining) > 2 else session_name
            pid_file = os.path.join(get_session_dir(stub_dir, target_name), "herdr-server.pid")
            if os.path.exists(pid_file):
                try:
                    with open(pid_file, "r") as pf:
                        spid = int(pf.read().strip())
                    os.kill(spid, signal.SIGTERM)
                except Exception:
                    pass
            if target_name in state.get("sessions", {}):
                state["sessions"][target_name]["running"] = False
                save_state(stub_dir, state)
            if json_mode or "--json" in remaining:
                sys.stdout.write(json.dumps({"result": {"type": "ok"}}) + "\n")
            sys.exit(0)
        elif subcmd == "delete":
            target_name = remaining[2] if len(remaining) > 2 else session_name
            if target_name in state.get("sessions", {}):
                del state["sessions"][target_name]
                save_state(stub_dir, state)
            if json_mode or "--json" in remaining:
                sys.stdout.write(json.dumps({"result": {"type": "ok"}}) + "\n")
            sys.exit(0)

    # If server is down, all subsequent commands fail with server_not_running
    if server_down:
        err = {
            "id": f"cli:{cmd}:{subcmd}".rstrip(":"),
            "error": {
                "code": "server_not_running",
                "message": f"no herdr server is running at /home/user/.config/herdr/sessions/{session_name}/herdr.sock; run `herdr session attach {session_name}` to start or attach it"
            }
        }
        sys.stderr.write(json.dumps(err) + "\n")
        sys.exit(1)

    # API commands
    if cmd == "api":
        if subcmd == "snapshot":
            res = {
                "id": "cli:api:snapshot",
                "result": {
                    "type": "snapshot",
                    "server": {
                        "status": "running",
                        "version": "0.9.5"
                    }
                }
            }
            sys.stdout.write(json.dumps(res) + "\n")
            sys.exit(0)
        else:
            sys.stderr.write("usage: herdr api snapshot | herdr api schema\n")
            sys.exit(2)

    # Workspace commands
    if cmd == "workspace":
        if subcmd == "list":
            workspaces = list(state.get("workspaces", {}).values())
            res = {
                "id": "cli:workspace:list",
                "result": {
                    "type": "workspace_list",
                    "workspaces": workspaces
                }
            }
            sys.stdout.write(json.dumps(res) + "\n")
            sys.exit(0)
        elif subcmd == "create":
            label = "nogging-fixture"
            cwd = "/tmp"
            i = 2
            while i < len(remaining):
                if remaining[i] == "--label" and i + 1 < len(remaining):
                    label = remaining[i + 1]
                    i += 2
                elif remaining[i] == "--cwd" and i + 1 < len(remaining):
                    cwd = remaining[i + 1]
                    i += 2
                else:
                    i += 1
            num = len(state.get("workspaces", {})) + 1
            w_id = f"w{num}"
            p_id = f"{w_id}:p1"
            t_id = f"{w_id}:t1"
            term_id = f"term_65de3f17{num}d1a25"
            root_pane = {
                "agent_status": "unknown",
                "cwd": cwd,
                "focused": False,
                "foreground_cwd": cwd,
                "pane_id": p_id,
                "revision": 0,
                "scroll": {"max_offset_from_bottom": 0, "offset_from_bottom": 0, "viewport_rows": 40},
                "tab_id": t_id,
                "terminal_id": term_id,
                "workspace_id": w_id,
                "shell_pid": 17260 + num,
                "foreground_process_group_id": 17260 + num,
                "foreground_processes": [{"argv": ["/bin/bash"], "cmdline": "/bin/bash", "cwd": cwd, "name": "bash", "pid": 17260 + num}]
            }
            tab = {
                "agent_status": "unknown",
                "focused": False,
                "label": "1",
                "number": 1,
                "pane_count": 1,
                "tab_id": t_id,
                "workspace_id": w_id
            }
            workspace = {
                "active_tab_id": t_id,
                "agent_status": "unknown",
                "focused": False,
                "label": label,
                "number": num,
                "pane_count": 1,
                "tab_count": 1,
                "workspace_id": w_id
            }
            state.setdefault("workspaces", {})[w_id] = workspace
            state.setdefault("panes", {})[p_id] = root_pane
            save_state(stub_dir, state)
            res = {
                "id": "cli:workspace:create",
                "result": {
                    "root_pane": root_pane,
                    "tab": tab,
                    "type": "workspace_created",
                    "workspace": workspace
                }
            }
            sys.stdout.write(json.dumps(res) + "\n")
            sys.exit(0)
        elif subcmd == "close":
            w_id = remaining[2] if len(remaining) > 2 else ""
            if w_id in state.get("workspaces", {}):
                del state["workspaces"][w_id]
                save_state(stub_dir, state)
            sys.stdout.write(json.dumps({"id": "cli:workspace:close", "result": {"type": "ok"}}) + "\n")
            sys.exit(0)

    # Pane commands
    if cmd == "pane":
        if subcmd == "split":
            label = "pane"
            cwd = "/tmp"
            w_id = "w1"
            command = ["/bin/bash"]
            env_vars = {}
            i = 2
            while i < len(remaining):
                arg = remaining[i]
                if arg == "--label" and i + 1 < len(remaining):
                    label = remaining[i + 1]
                    i += 2
                elif arg == "--cwd" and i + 1 < len(remaining):
                    cwd = remaining[i + 1]
                    i += 2
                elif arg == "--workspace" and i + 1 < len(remaining):
                    w_id = remaining[i + 1]
                    i += 2
                elif arg == "--env" and i + 1 < len(remaining):
                    parts = remaining[i + 1].split("=", 1)
                    if len(parts) == 2:
                        env_vars[parts[0]] = parts[1]
                    i += 2
                else:
                    i += 1

            idx = state.get("next_pane_idx", 1) + 1
            state["next_pane_idx"] = idx
            p_id = f"{w_id}:p{idx}"
            t_id = f"{w_id}:t{idx}"
            pid = 17260 + idx
            term_id = f"term_65de3f17{idx}6e456"

            agent_val = env_vars.get("HERDR_AGENT")

            pane_obj = {
                "agent_status": "unknown",
                "cwd": cwd,
                "focused": False,
                "foreground_cwd": cwd,
                "label": label,
                "pane_id": p_id,
                "revision": 0,
                "scroll": {"max_offset_from_bottom": 0, "offset_from_bottom": 0, "viewport_rows": 40},
                "tab_id": t_id,
                "terminal_id": term_id,
                "workspace_id": w_id,
                "shell_pid": pid,
                "foreground_process_group_id": pid,
                "foreground_processes": [{"argv": command, "cmdline": " ".join(command), "cwd": cwd, "name": os.path.basename(command[0]) if command else "bash", "pid": pid}]
            }
            if agent_val:
                pane_obj["agent"] = agent_val

            state.setdefault("panes", {})[p_id] = pane_obj
            save_state(stub_dir, state)

            res = {
                "id": "cli:pane:split",
                "result": {
                    "pane": pane_obj,
                    "type": "pane_info"
                }
            }
            sys.stdout.write(json.dumps(res) + "\n")
            sys.exit(0)

        elif subcmd == "list":
            w_filter = None
            for i, a in enumerate(remaining):
                if a == "--workspace" and i + 1 < len(remaining):
                    w_filter = remaining[i + 1]

            panes = list(state.get("panes", {}).values())
            if w_filter:
                panes = [p for p in panes if p.get("workspace_id") == w_filter]

            res_panes = []
            for p in panes:
                cp = dict(p)
                cp.pop("foreground_processes", None)
                cp.pop("foreground_process_group_id", None)
                cp.pop("shell_pid", None)
                res_panes.append(cp)

            res = {
                "id": "cli:pane:list",
                "result": {
                    "panes": res_panes,
                    "type": "pane_list"
                }
            }
            sys.stdout.write(json.dumps(res) + "\n")
            sys.exit(0)

        elif subcmd == "get":
            target = remaining[2] if len(remaining) > 2 else ""
            pane = find_pane(state, target)
            if not pane:
                err = {
                    "error": {
                        "code": "pane_not_found",
                        "message": f"pane {target} not found"
                    },
                    "id": "cli:pane:get"
                }
                sys.stderr.write(json.dumps(err) + "\n")
                sys.exit(1)

            cp = dict(pane)
            cp.pop("foreground_processes", None)
            cp.pop("foreground_process_group_id", None)
            cp.pop("shell_pid", None)

            res = {
                "id": "cli:pane:get",
                "result": {
                    "pane": cp,
                    "type": "pane_info"
                }
            }
            sys.stdout.write(json.dumps(res) + "\n")
            sys.exit(0)

        elif subcmd == "process-info" or subcmd == "process_info":
            target = ""
            for i, a in enumerate(remaining):
                if a == "--pane" and i + 1 < len(remaining):
                    target = remaining[i + 1]
                elif i >= 2 and not a.startswith("-") and not target:
                    target = a

            pane = find_pane(state, target)
            if not pane:
                err = {
                    "error": {
                        "code": "pane_not_found",
                        "message": f"pane {target} not found"
                    },
                    "id": "cli:pane:process_info"
                }
                sys.stderr.write(json.dumps(err) + "\n")
                sys.exit(1)

            p_id = pane.get("pane_id", target)
            shell_pid = pane.get("shell_pid", 17260)
            pgid = pane.get("foreground_process_group_id", shell_pid)
            fg_procs = pane.get("foreground_processes", [
                {"argv": ["/bin/bash"], "cmdline": "/bin/bash", "cwd": pane.get("cwd", "/tmp"), "name": "bash", "pid": shell_pid}
            ])

            res = {
                "id": "cli:pane:process_info",
                "result": {
                    "process_info": {
                        "foreground_process_group_id": pgid,
                        "foreground_processes": fg_procs,
                        "pane_id": p_id,
                        "shell_pid": shell_pid
                    },
                    "type": "pane_process_info"
                }
            }
            sys.stdout.write(json.dumps(res) + "\n")
            sys.exit(0)

        elif subcmd == "rename":
            target = remaining[2] if len(remaining) > 2 else ""
            new_label = remaining[3] if len(remaining) > 3 else "renamed"
            pane = find_pane(state, target)
            if not pane:
                err = {
                    "error": {
                        "code": "pane_not_found",
                        "message": f"pane {target} not found"
                    },
                    "id": "cli:pane:rename"
                }
                sys.stderr.write(json.dumps(err) + "\n")
                sys.exit(1)

            pane["label"] = new_label
            save_state(stub_dir, state)

            cp = dict(pane)
            cp.pop("foreground_processes", None)
            cp.pop("foreground_process_group_id", None)
            cp.pop("shell_pid", None)

            res = {
                "id": "cli:pane:rename",
                "result": {
                    "pane": cp,
                    "type": "pane_info"
                }
            }
            sys.stdout.write(json.dumps(res) + "\n")
            sys.exit(0)

        elif subcmd == "send-text":
            target = remaining[2] if len(remaining) > 2 else ""
            text = remaining[3] if len(remaining) > 3 else ""
            pane = find_pane(state, target)
            if not pane:
                sys.stderr.write(json.dumps({"error": {"code": "pane_not_found", "message": f"pane {target} not found"}, "id": "cli:pane:send_text"}) + "\n")
                sys.exit(1)
            pane["last_input"] = text
            save_state(stub_dir, state)
            if json_mode or "--json" in remaining:
                sys.stdout.write(json.dumps({"result": {"type": "ok"}}) + "\n")
            sys.exit(0)

        elif subcmd == "send-keys":
            target = remaining[2] if len(remaining) > 2 else ""
            keys = remaining[3:]
            pane = find_pane(state, target)
            if not pane:
                sys.stderr.write(json.dumps({"error": {"code": "pane_not_found", "message": f"pane {target} not found"}, "id": "cli:pane:send_keys"}) + "\n")
                sys.exit(1)

            p_id = pane.get("pane_id", "")
            p_label = pane.get("label", "")
            is_enter = any(k.lower() == "enter" for k in keys)

            if is_enter:
                for cand in [f"pane-{p_id}.after", f"pane-{p_label}.after"]:
                    after_path = os.path.join(stub_dir, cand)
                    if os.path.exists(after_path):
                        target_txt = os.path.join(stub_dir, f"pane-{p_id}.txt")
                        try:
                            with open(after_path, "rb") as af:
                                with open(target_txt, "wb") as tf:
                                    tf.write(af.read())
                        except OSError:
                            pass

                if os.path.exists(os.path.join(stub_dir, "auto_working")):
                    pane["agent_status"] = "working"
                    save_state(stub_dir, state)

            if json_mode or "--json" in remaining:
                sys.stdout.write(json.dumps({"result": {"type": "ok"}}) + "\n")
            sys.exit(0)

        elif subcmd == "run":
            if json_mode or "--json" in remaining:
                sys.stdout.write(json.dumps({"result": {"type": "ok"}}) + "\n")
            sys.exit(0)

        elif subcmd == "close":
            target = remaining[2] if len(remaining) > 2 else ""
            pane = find_pane(state, target)
            if pane:
                shell_pid = pane.get("shell_pid")
                if shell_pid:
                    try:
                        os.killpg(shell_pid, signal.SIGTERM)
                    except (ProcessLookupError, PermissionError, OSError):
                        try:
                            os.kill(shell_pid, signal.SIGTERM)
                        except (ProcessLookupError, PermissionError, OSError):
                            pass
                    time.sleep(0.05)
                    try:
                        os.killpg(shell_pid, signal.SIGKILL)
                    except (ProcessLookupError, PermissionError, OSError):
                        try:
                            os.kill(shell_pid, signal.SIGKILL)
                        except (ProcessLookupError, PermissionError, OSError):
                            pass
                p_id = pane.get("pane_id")
                if p_id in state.get("panes", {}):
                    del state["panes"][p_id]
                    save_state(stub_dir, state)
            sys.stdout.write(json.dumps({"id": "cli:pane:close", "result": {"type": "ok"}}) + "\n")
            sys.exit(0)

        elif subcmd == "read":
            target = remaining[2]
            source = "visible"
            fmt = "text"
            i = 3
            while i < len(remaining):
                arg = remaining[i]
                if arg == "--source" and i + 1 < len(remaining):
                    source = remaining[i + 1]
                    i += 2
                elif arg == "--format" and i + 1 < len(remaining):
                    fmt = remaining[i + 1]
                    i += 2
                elif arg == "--ansi":
                    fmt = "ansi"
                    i += 1
                elif arg == "--json":
                    json_mode = True
                    i += 1
                else:
                    i += 1

            pane = find_pane(state, target)
            if not pane:
                err = {
                    "error": {
                        "code": "pane_not_found",
                        "message": f"pane {target} not found"
                    },
                    "id": "cli:pane:read"
                }
                sys.stderr.write(json.dumps(err) + "\n")
                sys.exit(1)

            p_id = pane.get("pane_id", target)
            p_label = pane.get("label", "")
            workspace_id = pane.get("workspace_id", "w2")
            tab_id = pane.get("tab_id", "w2:t2")

            text_bytes = None
            if fmt == "ansi":
                for cand in [f"pane-{p_id}.ansi", f"pane-{p_label}.ansi", f"pane-{p_id}.txt", f"pane-{p_label}.txt"]:
                    cand_path = os.path.join(stub_dir, cand)
                    if os.path.exists(cand_path):
                        with open(cand_path, "rb") as f:
                            text_bytes = f.read()
                        break
                if text_bytes is None:
                    fx = os.path.join(SPIKE_DIR, "read", f"fixture-{source}.ansi")
                    if not os.path.exists(fx):
                        fx = os.path.join(SPIKE_DIR, "read", "fixture-visible.ansi")
                    with open(fx, "rb") as f:
                        text_bytes = f.read()

                if json_mode:
                    text_str = text_bytes.decode("utf-8", errors="replace")
                    res = {
                        "id": "cli:pane:read",
                        "result": {
                            "type": "pane_read",
                            "read": {
                                "format": "ansi",
                                "pane_id": p_id,
                                "revision": 0,
                                "source": source,
                                "tab_id": tab_id,
                                "text": text_str,
                                "truncated": False,
                                "workspace_id": workspace_id
                            }
                        }
                    }
                    sys.stdout.write(json.dumps(res) + "\n")
                else:
                    sys.stdout.buffer.write(text_bytes)
                sys.exit(0)
            else:
                for cand in [f"pane-{p_id}.txt", f"pane-{p_label}.txt"]:
                    cand_path = os.path.join(stub_dir, cand)
                    if os.path.exists(cand_path):
                        with open(cand_path, "rb") as f:
                            text_bytes = f.read()
                        break
                if text_bytes is None:
                    fx = os.path.join(SPIKE_DIR, "read", f"fixture-{source}.txt")
                    if not os.path.exists(fx):
                        fx = os.path.join(SPIKE_DIR, "read", "fixture-visible.txt")
                    with open(fx, "rb") as f:
                        text_bytes = f.read()

                if json_mode:
                    text_str = text_bytes.decode("utf-8", errors="replace")
                    res = {
                        "id": "cli:pane:read",
                        "result": {
                            "type": "pane_read",
                            "read": {
                                "format": "text",
                                "pane_id": p_id,
                                "revision": 0,
                                "source": source,
                                "tab_id": tab_id,
                                "text": text_str,
                                "truncated": False,
                                "workspace_id": workspace_id
                            }
                        }
                    }
                    sys.stdout.write(json.dumps(res) + "\n")
                else:
                    sys.stdout.buffer.write(text_bytes)
                sys.exit(0)

    # Agent commands
    if cmd == "agent":
        if subcmd == "get":
            target = remaining[2] if len(remaining) > 2 else ""
            pane = find_pane(state, target)
            if not pane:
                for p in state.get("panes", {}).values():
                    if p.get("agent") == target:
                        pane = p
                        break

            if not pane:
                err = {"error": {"code": "agent_not_found", "message": f"agent {target} not found"}, "id": "cli:agent:get"}
                sys.stderr.write(json.dumps(err) + "\n")
                sys.exit(1)

            agent_info = {
                "agent": pane.get("agent", "claude"),
                "agent_status": pane.get("agent_status", "unknown"),
                "completion_seq": pane.get("completion_seq", 1),
                "cwd": pane.get("cwd", "/tmp"),
                "focused": pane.get("focused", False),
                "foreground_cwd": pane.get("foreground_cwd", "/tmp"),
                "pane_id": pane.get("pane_id", "w1:p1"),
                "revision": pane.get("revision", 0),
                "state_change_seq": pane.get("state_change_seq", 1),
                "tab_id": pane.get("tab_id", "w1:t1"),
                "terminal_id": pane.get("terminal_id", "term_12345"),
                "workspace_id": pane.get("workspace_id", "w1")
            }
            if "terminal_title" in pane:
                agent_info["terminal_title"] = pane["terminal_title"]
            if "terminal_title_stripped" in pane:
                agent_info["terminal_title_stripped"] = pane["terminal_title_stripped"]

            res = {
                "id": "cli:agent:get",
                "result": {
                    "agent": agent_info,
                    "type": "agent_info"
                }
            }
            sys.stdout.write(json.dumps(res) + "\n")
            sys.exit(0)

        elif subcmd == "list":
            agents = []
            for p in state.get("panes", {}).values():
                if p.get("agent"):
                    ag = {
                        "agent": p.get("agent"),
                        "agent_status": p.get("agent_status", "unknown"),
                        "completion_seq": p.get("completion_seq", 1),
                        "cwd": p.get("cwd", "/tmp"),
                        "focused": p.get("focused", False),
                        "foreground_cwd": p.get("foreground_cwd", "/tmp"),
                        "pane_id": p.get("pane_id", "w1:p1"),
                        "revision": p.get("revision", 0),
                        "state_change_seq": p.get("state_change_seq", 1),
                        "tab_id": p.get("tab_id", "w1:t1"),
                        "terminal_id": p.get("terminal_id", "term_12345"),
                        "workspace_id": p.get("workspace_id", "w1")
                    }
                    if "terminal_title" in p:
                        ag["terminal_title"] = p["terminal_title"]
                    if "terminal_title_stripped" in p:
                        ag["terminal_title_stripped"] = p["terminal_title_stripped"]
                    agents.append(ag)

            res = {
                "id": "cli:agent:list",
                "result": {
                    "agents": agents,
                    "type": "agent_list"
                }
            }
            sys.stdout.write(json.dumps(res) + "\n")
            sys.exit(0)

        elif subcmd == "explain":
            target = remaining[2] if len(remaining) > 2 else ""
            explain_json = "--json" in remaining or json_mode
            if explain_json:
                explain_fixture = os.path.join(SPIKE_DIR, "json", "agent-explain.json")
                if os.path.exists(explain_fixture):
                    with open(explain_fixture, "r", encoding="utf-8") as f:
                        sys.stdout.write(f.read())
                else:
                    res = {
                        "agent": "claude",
                        "cached_remote_version": "2026.10.11.1",
                        "evaluated_rules": [],
                        "fallback_reason": None,
                        "local_override_shadowing_remote": False,
                        "manifest_source": "remote:/home/user/.local/state/herdr/agent-detection/remote/claude.toml",
                        "manifest_version": "2026.10.11.1",
                        "matched_rule": {"id": "live_prompt_box", "priority": 950, "region": "prompt_box_body", "state": "idle"},
                        "remote_update_error": None,
                        "remote_update_status": "current",
                        "screen_detection_skipped": False,
                        "skip_state_update": False,
                        "skipped_update_reason": None,
                        "state": "idle",
                        "visible_blocker": False,
                        "visible_idle": True,
                        "visible_working": False,
                        "warning": None
                    }
                    sys.stdout.write(json.dumps(res) + "\n")
            else:
                txt = "agent: claude\nstate: idle\nmanifest: remote:/home/user/.local/state/herdr/agent-detection/remote/claude.toml 2026.10.11.1\nrule: live_prompt_box (region=prompt_box_body priority=950)\nevidence: \"\u276f\\n\"\n"
                sys.stdout.write(txt)
            sys.exit(0)

    # Unknown command / syntax error
    sys.stderr.write(f"usage: herdr [options] <command>\nunknown command: {' '.join(remaining)}\n")
    sys.exit(2)


if __name__ == "__main__":
    main()
