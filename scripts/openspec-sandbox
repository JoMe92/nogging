#!/usr/bin/env python3
"""Linux mount boundary for supervised execution; mechanical ticks use a broker."""
import contextlib
import ctypes
import io
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import tempfile
import threading
from importlib.machinery import SourceFileLoader


def enter(boundary, argv):
    subprocess.run(['mount', '--make-rprivate', '/'], check=True)
    for root in boundary['roots']:
        path = Path(root) / 'openspec'
        if not path.is_dir() or path.is_symlink():
            raise RuntimeError(f'OpenSpec filesystem boundary requires a real directory: {path}')
        subprocess.run(['mount', '--bind', str(path), str(path)], check=True)
        subprocess.run(['mount', '-o', 'remount,bind,ro,nosuid,nodev', str(path)], check=True)
    # The launched runtime must not be able to remount its own read-only roots.
    # It re-enters as the invoking host user in a nested user+mount namespace:
    # the kernel locks the inherited read-only mounts there (no rw remount, no
    # unmount, no non-recursive bind around them), the runtime is not uid 0
    # (agents refuse unattended permission modes as root), and it can still
    # build its own nested sandbox such as Codex's bwrap, which an emptied
    # capability bounding set would forbid.
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(38, 1, 0, 0, 0):  # PR_SET_NO_NEW_PRIVS
        raise OSError(ctypes.get_errno(), 'cannot seal mount boundary')
    os.environ['NOGG_OPENSPEC_FENCED'] = '1'
    os.execvp('unshare', ['unshare', '--user', '--mount', f"--map-user={boundary['uid']}",
                          f"--map-group={boundary['gid']}", '--', *argv])


def handle_task_done_request(bridge, request, repository):
    """Apply one closed-Bead tick to a registered checkout in this repository."""
    if (not isinstance(request, dict) or set(request) != {'bead_id', 'checkout'}
            or not isinstance(request.get('bead_id'), str)
            or not bridge.re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,127}', request['bead_id'])):
        return {'ok': False, 'error': 'broker requires exactly a Bead identifier and checkout'}
    if not isinstance(request.get('checkout'), str) or not Path(request['checkout']).is_absolute():
        return {'ok': False, 'error': 'checkout must be an absolute registered worktree path'}
    try:
        requested = Path(request['checkout']).resolve(strict=True)
        state = bridge.canonical_repository_state(requested)
    except (OSError, RuntimeError) as exc:
        return {'ok': False, 'error': f"checkout is not a registered worktree: {exc}"}
    if state['common_dir'] != repository['common_dir']:
        return {'ok': False, 'error': 'checkout belongs to a different repository'}
    if str(requested) not in state['checkout_roots'] or state['checkout_root'] != str(requested):
        return {'ok': False, 'error': 'checkout is not a registered worktree root'}

    previous_root = bridge.ROOT
    output = io.StringIO()
    try:
        bridge.ROOT = requested
        with contextlib.redirect_stdout(output):
            bridge.task_done(request['bead_id'])
        return {'ok': True, 'output': output.getvalue()}
    except Exception as exc:
        return {'ok': False, 'error': str(exc)}
    finally:
        bridge.ROOT = previous_root


def handle_rebase_request(bridge, request, repository):
    """Run a closed rebase request from the host side of the OpenSpec fence."""
    def refused(message):
        return {'ok': False, 'status': 'refused', 'output': message, 'error': message}

    if (not isinstance(request, dict) or set(request) != {'action', 'checkout', 'mode', 'session'}
            or request.get('action') != 'rebase'
            or not isinstance(request.get('mode'), str)
            or request['mode'] not in {'start', 'continue', 'abort'}
            or (request.get('session') is not None
                and (not isinstance(request.get('session'), str)
                     or not bridge.re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,127}', request['session'])))):
        return refused('broker requires exactly a closed rebase request')
    checkout_value = request.get('checkout')
    if not isinstance(checkout_value, str) or not Path(checkout_value).is_absolute():
        return refused('checkout must be an absolute registered worktree path')
    try:
        checkout = Path(checkout_value).resolve(strict=True)
        state = bridge.canonical_repository_state(checkout)
    except (OSError, RuntimeError) as exc:
        return refused(f'checkout is not a registered worktree: {exc}')
    if state['common_dir'] != repository['common_dir']:
        return refused('checkout belongs to a different repository')
    if str(checkout) not in state['checkout_roots'] or state['checkout_root'] != str(checkout):
        return refused('checkout is not a registered worktree root')
    if request['session'] is not None:
        session_dir = Path(state['main_checkout']) / bridge.scfg('session_state_dir', '.nogging/state/sessions')
        session_path = session_dir / f"{request['session']}.json"
        try:
            session = json.loads(session_path.read_text())
        except (OSError, ValueError) as exc:
            return refused(f"requester session is unavailable: {exc}")
        if (not isinstance(session, dict) or session.get('name') != request['session']
                or session.get('working_dir') != str(checkout)):
            return refused('requester session does not own this checkout')

    previous_root = bridge.ROOT
    previous_session = os.environ.get('NOGG_SESSION_NAME')
    output = io.StringIO()
    try:
        bridge.ROOT = checkout
        if request['session'] is None:
            os.environ.pop('NOGG_SESSION_NAME', None)
        else:
            os.environ['NOGG_SESSION_NAME'] = request['session']
        try:
            with contextlib.redirect_stdout(output):
                bridge.worktree_rebase(None, request['mode'])
        except SystemExit as exc:
            if exc.code == 3 or 'code rebase conflict paused' in str(exc):
                output.write(str(exc))
                return {'ok': True, 'status': 'paused', 'output': output.getvalue()}
            return refused(str(exc))
        text = output.getvalue()
        return {'ok': True, 'status': 'up-to-date' if 'already up to date' in text else 'done', 'output': text}
    except Exception as exc:
        return refused(str(exc))
    finally:
        bridge.ROOT = previous_root
        if previous_session is None:
            os.environ.pop('NOGG_SESSION_NAME', None)
        else:
            os.environ['NOGG_SESSION_NAME'] = previous_session


def supervise(argv):
    helper = Path(__file__).resolve().with_name('nogg')
    original_root = os.environ.get('NOGGING_ROOT')
    try:
        os.environ['NOGGING_ROOT'] = os.getcwd()
        bridge = SourceFileLoader('nogg_boundary_broker', str(helper)).load_module()
    finally:
        if original_root is None:
            os.environ.pop('NOGGING_ROOT', None)
        else:
            os.environ['NOGGING_ROOT'] = original_root
    roots = bridge.canonical_repository_state(os.getcwd())['checkout_roots']
    repository = bridge.canonical_repository_state(os.getcwd())
    # The private host-side broker exposes only the closed Bead tick and the
    # fixed rebase state machine. No arbitrary command or general writer exists.
    with tempfile.TemporaryDirectory(prefix='nogg-tick-') as directory:
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        address = str(Path(directory) / 'broker')
        server.bind(address)
        os.chmod(address, 0o600)
        server.listen(4)
        stopped = threading.Event()
        def serve():
            while not stopped.is_set():
                try:
                    client, _ = server.accept()
                except OSError:
                    return
                with client:
                    client.settimeout(5)
                    try:
                        raw = b""
                        while chunk := client.recv(4097 - len(raw)):
                            raw += chunk
                            if len(raw) > 4096:
                                raise RuntimeError("mechanical tick request is too large")
                        request = json.loads(raw)
                        if isinstance(request, dict) and request.get('action') == 'rebase':
                            response = handle_rebase_request(bridge, request, repository)
                        else:
                            response = handle_task_done_request(bridge, request, repository)
                    except Exception as exc:
                        response = {'ok': False, 'status': 'refused', 'output': str(exc), 'error': str(exc)}
                    try:
                        client.sendall(json.dumps(response).encode())
                    except OSError:
                        pass  # A disconnected requester cannot kill the broker.
        worker = threading.Thread(target=serve, daemon=True)
        worker.start()
        env = {**os.environ, 'NOGG_TASK_DONE_SOCKET': address}
        child = subprocess.Popen(['unshare', '--user', '--map-root-user', '--mount', '--pid', '--fork', '--kill-child=KILL', '--mount-proc',
                                  sys.executable, str(Path(__file__).resolve()), '--enter',
                                  json.dumps({'roots': roots, 'uid': os.getuid(), 'gid': os.getgid()}), '--', *argv], env=env)
        def forward(signum, frame):
            if child.poll() is None:
                child.send_signal(signum)
        signal.signal(signal.SIGTERM, forward)
        signal.signal(signal.SIGINT, forward)
        code = child.wait()
        stopped.set()
        server.close()
        return code if code >= 0 else 128 - code


if __name__ == '__main__':
    try:
        if sys.argv[1:] == ['--contract']:
            print(json.dumps({'version': 1, 'features': ['readonly-mounts', 'closed-task-broker', 'checkout-task-broker', 'rebase-broker']}))
            sys.exit(0)
        if sys.argv[1:2] == ['--enter']:
            enter(json.loads(sys.argv[2]), sys.argv[4:])
        else:
            sys.exit(supervise(sys.argv[1:]))
    except Exception as exc:
        print(f'nogg: OpenSpec filesystem boundary unavailable: {exc}; execution refused', file=sys.stderr)
        sys.exit(2)
