#!/usr/bin/env bash
# The single implementation of the SpecForge branch-naming convention.
#
#   scripts/check-branch-name <ref>
#
# <ref> is a branch name or ref (a leading refs/heads/ is stripped). Exit 0 when
# the name satisfies the convention, non-zero with an actionable message when it
# does not. The pre-push hook and the CI `invariants` job both call this script;
# neither re-encodes the rule.
#
# Convention:
#   - `main` and `develop` are protected and always valid.
#   - A planning branch is `plan/<planning-id>/<description>`, where both
#     components are kebab-case. This makes its planning purpose and isolated
#     worktree intent visible without coupling it to an OpenSpec change name.
#   - Every non-planning branch is `<type>/<slug>` with <type> in
#     {feat, fix, chore, docs, refactor, perf, test}.
#   - `chore/<topic>` takes a free kebab <topic>.
#   - Every other <type> is a change branch: <slug> MUST match a live
#     openspec/changes/<slug>/ or an archived openspec/changes/archive/*-<slug>/
#     directory (never `archive` itself).
#   - An unresolvable ref (detached HEAD, empty head_ref) fails closed.
set -euo pipefail

types='feat|fix|chore|docs|refactor|perf|test'

ref="${1-}"
ref="${ref#refs/heads/}"

root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

usage() {
  {
    echo "SpecForge: branch name must be <type>/<slug>, or plan/<planning-id>/<description>."
    echo "  <type> is one of: feat, fix, chore, docs, refactor, perf, test"
    echo "  a change branch's <slug> must equal an openspec/changes/<slug>/ directory name"
    echo "  chore/<topic> takes a free kebab topic; planning IDs and descriptions are kebab-case"
    echo "  main and develop are exempt"
  } >&2
}

if [[ -z "$ref" || "$ref" == "HEAD" ]]; then
  echo "SpecForge: could not resolve a branch name (detached HEAD or empty ref)." >&2
  usage
  exit 1
fi

if [[ "$ref" == "main" || "$ref" == "develop" ]]; then
  exit 0
fi

if [[ "$ref" =~ ^plan/([a-z0-9]+(-[a-z0-9]+)*)/([a-z0-9]+(-[a-z0-9]+)*)$ ]]; then
  exit 0
fi

if ! [[ "$ref" =~ ^($types)/([a-z0-9]+(-[a-z0-9]+)*)$ ]]; then
  echo "SpecForge: branch '$ref' does not match <type>/<slug>." >&2
  usage
  exit 1
fi

type="${BASH_REMATCH[1]}"
slug="${BASH_REMATCH[2]}"

if [[ "$type" == "chore" ]]; then
  exit 0
fi

if [[ "$slug" == "archive" ]]; then
  echo "SpecForge: branch '$ref' — 'archive' is not a change slug." >&2
  usage
  exit 1
fi

if [[ -d "$root/openspec/changes/$slug" ]]; then
  exit 0
fi

# An archived change keeps its slug: openspec/changes/archive/YYYY-MM-DD-<slug>/.
# A branch opened before the change was archived must not start failing.
for d in "$root"/openspec/changes/archive/*-"$slug"; do
  [[ -d "$d" ]] && exit 0
done

echo "SpecForge: branch '$ref' is a change branch but no openspec/changes/$slug/ (live or archived) exists." >&2
echo "  Rename the branch to match its change directory, use chore/<topic>, or use plan/<planning-id>/<description>." >&2
usage
exit 1
