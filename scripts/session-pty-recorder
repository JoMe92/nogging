#!/usr/bin/env python3
"""PTY recorder for supervised sessions; transparent TUI I/O and append-only log."""
from __future__ import annotations

import errno
import fcntl
import io
import json
import os
import pty
import select
import signal
import struct
import subprocess
import sys
import termios
import tty
from pathlib import Path


def get_current_winsize() -> bytes | None:
    for fd in (sys.stdout.fileno(), sys.stdin.fileno(), sys.stderr.fileno()):
        try:
            return fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\x00" * 8)
        except (AttributeError, io.UnsupportedOperation, OSError):
            pass
    try:
        with open("/dev/tty", "rb") as tty_file:
            return fcntl.ioctl(tty_file.fileno(), termios.TIOCGWINSZ, b"\x00" * 8)
    except OSError:
        pass
    return None


def main() -> None:
    if "--contract" in sys.argv:
        if sys.argv[1:] == ["--contract"]:
            sys.stdout.write(json.dumps({"version": 1, "positional": 3, "features": ["pty-recorder"]}) + "\n")
            sys.stdout.flush()
            sys.exit(0)
        sys.exit(2)

    if len(sys.argv) < 6 or sys.argv[4] != "--":
        sys.stderr.write(
            "usage: session-pty-recorder <log-path> <max-bytes> <depth> -- <command...>\n"
        )
        sys.exit(2)

    log_path = sys.argv[1]
    try:
        max_bytes = int(sys.argv[2])
        depth = int(sys.argv[3])
        if max_bytes <= 0 or depth < 0:
            raise ValueError
    except ValueError:
        sys.stderr.write("session-pty-recorder: max-bytes and depth must be positive integers\n")
        sys.exit(2)

    cmd_argv = sys.argv[5:]
    if not cmd_argv:
        sys.stderr.write("session-pty-recorder: missing command argv\n")
        sys.exit(2)

    log_writer_bin = os.environ.get("NOGG_SESSION_LOG_WRITER") or str(
        Path(__file__).resolve().parent / "session-log-writer"
    )

    writer: subprocess.Popen[bytes] | None = None
    log_failed = False

    def mark_log_failed(reason: str) -> None:
        nonlocal log_failed, writer
        if not log_failed:
            log_failed = True
            try:
                log_dir = os.path.dirname(os.path.abspath(log_path))
                if log_dir and not os.path.exists(log_dir):
                    os.makedirs(log_dir, exist_ok=True)
                with open(log_path, "a", encoding="utf-8", errors="replace") as f:
                    f.write(f"# log capture failed: {reason}\n")
            except OSError:
                pass
        if writer is not None:
            if writer.stdin is not None:
                try:
                    writer.stdin.close()
                except OSError:
                    pass
            writer = None

    try:
        writer = subprocess.Popen(
            [log_writer_bin, log_path, str(max_bytes), str(depth)],
            stdin=subprocess.PIPE,
            bufsize=0,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        mark_log_failed(str(exc))

    try:
        stdin_fd: int | None = sys.stdin.fileno()
        is_stdin_tty = os.isatty(stdin_fd)
    except (AttributeError, io.UnsupportedOperation, OSError):
        stdin_fd = None
        is_stdin_tty = False

    try:
        stdout_fd: int | None = sys.stdout.fileno()
    except (AttributeError, io.UnsupportedOperation, OSError):
        stdout_fd = None

    old_termios = None
    if is_stdin_tty and stdin_fd is not None:
        try:
            old_termios = termios.tcgetattr(stdin_fd)
            tty.setraw(stdin_fd)
        except OSError:
            old_termios = None

    def restore_terminal() -> None:
        nonlocal old_termios
        if old_termios is not None and stdin_fd is not None:
            try:
                termios.tcsetattr(stdin_fd, termios.TCSAFLUSH, old_termios)
            except OSError:
                pass
            old_termios = None

    initial_winsize = get_current_winsize()

    try:
        pid, master_fd = pty.fork()
    except Exception as exc:
        restore_terminal()
        if writer is not None:
            if writer.stdin is not None:
                try:
                    writer.stdin.close()
                except OSError:
                    pass
            try:
                writer.wait(timeout=2)
            except (subprocess.TimeoutExpired, OSError):
                pass
        sys.stderr.write(f"session-pty-recorder: pty.fork failed: {exc}\n")
        sys.exit(1)

    if pid == 0:
        if writer is not None and writer.stdin is not None:
            try:
                writer.stdin.close()
            except OSError:
                pass
        try:
            os.execvp(cmd_argv[0], cmd_argv)
        except Exception as exc:
            sys.stderr.write(f"session-pty-recorder: execvp {cmd_argv[0]} failed: {exc}\n")
            os._exit(127)

    if initial_winsize is not None:
        try:
            fcntl.ioctl(master_fd, termios.TIOCSWINSZ, initial_winsize)
        except OSError:
            pass

    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_r, False)
    os.set_blocking(wake_w, False)

    pending_signals: list[int] = []
    winch_received = False

    def sig_winch(signum: int, frame: object) -> None:
        nonlocal winch_received
        winch_received = True

    def sig_forward(signum: int, frame: object) -> None:
        pending_signals.append(signum)

    signal.signal(signal.SIGWINCH, sig_winch)
    signal.signal(signal.SIGHUP, sig_forward)
    signal.signal(signal.SIGTERM, sig_forward)
    signal.signal(signal.SIGINT, sig_forward)
    signal.signal(signal.SIGQUIT, sig_forward)

    try:
        old_wakeup = signal.set_wakeup_fd(wake_w, warn_on_full_buffer=False)
    except (ValueError, OSError):
        old_wakeup = -1

    read_fds = [master_fd, wake_r]
    if stdin_fd is not None:
        read_fds.append(stdin_fd)

    def forward_sig(sig: int) -> None:
        try:
            os.kill(-pid, sig)
        except OSError:
            try:
                os.kill(pid, sig)
            except OSError:
                pass

    child_status: int | None = None

    while True:
        if child_status is None:
            try:
                wpid, status = os.waitpid(pid, os.WNOHANG)
                if wpid == pid:
                    child_status = status
                    break
            except ChildProcessError:
                break

        if writer is not None and writer.poll() is not None:
            mark_log_failed(f"log writer exited prematurely with status {writer.returncode}")

        try:
            rlist, _, _ = select.select(read_fds, [], [], 0.05)
        except (select.error, OSError) as exc:
            if getattr(exc, "errno", None) == errno.EINTR:
                continue
            break

        if wake_r in rlist:
            try:
                os.read(wake_r, 512)
            except OSError:
                pass

            if winch_received:
                winch_received = False
                ws = get_current_winsize()
                if ws is not None:
                    try:
                        fcntl.ioctl(master_fd, termios.TIOCSWINSZ, ws)
                    except OSError:
                        pass

            while pending_signals:
                sig = pending_signals.pop(0)
                forward_sig(sig)

        if master_fd in rlist:
            try:
                data = os.read(master_fd, 4096)
                if not data:
                    break
            except OSError as exc:
                if exc.errno == errno.EIO:
                    break
                break

            if stdout_fd is not None:
                try:
                    os.write(stdout_fd, data)
                except OSError:
                    pass

            if writer is not None and writer.stdin is not None:
                try:
                    writer.stdin.write(data)
                except (BrokenPipeError, OSError) as exc:
                    mark_log_failed(str(exc))

        if stdin_fd is not None and stdin_fd in rlist:
            try:
                data = os.read(stdin_fd, 1024)
                if not data:
                    read_fds.remove(stdin_fd)
                    try:
                        os.write(master_fd, b"\x04")
                    except OSError:
                        pass
                else:
                    try:
                        os.write(master_fd, data)
                    except OSError:
                        pass
            except OSError:
                if stdin_fd in read_fds:
                    read_fds.remove(stdin_fd)

    # Drain leftover child output from master_fd
    try:
        os.set_blocking(master_fd, False)
        while True:
            try:
                data = os.read(master_fd, 4096)
                if not data:
                    break
                if stdout_fd is not None:
                    try:
                        os.write(stdout_fd, data)
                    except OSError:
                        pass
                if writer is not None and writer.stdin is not None:
                    try:
                        writer.stdin.write(data)
                    except (BrokenPipeError, OSError) as exc:
                        mark_log_failed(str(exc))
            except OSError:
                break
    except OSError:
        pass

    try:
        os.close(master_fd)
    except OSError:
        pass

    if child_status is None:
        try:
            _, child_status = os.waitpid(pid, 0)
        except OSError:
            child_status = 0

    if writer is not None:
        if writer.stdin is not None:
            try:
                writer.stdin.close()
            except OSError:
                pass
        try:
            writer.wait(timeout=5)
        except (subprocess.TimeoutExpired, OSError):
            try:
                writer.kill()
            except OSError:
                pass

    restore_terminal()

    if old_wakeup != -1:
        try:
            signal.set_wakeup_fd(old_wakeup)
        except OSError:
            pass
    try:
        os.close(wake_r)
        os.close(wake_w)
    except OSError:
        pass

    if os.WIFEXITED(child_status):
        exit_code = os.WEXITSTATUS(child_status)
    elif os.WIFSIGNALED(child_status):
        exit_code = 128 + os.WTERMSIG(child_status)
    else:
        exit_code = 1

    os._exit(exit_code)


if __name__ == "__main__":
    main()
