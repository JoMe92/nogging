#!/usr/bin/env python3
"""A stub `docker` for the medium tests: records argv, emulates one container per name in a directory.

STUB_DOCKER_LOG   JSON Lines file, one {"argv": [...]} per call (exec calls also record the env file's mode)
STUB_DOCKER_ROOT  directory holding one fake root file system per container name
STUB_DOCKER_FAIL  "run" makes `docker run` fail as when the container does not start

A container path /x maps to <root>/<name>/x. `exec` runs the command on the host
with that working directory, HOME=<root>/<name>/root (or /home/<user> with --user)
and <root>/<name>/usr/local/bin first on PATH, plus the variables of --env-file.
Creating the agent user and handing files to it (`id bench ...`, `chown -R bench`)
cannot happen on the host; those two commands are recorded and succeed. An
absolute /home/bench/ path in an exec script is mapped into the container root.
"""
FAKED = ("id bench ", "chown -R bench")
import json
import os
import shutil
import stat
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ["STUB_DOCKER_ROOT"])
argv = sys.argv[1:]
entry = {"argv": argv}


def log():
    with open(os.environ["STUB_DOCKER_LOG"], "a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry) + "\n")


def host(spec):
    name, _, path = spec.partition(":")
    return ROOT / name / path.lstrip("/")


def copy(src: str, dst: str) -> int:
    contents = src.endswith("/.")
    src = src[:-2] if contents else src
    s = host(src) if ":" in src else Path(src)
    d = host(dst) if ":" in dst else Path(dst)
    if not s.exists():
        print(f"Error: No such container:path: {src}", file=sys.stderr)
        return 1
    if s.is_dir():
        if contents or not d.exists():
            shutil.copytree(s, d, dirs_exist_ok=True, symlinks=True)
        else:
            shutil.copytree(s, d / s.name, symlinks=True)
    else:
        d.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(s, d / s.name if d.is_dir() else d)
    return 0


def main() -> int:
    cmd = argv[0]
    if cmd == "image":
        print("sha256:" + "ab" * 32)
        return 0
    if cmd == "pull":
        return 0
    if cmd == "run":
        if os.environ.get("STUB_DOCKER_FAIL") == "run":
            print("docker: Error response from daemon: failed to create task: no such image", file=sys.stderr)
            return 125
        name = argv[argv.index("--name") + 1]
        for d in ("work", "root", "usr/local/bin"):
            (ROOT / name / d).mkdir(parents=True, exist_ok=True)
        print("0123456789ab")
        return 0
    if cmd == "cp":
        return copy(argv[1], argv[2])
    if cmd == "exec":
        rest, workdir, env_file, user = argv[1:], "/", None, None
        while rest[0].startswith("-"):
            flag, value, rest = rest[0], rest[1], rest[2:]
            if flag == "--workdir":
                workdir = value
            elif flag == "--env-file":
                env_file = value
            elif flag == "--user":
                user = value
        name, command = rest[0], rest[1:]
        if command[-1].startswith(FAKED):
            log()
            return 0
        # Absolute paths under the agent user's home point into this container's root.
        command[-1] = command[-1].replace("/home/bench/", f"{ROOT / name}/home/bench/")
        env = dict(os.environ)
        env["HOME"] = str(ROOT / name / ("home/" + user if user else "root"))
        Path(env["HOME"]).mkdir(parents=True, exist_ok=True)
        env["PATH"] = f"{ROOT / name / 'usr/local/bin'}:{env['PATH']}"
        if env_file:
            entry["env_file_mode"] = oct(stat.S_IMODE(os.stat(env_file).st_mode))
            for line in Path(env_file).read_text().splitlines():
                key, _, value = line.partition("=")
                env[key] = value
        log()
        return subprocess.run(command, cwd=host(f"{name}:{workdir}"), env=env).returncode
    if cmd in ("rm", "kill", "restart"):
        return 0
    print(f"stub docker: unsupported command {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    if argv and argv[0] != "exec":
        log()
    sys.exit(main())
